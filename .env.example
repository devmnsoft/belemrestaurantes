# Exemplo; não versione segredos reais
ConnectionStrings__MySql=Server=MYSQL_PRIVATE_HOST;Port=3306;Database=belrestaurante;User ID=APP_USER;Password=SET_VIA_SECRET_MANAGER;SslMode=VerifyFull
Discovery__Enabled=true
Discovery__IntervalMinutes=1
Discovery__BatchSize=2
# Development: fonte aberta com cache de 24h; GooglePlaces permanece disponível.
Discovery__Provider=OpenStreetMap
# Produção com OpenStreetMap: configurar instância própria de Overpass HTTPS.
OpenData__Endpoint=
GOOGLE_PLACES_API_KEY=
Auth__Authority=
Auth__Audience=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Development: habilitação explícita do host separado
DOTNET_ENVIRONMENT=Development
Crawler__Enabled=true
Crawler__IntervalMinutes=1
Crawler__MaxTasksPerCycle=3
# Configuração hierárquica também aceita pelos conectores
GooglePlaces__ApiKey=
Ai__Gemini__ApiKey=
Ai__Groq__ApiKey=
Ai__DeepSeek__ApiKey=

# Cuia Rotas: habilitação e cota explícitas; credencial somente fora do Git.
GoogleRoutes__Enabled=false
GoogleRoutes__ApiKey=
GoogleRoutes__DailyRequestLimit=0
Moderation__BatchLimit=500
# Worker__LogDirectory=C:\MNSOFT\logs\cuia
