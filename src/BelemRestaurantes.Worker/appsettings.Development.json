{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Discovery": {
    "Enabled": true,
    "IntervalMinutes": 1,
    "BatchSize": 2,
    "TargetRefreshMinutes": 10080
  },
  "Crawler": {
    "Enabled": true,
    "IntervalMinutes": 1,
    "MaxTasksPerCycle": 5
  },
  "Database": {
    "ApplyMigrations": false
  }
}
