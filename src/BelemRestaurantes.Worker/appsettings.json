{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "MySql": "Server=localhost; Port=3308; Database=belrestaurante; Uid=belrest; Pwd=123456;SslMode=None;"
  },
  "Database": {
    "ApplyMigrations": true
  },
  "Discovery": {
    "Enabled": true,
    "QueueCheckMinutes": 1,
    "IntervalMinutes": 10,
    "BatchSize": 5
  },
  "Crawler": {
    "Enabled": true,
    "QueueCheckMinutes": 1,
    "IntervalMinutes": 1,
    "MaxTasksPerCycle": 10
  },
  "GooglePlaces": {
    "ApiKey": "",
    "BaseUrl": "https://places.googleapis.com/v1/",
    "PageSize": 20,
    "Timeout": "00:00:15",
    "RequestsPerMinute": 60,
    "RequestRichContent": false
  },
  "Ai": {
    "ProviderChain": [
      "Gemini",
      "Groq",
      "DeepSeek"
    ],
    "Gemini": {
      "ApiKey": "",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
      "Model": "gemini-3.1-flash-lite",
      "TimeoutSeconds": 30
    },
    "Groq": {
      "ApiKey": "",
      "BaseUrl": "https://api.groq.com/openai/v1/",
      "Model": "openai/gpt-oss-20b",
      "TimeoutSeconds": 30
    },
    "DeepSeek": {
      "ApiKey": "",
      "BaseUrl": "https://api.deepseek.com/v1/",
      "Model": "deepseek-chat",
      "TimeoutSeconds": 30
    }
  },
  "Smtp": {
    "Enabled": false,
    "BatchSize": 5,
    "IntervalSeconds": 30
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org"
  },
  "Overpass": {
    "Endpoints": [
      "https://overpass-api.de/api/interpreter",
      "https://overpass.kumi.systems/api/interpreter",
      "https://overpass.osm.ch/api/interpreter"
    ],
    "StaleMirrorWindowMinutes": 60
  },
  "Worker": {
    "Geocoding": {
      "Enabled": true,
      "IntervalMinutes": 10,
      "BatchSize": 10,
      "DailyLimit": 300,
      "OverpassEnabled": true,
      "OverpassRadiusMeters": 80,
      "StreetSecondLookEnabled": true,
      "StreetNegativeCacheEnabled": true,
      "StreetNegativeCacheDays": 7,
      "QueryCacheEnabled": true
    }
  }
}
