<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>belemrestaurantes-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BelemRestaurantes.Application\BelemRestaurantes.Application.csproj" />
    <ProjectReference Include="..\BelemRestaurantes.Infrastructure\BelemRestaurantes.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <!--
    Worker: Cuia Discovery como Windows Service independente do site.
    Publica self-contained para rodar como servico no Windows Server.
  -->

</Project>