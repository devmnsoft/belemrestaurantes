@{Layout="_AdminLayout";ViewData["Title"]="Operação do Worker";var beats=(IEnumerable<dynamic>)ViewData["Heartbeats"]!;var tasks=(IEnumerable<dynamic>)ViewData["Queue"]!;var targets=(IEnumerable<dynamic>)ViewData["Targets"]!;}
<section class="para-operations"><span class="para-eyebrow">CUIA · OPERAÇÃO TOTAL</span><h1>O pulso do nosso guia.</h1><p>O heartbeat vence após 90 segundos. Um Worker ativo não comprova sucesso de cada conector; consulte os ciclos e erros.</p>
<div class="para-stat-row">
  <article>
    <strong>@(((int)ViewData["PendingCount"]!).ToString("N0"))</strong>
    <span>Candidatos aguardando aprovação</span>
    <p><a href="/admin/moderacao" style="text-decoration:underline;">Abrir moderação em lote ↗</a></p>
  </article>
  <article>
    <strong>@(((int)ViewData["PublishedCount"]!).ToString("N0"))</strong>
    <span>Restaurantes publicados</span>
    <p><a href="/busca" target="_blank" rel="noopener" style="text-decoration:underline;">Ver catálogo público ↗</a></p>
  </article>
  <article>
    <strong>@ViewData["TargetCount"]</strong>
    <span>Alvos no plano estadual</span>
    <p>@ViewData["EnabledCount"] municípios ativos</p>
  </article>
</div>

<h2>Diagnóstico do Worker e Conectores</h2>
<div class="para-stat-row">@foreach(var beat in beats){
  var isActive = (string)beat.state == "running" && (DateTime)beat.heartbeat_at > DateTime.UtcNow.AddSeconds(-90);
  <article style="border-left: 4px solid @(isActive ? "#10b981" : "#ef4444");">
    <strong style="color: @(isActive ? "#10b981" : "#ef4444");">@(isActive ? "Worker Ativo" : "Worker Parado / Inativo")</strong>
    <span>Instância: @beat.instance_id</span>
    <p>Último sinal: @(((DateTime)beat.heartbeat_at).ToString("dd/MM HH:mm:ss")) UTC · @((long)beat.working_set_bytes/1024/1024) MB</p>
    <span>Discovery: @beat.discovery_enabled · Crawler: @beat.crawler_enabled</span>
  </article>
}@if(!beats.Any()){
  <article style="border-left: 4px solid #ef4444;">
    <strong style="color: #ef4444;">Worker parado ou sem heartbeat</strong>
    <p>Inicie o serviço de Worker com a migração 029 ou superior.</p>
  </article>
}</div>
<form method="post" action="/admin/operacao/sincronizar">@Html.AntiForgeryToken()<button class="para-button">Executar sincronização agora</button><p>Enfileira apenas alvos ativos vencidos. Não altera retries nem executa consultas externas nesta requisição.</p></form><p><a href="/admin/discovery">Ciclos, erros e resultados</a> · <a href="/admin/diagnostics">Qualidade e custos de APIs</a></p>
<div class="recipe-tools"><form method="post" action="/admin/operacao/plano-estadual">@Html.AntiForgeryToken()<button class="para-button" data-confirm="Ativar o plano OpenStreetMap dos 144 municípios, com primeira passagem escalonada e atualização semanal?">Ativar plano dos 144 municípios</button></form><form method="post" action="/admin/operacao/enriquecer">@Html.AntiForgeryToken()<button class="para-button">Enfileirar até 100 enriquecimentos</button></form></div><p>Os distritos de Mosqueiro, Outeiro e Icoaraci são pesquisados dentro do município Belém. O enriquecimento preserva os dados dos parceiros.</p>
<h2>Alvos de descoberta (@ViewData["TargetCount"] cadastrados · @ViewData["EnabledCount"] ativos)</h2><p>Ative progressivamente os municípios conforme capacidade e orçamento. O limite restringe os cadastros tratados; a fonte pode cobrar pela consulta inteira.</p>
<details class="visit-panel"><summary>Cadastrar alvo em outro município do Pará</summary><form method="post" action="/admin/operacao/novo-alvo">@Html.AntiForgeryToken()<label for="new-city">Município oficial</label><select name="city" id="new-city">@foreach(var item in (IEnumerable<string>)ViewData["Municipalities"]!){<option>@item</option>}</select><label for="new-category">Categoria da pesquisa</label><input id="new-category" name="category" required maxlength="100" value="Restaurante"/><label for="new-provider">Fonte</label><select id="new-provider" name="provider"><option value="openstreetmap">OpenStreetMap</option><option value="googleplaces">Google Places (exige chave válida)</option><option value="default">Padrão do Worker</option></select><div class="visit-fields"><div><label for="new-priority">Prioridade</label><input id="new-priority" type="number" name="priority" value="1" min="1" max="10" required/></div><div><label for="new-refresh">Frequência em minutos</label><input id="new-refresh" type="number" name="refreshMinutes" value="10080" min="60" max="525600" required/></div><div><label for="new-limit">Limite de registros por consulta</label><input id="new-limit" type="number" name="resultLimit" value="100" min="1" max="2000" required/></div></div><label class="visit-check"><input type="checkbox" name="enabled" value="true"/> Habilitar descoberta para este alvo</label><button class="para-button mt-3">Cadastrar alvo</button></form></details>
<form method="get" class="para-review-filters"><div><label for="target-city">Filtrar município</label><input id="target-city" name="city" value="@ViewData["City"]" maxlength="100"/></div><button class="para-button">Filtrar alvos</button></form><p>@ViewData["FilteredCount"] alvos no filtro · Página @ViewData["Page"].</p>
<div class="para-review-grid">@foreach(var t in targets){<article class="para-review-card"><h3>@t.city · @t.category</h3><p>Próxima execução: @(((DateTime)t.next_run_at).ToString("dd/MM HH:mm")) UTC</p><p>@t.last_error</p><form method="post" action="/admin/operacao/alvo">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.id"/><label><input type="checkbox" name="enabled" value="true" checked="@((bool)t.enabled)"/> Habilitado</label><label for="provider-@t.id">Fonte</label><select name="provider" id="provider-@t.id">@foreach(var p in new[]{"default","openstreetmap","googleplaces"}){<option value="@p" selected="@((string)t.provider==p)">@p</option>}</select><label for="priority-@t.id">Prioridade (1 a 10)</label><input id="priority-@t.id" name="priority" type="number" min="1" max="10" value="@t.priority"/><label for="refresh-@t.id">Atualizar a cada (minutos)</label><input id="refresh-@t.id" name="refreshMinutes" type="number" min="60" max="525600" value="@t.refresh_minutes"/><label for="limit-@t.id">Limite de registros</label><input id="limit-@t.id" name="resultLimit" type="number" min="1" max="2000" value="@t.result_limit"/><button class="para-button mt-3">Salvar alvo</button></form></article>}</div>
@{var current=(int)ViewData["Page"]!;var total=(int)ViewData["FilteredCount"]!;var city=ViewData["City"] as string;string PageUrl(int page)=>"/admin/operacao"+Microsoft.AspNetCore.Http.QueryString.Create(new Dictionary<string,string?>{["city"]=city,["page"]=page.ToString()});}<nav class="para-pagination" aria-label="Alvos">@if(current>1){<a href="@PageUrl(current-1)">Anterior</a>}@if(current*30<total){<a href="@PageUrl(current+1)">Próxima</a>}</nav></section>

<section class="para-operations"><h2>Validade de horários e referências de mobilidade</h2><p>As rotinas verificam os dados cadastrados, registram pendências e preservam informações do parceiro. Não importam feeds externos nem confirmam linhas, preços ou funcionamento.</p><div class="recipe-tools"><form method="post" action="/admin/operacao/manutencao">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="hours" /><button class="para-button">Conferir validade dos horários</button></form><form method="post" action="/admin/operacao/manutencao">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="mobility" /><button class="para-button">Conferir fontes de mobilidade</button></form></div><div class="para-review-grid">@foreach(var job in (IEnumerable<dynamic>)ViewData["Maintenance"]!){<article class="para-review-card"><h3>Verificação #@job.id · @((string)job.kind=="hours"?"Horários":"Mobilidade")</h3><p>Situação: @job.state · tentativas: @job.attempts</p><p>@job.last_error</p>@if(job.result_json is string result){using var report=System.Text.Json.JsonDocument.Parse(result);var data=report.RootElement;<p>@data.GetProperty("checkedRecords").GetInt32() registros conferidos · @data.GetProperty("needsReview").GetInt32() precisam de revisão.</p>}<p>Solicitada em @(((DateTime)job.created_at).ToString("dd/MM HH:mm")) UTC</p></article>}</div></section>
