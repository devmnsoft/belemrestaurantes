@model BelemRestaurantes.Web.Models.OperatingHoursInput
@{Layout="_AdminLayout";ViewData["Title"]="Mobilidade e funcionamento";var names=new[]{"Domingo","Segunda","Terça","Quarta","Quinta","Sexta","Sábado"};var sources=(IEnumerable<dynamic>)ViewData["Sources"]!;var usage=(IEnumerable<dynamic>)ViewData["Usage"]!;var fares=(IEnumerable<dynamic>)ViewData["Fares"]!;}
<section class="para-operations"><span class="para-eyebrow">CUIA · PROCEDÊNCIA ANTES DE PROMESSA</span><h1>Mobilidade e funcionamento.</h1><p>Confirme as informações na fonte. Dados vencidos deixam de gerar afirmações de funcionamento ou tarifas vigentes.</p><form method="get" class="para-review-filters"><div><label for="lookup-id">Número do restaurante</label><input id="lookup-id" name="restaurantId" type="number" min="1" value="@Model.RestaurantId"/></div><button class="para-button">Carregar horários</button></form>
@if(Model.RestaurantId>0){<form method="post" action="/admin/mobilidade/horarios" class="visit-panel"><h2>Funcionamento do cadastro #@Model.RestaurantId</h2><div asp-validation-summary="All" role="alert"></div>@Html.AntiForgeryToken()<input type="hidden" asp-for="RestaurantId"/><input type="hidden" asp-for="Version"/><div class="visit-fields"><div><label asp-for="SourceUrl">Fonte HTTPS</label><input asp-for="SourceUrl" type="url" required maxlength="350"/></div><div><label asp-for="ConfirmedAt">Confirmado em (UTC)</label><input asp-for="ConfirmedAt" type="date" required/></div><div><label asp-for="ExpiresAt">Validade (UTC)</label><input asp-for="ExpiresAt" type="date" required/></div><div><label asp-for="TemporaryClosedUntil">Fechamento temporário até</label><input asp-for="TemporaryClosedUntil" type="date"/></div></div><p>Turnos: 11:00-15:00;18:00-23:00. Fechamento 02:00 após abertura 20:00 corresponde ao dia seguinte.</p>
@for(var index=0;index<Model.Days.Count;index++){var d=Model.Days[index];<div class="visit-fields"><div><input type="hidden" name="Days[@index].Day" value="@d.Day"/><label for="day-state-@index">@names[Math.Clamp(d.Day,0,6)]</label><select id="day-state-@index" name="Days[@index].State">@foreach(var state in new[]{("unknown","Não confirmado"),("open","Turnos"),("closed","Fechado"),("24h","24 horas")}){<option value="@state.Item1" selected="@(d.State==state.Item1)">@state.Item2</option>}</select></div><div><label for="day-windows-@index">Turnos de @names[Math.Clamp(d.Day,0,6)]</label><input id="day-windows-@index" name="Days[@index].Windows" value="@d.Windows" maxlength="100"/></div></div>}
<label asp-for="Exceptions">Exceções de feriados e eventos: uma por linha, AAAA-MM-DD=closed, 24h ou turnos</label><textarea asp-for="Exceptions" rows="5" maxlength="12000"></textarea><label class="visit-check"><input type="checkbox" name="ReservationOnly" value="true" checked="@Model.ReservationOnly"/> Somente com reserva</label><label asp-for="AccessibilityNote">Acessibilidade confirmada e fonte</label><textarea asp-for="AccessibilityNote" maxlength="500"></textarea><button class="para-button mt-3">Gravar e auditar horários</button></form>}
<h2>Fontes de transporte</h2><div class="para-review-grid">@foreach(var s in sources){<article class="para-review-card"><h3>#@s.id · @s.name</h3><p>@s.kind · @((bool)s.enabled?"Habilitada":"Desabilitada")</p><p>@s.terms</p><a href="@s.source_url" target="_blank" rel="noopener noreferrer">Conferir origem ↗</a><p>Validade: @s.expires_at · Última sincronização: @(s.last_sync_at??"Não executada")</p><p>@s.last_error</p></article>}</div>
<details class="visit-panel"><summary>Cadastrar ou atualizar fonte (operação)</summary><form method="post" action="/admin/mobilidade/fonte">@Html.AntiForgeryToken()<label for="source-name">Nome do órgão ou provedor</label><input id="source-name" name="name" maxlength="160" required/><label for="source-kind">Tipo</label><select id="source-kind" name="kind"><option value="official_reference">Referência oficial</option><option value="river">Fluvial</option><option value="intercity">Intermunicipal</option><option value="gtfs">GTFS autorizado (cadastro de referência)</option></select><label for="source-url">Endereço HTTPS</label><input id="source-url" name="sourceUrl" type="url" maxlength="350" required/><label for="source-terms">Licença ou condições de uso</label><textarea id="source-terms" name="terms" required maxlength="500"></textarea><label for="source-expiry">Confirmado até (UTC)</label><input id="source-expiry" type="date" name="expiresAt" required/><label class="visit-check"><input type="checkbox" name="enabled" value="true"/> Habilitar referência confirmada</label><button class="para-button">Registrar fonte</button></form></details>
<h2>Tarifas e vigências</h2><div class="para-review-grid">@foreach(var f in fares){<article class="para-review-card"><h3>@f.service_name</h3><p>@f.mode · R$ @f.amount · @f.confidence</p><p>@f.conditions</p><p>@(((DateTime)f.valid_from).ToString("dd/MM/yyyy")) a @(((DateTime)f.valid_until).ToString("dd/MM/yyyy")) · @f.source_name</p></article>}</div><details class="visit-panel"><summary>Cadastrar tarifa com procedência (operação)</summary><form method="post" action="/admin/mobilidade/tarifa">@Html.AntiForgeryToken()<label for="fare-source">Fonte confirmada</label><select id="fare-source" name="sourceId" required>@foreach(var s in sources){<option value="@s.id">@s.name</option>}</select><label for="fare-service">Serviço ou linha exata</label><input id="fare-service" name="serviceName" maxlength="160" required/><label for="fare-mode">Modal</label><select id="fare-mode" name="mode"><option value="bus">Ônibus municipal</option><option value="brt">BRT específico</option><option value="boat">Fluvial</option><option value="intercity">Intermunicipal</option></select><label for="fare-amount">Valor em reais</label><input id="fare-amount" name="amount" inputmode="decimal" required/><label for="fare-from">Vigente de</label><input id="fare-from" type="date" name="validFrom" required/><label for="fare-until">Vigente até</label><input id="fare-until" type="date" name="validUntil" required/><label for="fare-conditions">Condições e benefícios</label><textarea id="fare-conditions" name="conditions" maxlength="500" required></textarea><label for="fare-confidence">Natureza da informação</label><select id="fare-confidence" name="confidence"><option value="official">Oficial confirmada</option><option value="partner">Informada pelo parceiro</option><option value="estimated">Estimativa</option></select><button class="para-button">Registrar tarifa</button></form></details>
<h2>Consultas de trajetos (sem origem dos visitantes)</h2><ul>@foreach(var u in usage){<li>@u.usage_day · @u.provider: @u.requests consultas, @u.failures falhas · @u.last_error</li>}@if(!usage.Any()){<li>Nenhuma consulta interna registrada. Acesso externo ao Maps disponível.</li>}</ul><a href="/cuia-rotas">Abrir planejador público</a></section>
