@model BelemRestaurantes.Web.Controllers.EditorialArticle
@{ViewData["Title"]="Mesa editorial";var articles=(IEnumerable<BelemRestaurantes.Web.Controllers.EditorialArticle>)ViewData["Articles"]!;}
<section class="para-container para-section" lang="pt-BR"><span class="para-eyebrow">CUIA · CULTURA GASTRONÔMICA</span><h1 class="para-editorial-title">Histórias que merecem uma mesa.</h1><p>Edite textos com fontes e autorização. O perfil editorial administra este conteúdo; a operação e a moderação do catálogo exigem outros papéis.</p><div class="visit-layout"><form method="post" class="visit-panel">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><label asp-for="Title">Título</label><input asp-for="Title" required maxlength="160"/><label asp-for="Body">Texto (sem HTML)</label><textarea asp-for="Body" required maxlength="20000" rows="16"></textarea><label asp-for="SourceUrl">Fonte ou autorização HTTPS</label><input asp-for="SourceUrl" type="url" maxlength="350"/><label asp-for="Status">Visibilidade</label><select asp-for="Status"><option value="draft">Rascunho</option><option value="published">Publicado</option></select><button class="para-button mt-3">Salvar conteúdo</button></form><aside class="visit-panel"><h2>Textos da redação</h2><a href="/admin/editorial">Novo texto</a><ul>@foreach(var article in articles){<li><a href="/admin/editorial?id=@article.Id">@article.Title</a> · @article.Status</li>}</ul><a href="/sabores">Abrir revista pública</a><form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button class="visit-text-button">Sair</button></form></aside></div></section>
