@model BelemRestaurantes.Web.Models.RestaurantSuggestionInput
@using BelemRestaurantes.Domain.Data
@{ ViewData["Title"] = Model.RestaurantId is null ? "Indique um restaurante" : "Sugerir uma correção"; }
<section class="para-container para-suggestion-layout">
  <div class="para-suggestion-story"><span class="para-category-icon para-gold">@await Html.PartialAsync("_ParaIcon", "market")</span><span class="para-eyebrow">QUEM É DAQUI TEM MUITO A CONTAR</span><h1>Uma boa dica<br /><em>merece ser dividida.</em></h1><p>O restaurante do seu bairro, o tacacá de fim de tarde, aquela cozinha que acolhe. Ajude o guia a conhecer mais sabores do Pará.</p><ol><li><strong>Você indica.</strong><span>Conte o nome, a cidade e onde encontrar.</span></li><li><strong>A gente confere.</strong><span>As informações passam por revisão antes de aparecer no guia.</span></li><li><strong>Mais gente descobre.</strong><span>Uma dica sua pode virar um encontro à mesa.</span></li></ol></div>
  <div class="para-suggestion-form">
    @if (TempData["SuggestionReceived"] is true) { <div class="para-success" role="status"><strong>Obrigado pela dica!</strong><p>Sua indicação foi registrada para revisão. Ela aparecerá no guia depois de aprovada.</p></div> }
    <h2>@ViewData["Title"]</h2><p>Não é necessário criar uma conta para indicar.</p>
    @if (ViewData["ExternalSuggestion"] is true) { <p class="catalog-warning">Esta dica veio de uma pesquisa externa. Revise o nome, o município e a fonte antes de enviar. O envio não publica o lugar automaticamente.</p> }
    <form method="post" action="/sugerir">
      @Html.AntiForgeryToken()<input asp-for="RestaurantId" type="hidden" />
      <div asp-validation-summary="All" class="para-validation" role="alert"></div>
      <label asp-for="Name">Nome do restaurante</label><input asp-for="Name" required minlength="2" maxlength="160" placeholder="Como esse lugar se chama?" />
      <label asp-for="City">Cidade do Pará</label><select asp-for="City">@foreach(var city in ParaOfficialCatalog.Municipalities.OrderBy(c=>c.Name)) { <option value="@city.Name">@city.Name</option> }</select>
      <label asp-for="Website">Site ou rede social <span>(opcional)</span></label><input asp-for="Website" type="url" maxlength="350" placeholder="https://…" />
      <label asp-for="Notes">Sua dica <span>(opcional)</span></label><textarea asp-for="Notes" rows="4" maxlength="500" placeholder="Qual é a especialidade? Tem alguma informação para corrigir?"></textarea>
      <div class="honeypot" aria-hidden="true"><label asp-for="ContactTrap">Contato alternativo</label><input asp-for="ContactTrap" tabindex="-1" autocomplete="off" /></div>
      <p class="para-form-note">Evite dados pessoais ou informações de pagamento. Conte apenas sobre o estabelecimento.</p>
      <button type="submit" class="para-button">Enviar para revisão ↗</button><a href="/busca" class="para-text-link">Voltar ao guia</a>
    </form>
  </div>
</section>
