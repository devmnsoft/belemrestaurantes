@model BelemRestaurantes.Application.Models.PagedResult<BelemRestaurantes.Application.Models.ParaRecipe>
@using BelemRestaurantes.Application.Models
@{ViewData["Title"]="Receitas do Pará — sabores em casa";ViewData["MetaDescription"]="Receitas inspiradas nos sabores do Pará: ingredientes, passos, dicas e histórias para cozinhar em casa.";var f=ViewData["Filter"] as RecipeFilter??new();string PageUrl(int page)=>"/receitas"+Microsoft.AspNetCore.Http.QueryString.Create(new Dictionary<string,string?>{["Query"]=f.Query,["Category"]=f.Category,["Course"]=f.Course,["City"]=f.City,["RestaurantId"]=f.RestaurantId?.ToString(),["Quick"]=f.Quick.ToString(),["Page"]=page.ToString()});}
<section class="recipe-masthead" lang="pt-BR"><div class="para-container recipe-masthead-grid"><div><span class="para-eyebrow">CADERNO DE SABORES · PARÁ</span><h1>Um pouco daqui.<br /><em>Na sua cozinha.</em></h1><p>Da cuia à panela, dos encontros de domingo ao café da tarde. Receitas inspiradas nos sabores do Pará, para fazer do seu jeito.</p><a href="#caderno" class="para-button">Abrir o caderno ↓</a></div><div class="recipe-cover" role="img" aria-label="Ilustração editorial de uma cuia e folhas"><span>DA FEIRA<br />À SUA<br /><em>MESA.</em></span><div aria-hidden="true">@await Html.PartialAsync("_ParaIcon","leaf")@await Html.PartialAsync("_ParaIcon","cuia")@await Html.PartialAsync("_ParaIcon","fish")</div><small>ILUSTRAÇÃO EDITORIAL · SABORES PARA COMPARTILHAR</small></div></div></section>
<section lang="pt-BR" id="caderno" class="para-container para-section"><div class="para-section-heading"><div><span class="para-eyebrow">ESCOLHA O SEU PRÓXIMO PREPARO</span><h2>O Pará também se descobre em casa.</h2><p>Adaptações editoriais, com ingredientes, passos e procedência. Tempo e rendimento são estimativas.</p></div><a href="/busca" class="para-text-link">Prefere sair para comer? ↗</a></div>
<form action="/receitas" method="get" class="recipe-filters" role="search"><div><label for="recipe-query">Receita, ingrediente ou prato</label><input id="recipe-query" name="Query" value="@f.Query" maxlength="120" type="search" placeholder="Tucupi, peixe, cupuaçu…" /></div><div><label for="recipe-category">Categoria</label><select id="recipe-category" name="Category"><option value="">Todas as categorias</option>@foreach(var category in RecipeRules.Categories){<option value="@category" selected="@(category==f.Category)">@category</option>}</select></div><div><label for="recipe-course">Momento à mesa</label><select id="recipe-course" name="Course"><option value="">Todos os momentos</option>@foreach(var course in new[]{"Almoço","Jantar","Café e lanche","Sobremesa"}){<option value="@course" selected="@(course==f.Course)">@course</option>}</select></div><div><label for="recipe-city">Referência editorial</label><select id="recipe-city" name="City"><option value="">Todo o Pará</option>@foreach(var city in BelemRestaurantes.Domain.Data.ParaOfficialCatalog.Municipalities){<option value="@city.Name" selected="@(city.Name==f.City)">@city.Name</option>}</select></div><label class="recipe-quick"><input type="checkbox" name="Quick" value="true" checked="@f.Quick" /> Até 30 minutos</label>@if(f.RestaurantId is {} restaurantId){<input type="hidden" name="RestaurantId" value="@restaurantId" />}<button class="para-button">Encontrar receitas ↗</button><a href="/receitas" class="para-text-link">Limpar</a></form>
@{var references=ViewData["References"] as IReadOnlyList<BelemRestaurantes.Application.Abstractions.CulinaryReference>??[];}
@if(references.Count>0){<section class="search-evidence"><h2>Receitas encontradas nas fontes</h2><p>Coletadas pelo robô, com ingredientes e link para o preparo do autor. A referência não comprova vínculo com restaurante.</p><div class="culinary-grid">@foreach(var item in references){<article class="culinary-card"><h3><a href="/culinaria/referencia/@item.Id">@item.Title</a></h3><p>@item.Author · @item.Ingredients.Length ingredientes identificados</p><p>@item.Summary</p>@if(item.VideoUrl is {} video){<a href="@video" rel="noopener noreferrer" target="_blank">Assistir ao vídeo ↗</a>}</article>}</div></section>}
<p role="status" class="recipe-count">@Model.TotalCount receitas editoriais nesta seleção · página @Model.Page de @Math.Max(1,Model.TotalPages)</p>
<div class="recipe-grid">@foreach(var recipe in Model.Items){@await Html.PartialAsync("_RecipeCard",recipe)}</div>
@if(Model.Items.Count==0){<div class="para-empty"><h2>Essa receita ainda não entrou no caderno.</h2><p>Tente outro ingrediente ou explore todas as categorias.</p><a href="/receitas" class="para-button">Ver o caderno completo</a></div>}
@if(Model.TotalPages>1){<nav class="para-pagination" aria-label="Páginas de receitas">@if(Model.Page>1){<a href="@PageUrl(Model.Page-1)">← Anterior</a>}<span aria-current="page">@Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a href="@PageUrl(Model.Page+1)">Próxima →</a>}</nav>}
<div class="recipe-editorial-note"><strong>Feitas para inspirar.</strong><p>As adaptações não reproduzem receitas secretas ou oficiais de restaurantes. Fontes de contexto e cuidados aparecem em cada página. Confira os ingredientes e os rótulos conforme suas restrições alimentares.</p></div></section>
@section Styles {<link rel="stylesheet" href="~/css/search57.css" asp-append-version="true" />}
