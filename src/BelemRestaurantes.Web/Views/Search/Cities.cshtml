@model IReadOnlyList<BelemRestaurantes.Domain.Entities.GeoMunicipality>
@{
    ViewData["Title"]=T["AtlasCitiesTitle"].Value;
    ViewData["AtlasEditorial"]=true;
    ViewData["MetaDescription"]=T["AtlasCitiesIntro"].Value;
    var query=ViewData["AtlasQuery"] as string;
    var region=ViewData["AtlasRegion"] as string;
    var counts=ViewData["CityCounts"] as IReadOnlyDictionary<string,int> ?? new Dictionary<string,int>();
    var regions=BelemRestaurantes.Domain.Data.ParaOfficialCatalog.Municipalities.Select(m=>m.Mesoregion).Distinct().OrderBy(r=>r);
    var localities=ViewBag.TouristLocalities as IReadOnlyList<BelemRestaurantes.Domain.Entities.GeoDistrictLocality> ?? [];
}
<section class="atlas-page-hero atlas-city-hero"><div class="para-container"><span class="para-eyebrow">@T["AtlasDestinationsEyebrow"]</span><h1>@T["AtlasCitiesTitle"]</h1><p>@T["AtlasCitiesIntro"]</p><a href="/guia" class="para-text-link">@T["AtlasGuideLink"] ↗</a></div><span class="atlas-city-number" aria-hidden="true">144</span></section>
<section class="para-container para-section">
  <form action="/cidades" method="get" class="atlas-city-filter" role="search"><div><label for="atlas-city-query">@T["AtlasCitySearchLabel"]</label><input id="atlas-city-query" name="q" value="@query" maxlength="120" type="search" placeholder="Belém, Santarém, Soure…" /></div><div><label for="atlas-city-region">@T["AtlasRegionLabel"]</label><select id="atlas-city-region" name="region"><option value="">@T["AtlasAllRegions"]</option>@foreach(var item in regions){<option value="@item" selected="@(item==region)">@item</option>}</select></div><button type="submit" class="para-button">@T["Search"]</button><a href="/cidades" class="para-text-link">@T["AtlasClear"]</a></form>
  <p class="atlas-city-count" role="status">@T["AtlasCitiesCount",Model.Count] · @T["AtlasCountsNote"]</p>
  @if(Model.Count==0){<div class="para-empty"><h2>@T["AtlasCityEmpty"]</h2><a href="/cidades" class="para-text-link">@T["AtlasClear"] ↗</a></div>}
  @foreach(var group in Model.GroupBy(c=>c.Mesoregion).OrderBy(g=>g.Key))
  {
    <section class="atlas-region" aria-label="@group.Key"><div class="atlas-region-heading"><span class="para-eyebrow">PARÁ · BRASIL</span><h2>@group.Key</h2></div><div class="atlas-city-grid">
    @foreach(var city in group.OrderByDescending(c=>c.IsTouristPole).ThenBy(c=>c.Name))
    {
      var count=counts.GetValueOrDefault(city.NormalizedName);
      <a href="/cidade/@city.NormalizedName.Replace(" ","-")" class="atlas-city-card"><span class="atlas-city-code">IBGE @city.IbgeCode</span><h3>@city.Name</h3><p>@city.Microregion</p><span class="atlas-city-card-bottom"><span>@(count>0?T["AtlasPublishedCount",count].Value:T["AtlasCatalogGrowing"].Value)</span><b aria-hidden="true">↗</b></span></a>
    }
    </div></section>
  }
</section>
@if(localities.Count>0)
{
<section class="para-section atlas-catalog"><div class="para-container"><div class="para-section-heading"><div><span class="para-eyebrow">@T["AtlasIslandsEyebrow"]</span><h2>@T["AtlasIslandsTitle"]</h2><p>@T["AtlasIslandsText"]</p></div></div><div class="atlas-localities">@foreach(var locality in localities){<a href="/localidade/@locality.NormalizedName.Replace(" ","-")">@await Html.PartialAsync("_ParaIcon","river")<span>@locality.Name</span><b aria-hidden="true">↗</b></a>}</div></div></section>
}
