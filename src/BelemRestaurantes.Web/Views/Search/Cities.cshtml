@model IReadOnlyList<BelemRestaurantes.Domain.Entities.GeoMunicipality>
@{
    ViewData["Title"] = "Cidades e Sabores do Pará — Belém Restaurantes";
    ViewData["MetaDescription"] = "Explore a rica gastronomia de todos os municípios do Pará: Belém, Santarém, Soure, Castanhal, Salinópolis, Marabá e muito mais. O Pará tem sabor!";
}

<div class="container-v3 section-v3">
  <!-- Cabeçalho -->
  <div style="margin-bottom: 36px; text-align: center; max-width: 760px; margin-left: auto; margin-right: auto;">
    <span class="badge-tag-v3" style="background: rgba(30,122,84,0.12); color: var(--forest-800); border: 1px solid rgba(30,122,84,0.3); margin-bottom: 12px;">
      📍 COBERTURA TERRITORIAL DO PARÁ — DESIGN V4
    </span>
    <h1 style="font-family: var(--font-display); font-size: 34px; font-weight: 850; color: var(--forest-950); margin: 0 0 10px 0;">
      O Pará em Cada Sabor
    </h1>
    <p style="font-size: 16px; color: var(--text-muted); line-height: 1.6; margin: 0;">
      Do litoral atlântico de Salinas às margens do Tapajós em Santarém, aos retiros fluviais do Combu e à cerâmica marajoara de Icoaraci: descubra restaurantes, peixarias, tacacazeiras e a culinária autêntica de cada canto paraense.
    </p>
  </div>

  <!-- Distritos, Ilhas e Polos Gastronômicos (FASE 3) -->
  @{
    var touristLocalities = ViewBag.TouristLocalities as IReadOnlyList<BelemRestaurantes.Domain.Entities.GeoDistrictLocality> ?? Array.Empty<BelemRestaurantes.Domain.Entities.GeoDistrictLocality>();
  }
  @if (touristLocalities.Count > 0)
  {
    <div style="margin-bottom: 40px; background: rgba(30,122,84,0.04); border: 1px solid rgba(30,122,84,0.15); border-radius: 16px; padding: 24px;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 24px;">🏝️</span>
          <h2 style="font-family: var(--font-display); font-size: 20px; font-weight: 800; color: var(--forest-950); margin: 0;">
            Distritos, Ilhas e Polos Gastronômicos
          </h2>
        </div>
        <span class="badge-v4" style="background: #eef7f2; color: var(--forest-800); font-weight: 700;">
          Experiências Fluviais e Culturais
        </span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px;">
        @foreach (var loc in touristLocalities)
        {
          var slug = loc.NormalizedName.Replace(" ", "-");
          var typeLabel = loc.LocalityType switch {
            "island" => "🌴 Ilha Gastronômica",
            "district" => "🏛️ Distrito Cultural",
            "tourist_zone" => "⛵ Polo Turístico",
            _ => "📍 Localidade"
          };
          <a href="/localidade/@slug" style="text-decoration: none; color: inherit;">
            <div class="card-gastronomico-v4" style="padding: 14px 16px; background: #fff; border: 1px solid rgba(0,0,0,0.07); border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--forest-700); text-transform: uppercase; letter-spacing: 0.5px;">@typeLabel</span>
                <h3 style="font-family: var(--font-display); font-size: 16px; font-weight: 750; color: var(--forest-950); margin: 4px 0 0 0;">@loc.Name</h3>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; font-size: 12px; font-weight: 700; color: var(--tucupi-600);">
                <span>Ver restaurantes</span>
                <span>➔</span>
              </div>
            </div>
          </a>
        }
      </div>
    </div>
  }

  <!-- Mesorregiões do Pará -->
  @{
    var mesos = Model.GroupBy(x => x.Mesoregion).OrderBy(g => g.Key);
  }

  @foreach (var meso in mesos)
  {
    <div style="margin-bottom: 40px;">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; border-bottom: 2px solid rgba(0,0,0,0.06); padding-bottom: 10px;">
        <span style="font-size: 24px;">🌿</span>
        <h2 style="font-family: var(--font-display); font-size: 22px; font-weight: 800; color: var(--forest-900); margin: 0;">
          @meso.Key
        </h2>
      </div>

      <div class="grid-cards-v3" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;">
        @foreach (var city in meso.OrderByDescending(x => x.IsTouristPole).ThenBy(x => x.Name))
        {
          var citySlug = city.NormalizedName.Replace(" ", "-");
          <a href="/cidade/@citySlug" style="text-decoration: none; color: inherit;">
            <div class="card-restaurant-v3" style="padding: 20px; transition: transform 0.2s, box-shadow 0.2s; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                  <h3 style="font-family: var(--font-display); font-size: 18px; font-weight: 750; color: var(--forest-950); margin: 0;">
                    @city.Name
                  </h3>
                  @if (city.IsTouristPole)
                  {
                    <span class="badge-tag-v3" style="font-size: 10px; background: rgba(229,169,59,0.2); color: var(--tucupi-800); border: 1px solid rgba(229,169,59,0.5);">
                      ⭐ Polo
                    </span>
                  }
                </div>
                <div style="font-size: 12.5px; color: var(--text-muted); margin-bottom: 12px;">
                  Microrregião de @city.Microregion
                </div>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid rgba(0,0,0,0.06); font-size: 12px; font-weight: 700; color: var(--forest-700);">
                <span>Ver Gastronomia</span>
                <span>➔</span>
              </div>
            </div>
          </a>
        }
      </div>
    </div>
  }
</div>
