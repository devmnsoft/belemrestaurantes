@model BelemRestaurantes.Application.Models.PagedResult<BelemRestaurantes.Application.Models.RestaurantView>
@{
    ViewData["Title"] = "Busca Gastronômica — Belém Restaurantes";
    var filters = (BelemRestaurantes.Application.Abstractions.SearchFilterOptions?)ViewBag.FilterOptions;
    var searchTerm = (string?)ViewBag.SearchTerm;
    var selectedCity = (string?)ViewBag.SelectedCity;
    var selectedCategory = (string?)ViewBag.SelectedCategory;
    var selectedNeighborhood = (string?)ViewBag.SelectedNeighborhood;
}

<div class="cuia-container cuia-section">
    <!-- Cabeçalho da Busca V5 -->
    <div style="margin-bottom: 32px;">
        <span class="cuia-tag cuia-tag-floresta" style="margin-bottom: 8px;">✦ Catálogo Gastronômico</span>
        <h1 class="cuia-section-title" style="margin-top: 8px;">Restaurantes e Sabores do Pará</h1>
        <p class="cuia-section-subtitle">
            Encontre pratos típicos, restaurantes tradicionais, açaí, tacacá e especialidades paraenses em todo o estado.
        </p>
    </div>

    <!-- Barra de Filtros Combinados V5 -->
    <form method="get" action="/busca" class="cuia-card" style="margin-bottom: 32px; padding: 24px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; align-items: end;">
            <div>
                <label for="searchQuery" style="display: block; font-size: 13px; font-weight: 700; color: var(--texto-secundario, #4b635a); margin-bottom: 6px;">Termo ou Prato</label>
                <input id="searchQuery" type="text" name="q" value="@searchTerm" placeholder="Ex: Filhote, Açaí, Tacacá..." class="cuia-input" style="width: 100%;" />
            </div>

            <div>
                <label for="searchCity" style="display: block; font-size: 13px; font-weight: 700; color: var(--texto-secundario, #4b635a); margin-bottom: 6px;">Cidade</label>
                <select id="searchCity" name="city" class="cuia-input" style="width: 100%;">
                    <option value="">Todas as Cidades</option>
                    @if (filters?.Cities != null)
                    {
                        foreach (var city in filters.Cities)
                        {
                            <option value="@city" selected="@(city == selectedCity)">@city</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="searchCategory" style="display: block; font-size: 13px; font-weight: 700; color: var(--texto-secundario, #4b635a); margin-bottom: 6px;">Categoria</label>
                <select id="searchCategory" name="category" class="cuia-input" style="width: 100%;">
                    <option value="">Todas as Categorias</option>
                    @if (filters?.Categories != null)
                    {
                        foreach (var cat in filters.Categories)
                        {
                            <option value="@cat" selected="@(cat == selectedCategory)">@cat</option>
                        }
                    }
                </select>
            </div>

            <div style="display: flex; gap: 8px;">
                <button type="submit" class="cuia-btn cuia-btn-secondary" style="flex: 1;">
                    Filtrar
                </button>
                <a href="/busca" class="cuia-btn cuia-btn-outline" title="Limpar Filtros">Limpar</a>
            </div>
        </div>
    </form>

    <!-- Resumo dos Resultados -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
        <p style="margin: 0; color: var(--texto-secundario, #4b635a); font-size: 15px;">
            Exibindo <strong>@Model.Items.Count</strong> de <strong>@Model.TotalCount</strong> estabelecimentos encontrados.
        </p>
    </div>

    <!-- Resultados -->
    @if (Model.Items.Count == 0)
    {
        <div class="cuia-card" style="text-align: center; padding: 60px 20px; margin: 20px 0;">
            <div style="font-size: 36px; margin-bottom: 12px; color: var(--tucupi-600, #c48b28);">✦</div>
            <h3 style="font-weight: 800; color: var(--floresta-900, #113F32); margin-bottom: 8px; font-size: 20px;">Nenhum restaurante encontrado</h3>
            <p style="color: var(--texto-secundario, #4b635a); max-width: 500px; margin: auto; font-size: 14px;">
                Tente ajustar os termos da busca, selecionar outra cidade ou limpar os filtros para ver mais opções da culinária paraense.
            </p>
            <div style="margin-top: 24px;">
                <a href="/busca" class="cuia-btn cuia-btn-secondary">Ver Todos os Restaurantes</a>
            </div>
        </div>
    }
    else
    {
        <div class="para-restaurant-grid">
            @foreach (var restaurant in Model.Items)
            { @await Html.PartialAsync("_RestaurantCard", restaurant) }
        </div>

        <!-- Paginação V5 -->
        @if (Model.TotalPages > 1)
        {
            <div style="display: flex; justify-content: center; gap: 8px; margin-top: 40px; align-items: center;">
                @if (Model.Page > 1)
                {
                    <a href="/busca?q=@Uri.EscapeDataString(searchTerm ?? "")&city=@Uri.EscapeDataString(selectedCity ?? "")&category=@Uri.EscapeDataString(selectedCategory ?? "")&neighborhood=@Uri.EscapeDataString(selectedNeighborhood ?? "")&page=@(Model.Page - 1)" class="cuia-btn cuia-btn-outline cuia-btn-sm">
                        ← Anterior
                    </a>
                }

                <span style="font-size: 14px; color: var(--texto-secundario, #4b635a); padding: 0 12px;">
                    Página <strong>@Model.Page</strong> de <strong>@Model.TotalPages</strong>
                </span>

                @if (Model.Page < Model.TotalPages)
                {
                    <a href="/busca?q=@Uri.EscapeDataString(searchTerm ?? "")&city=@Uri.EscapeDataString(selectedCity ?? "")&category=@Uri.EscapeDataString(selectedCategory ?? "")&neighborhood=@Uri.EscapeDataString(selectedNeighborhood ?? "")&page=@(Model.Page + 1)" class="cuia-btn cuia-btn-outline cuia-btn-sm">
                        Próxima →
                    </a>
                }
            </div>
        }
    }
</div>
