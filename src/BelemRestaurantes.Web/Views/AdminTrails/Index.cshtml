@model IReadOnlyList<BelemRestaurantes.Domain.Entities.GastronomicTrail>
@{Layout="_AdminLayout";ViewData["Title"]="Roteiros editoriais";}
<section class="para-container para-section"><h1>Roteiros editoriais</h1><p>Confira a fonte de cada etapa. Uma edição vira rascunho; publicação exige nova decisão. Duração editorial não é horário nem previsão de transporte.</p><div class="editorial-grid">@foreach(var row in Model){<article class="editorial-card"><h2>@row.Title</h2><p>@(row.IsActive&&row.EditorialState=="published"?"Publicado":row.EditorialJson is null?"Legado: completar referências":"Rascunho") · versão @row.EditorialVersion</p><p>Revisão: @(row.ReviewedAt?.ToString("dd/MM/yyyy")??"Ainda não registrada")</p>@if(row.ReviewedAt is {} reviewed&&reviewed<DateTime.UtcNow.AddDays(-90)){<p>Atualização editorial pendente.</p>}<a href="/admin/roteiros/@row.Id">Editar etapas e referências ↗</a>@if(row.EditorialJson is not null){<form method="post" action="/admin/roteiros/@row.Id/publicacao">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@row.EditorialVersion"/><input type="hidden" name="published" value="@(!(row.IsActive&&row.EditorialState=="published"))"/><button class="para-button" type="submit">@(row.IsActive&&row.EditorialState=="published"?"Despublicar":"Publicar após revisão")</button></form>}</article>}</div><p><a href="/admin/crawler">Conferir fontes e fila do coletor existente ↗</a></p></section>
