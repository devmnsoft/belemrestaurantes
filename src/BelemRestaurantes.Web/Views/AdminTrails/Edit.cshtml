@model BelemRestaurantes.Web.Controllers.TrailEditInput
@{Layout="_AdminLayout";ViewData["Title"]="Editar roteiro";}
<section class="para-container para-section"><h1>Revisar roteiro e etapas</h1><p><a href="/admin/roteiros">Voltar à lista</a></p><form method="post" class="panel editorial-form"><input asp-for="Version" type="hidden"/>@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert"></div>
<label asp-for="Title">Título</label><input asp-for="Title"/><label asp-for="Description">Resumo</label><textarea asp-for="Description" rows="3"></textarea><label asp-for="DurationHours">Estimativa de horas de passeio (não de transporte)</label><input asp-for="DurationHours" type="number" min="1" max="24"/>
<label asp-for="Audience">Para quem</label><input asp-for="Audience"/><label asp-for="Origin">Começo sugerido</label><input asp-for="Origin"/><label asp-for="Mode">Tipo de planejamento</label><select asp-for="Mode"><option value="urban">Urbano</option><option value="road">Terrestre</option><option value="river">Fluvial</option></select><label asp-for="BeforeYouGo">O que confirmar antes de sair</label><textarea asp-for="BeforeYouGo" rows="4"></textarea><label asp-for="Accessibility">Condições e verificação de acessibilidade</label><textarea asp-for="Accessibility" rows="3"></textarea>
<h2>De três a cinco etapas</h2><p>Deixe as etapas opcionais vazias. Preencha uma referência identificada e HTTPS em cada etapa utilizada.</p>
@for(var i=0;i<Model.Stops.Count;i++){<fieldset class="editorial-card"><legend>Etapa @(i+1)</legend><label asp-for="Stops[i].Name">Nome do lugar</label><input asp-for="Stops[i].Name"/><label asp-for="Stops[i].City">Município</label><input asp-for="Stops[i].City"/><label asp-for="Stops[i].Summary">Orientação ao visitante</label><textarea asp-for="Stops[i].Summary" rows="3"></textarea><label asp-for="Stops[i].SourceName">Nome da fonte</label><input asp-for="Stops[i].SourceName"/><label asp-for="Stops[i].SourceUrl">Link da referência</label><input asp-for="Stops[i].SourceUrl" type="url"/></fieldset>}
<button type="submit" class="para-button">Salvar rascunho para revisão</button></form></section>
