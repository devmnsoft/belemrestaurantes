@model BelemRestaurantes.Domain.Entities.GastronomicTrail
@using System.Text.Json
@using BelemRestaurantes.Application.Services
@inject Microsoft.Extensions.Configuration.IConfiguration SeoConfig
@{var seoOrigin = SitemapBuilder.ResolvePublicOrigin(SeoConfig["Seo:PublicOrigin"]);ViewData["Title"]=Model.Title;ViewData["OgType"]="article";ViewData["OgTitle"]=$"{Model.Title} | Belém Restaurantes";ViewData["OgDescription"]=Model.Description;ViewData["OgUrl"]=string.Concat(seoOrigin,"/roteiros/",Model.Slug);var guide=Model.Editorial;}
<section class="para-container editorial-hero"><a href="/roteiros">← Todos os roteiros</a><p class="para-eyebrow">@Model.Region</p><h1>@Model.Title</h1><p>@Model.Description</p><p><strong>@Model.EstimatedDurationHours h de passeio · estimativa editorial</strong>, sem incluir previsão de transporte.</p></section>
@if(guide is not null){
<section class="para-container para-section" data-trail-page><div class="editorial-note"><h2>Do seu jeito, no seu tempo</h2><p><strong>Para quem:</strong> @guide.Audience</p><p><strong>Começo sugerido:</strong> @guide.Origin</p><p><strong>Acesso:</strong> @(guide.Mode=="river"?"Planejamento fluvial":guide.Mode=="road"?"Planejamento terrestre":"Circuito urbano")</p><p>@guide.BeforeYouGo</p><p>@guide.Accessibility</p><p>Revisão editorial: @Model.ReviewedAt?.ToString("dd/MM/yyyy"). As fontes registram referências do lugar; consulte os canais oficiais para condições atuais.</p>@if(Model.ReviewedAt is {} reviewed&&reviewed<DateTime.UtcNow.AddDays(-90)){<p role="status">Este roteiro está na fila de atualização editorial. Confirme os dados diretamente nas fontes.</p>}</div>
<div class="editorial-actions"><button class="para-button" type="button" data-save-trail>Adicionar etapas ao meu passeio</button><a href="/meu-passeio">Organizar o passeio ↗</a><a href="/cuia-ia?q=@Uri.EscapeDataString("Quero planejar o roteiro "+Model.Title+" em Belém. O que devo confirmar?")&amp;searchWeb=true">Perguntar à Cuia com pesquisa externa ↗</a></div>
<script type="application/json" id="trail-steps">@Html.Raw(JsonSerializer.Serialize(guide.Stops.Select(s=>new{kind="external",name=s.Name,city=s.City,url=s.SourceUrl})))</script>
<h2>Etapas para adaptar ao seu dia</h2><ol class="editorial-stops">@foreach(var stop in guide.Stops){<li><article class="editorial-card"><span class="para-tier is-external">Etapa editorial com fonte · não é ficha conferida</span><h3>@stop.Name</h3><p>@stop.City</p><p>@stop.Summary</p><p><a href="@stop.SourceUrl" target="_blank" rel="noopener noreferrer">Consultar referência: @stop.SourceName ↗</a></p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=@Uri.EscapeDataString(stop.Name+", "+stop.City+", Pará")" target="_blank" rel="noopener noreferrer">Buscar o local no Google Maps (serviço externo) ↗</a></p><button type="button" class="para-save" data-save-kind="external" data-save-name="@stop.Name" data-save-city="@stop.City" data-save-url="@stop.SourceUrl">Guardar esta etapa</button></article></li>}</ol>
<p>Esta sequência não é um trajeto calculado. Se uma etapa não estiver disponível, remova-a em Meu passeio e escolha outra experiência.</p></section>
}else{
<section class="para-container para-section"><h2>Lugares deste roteiro</h2>@foreach(var stop in Model.Stops){<article class="editorial-card"><h3><a href="/establishment/@stop.RestaurantId">@stop.RestaurantName</a></h3><p>@stop.Notes</p><a href="/cuia-rotas?restaurantId=@stop.RestaurantId">Planejar chegada ↗</a></article>}<p><a href="/roteiros">Explorar outros roteiros</a></p></section>
}
