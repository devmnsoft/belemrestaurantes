@model IReadOnlyList<BelemRestaurantes.Domain.Entities.GastronomicTrail>
@{ViewData["Title"]="Roteiros para descobrir os sabores do Pará";}
<section class="para-container editorial-hero"><span class="para-eyebrow">CULTURA, GASTRONOMIA E PAISAGEM</span><h1>O próximo passeio tem sabor.</h1><p>Escolha um caminho, conheça suas referências e adapte as etapas ao seu tempo. Estes roteiros são propostas editoriais; horários, reservas e deslocamentos precisam de confirmação.</p><a href="/meu-passeio">Ver meu passeio guardado ↗</a></section>
<section class="para-container para-section"><h2>Por onde você quer começar?</h2>
@if(Model.Count>0){@await Html.PartialAsync("_TrailCards",Model)}else{<p>Não há roteiro publicado agora. Comece por <a href="/pratos">um prato do Pará</a>, <a href="/descobrir">uma descoberta</a> ou <a href="/cuia-ia">uma pergunta à Cuia</a>.</p>}
</section>
