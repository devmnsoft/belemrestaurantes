@model BelemRestaurantes.Application.Models.ModerationBatch
@{Layout="_AdminLayout";ViewData["Title"]="Confirmar ação em lote";}
<section class="para-operations"><span class="para-eyebrow">REVISÃO FINAL</span><h1>Confirme os @Model.Items.Count cadastros.</h1><p>Operação: @Model.Operation · @Model.Reason</p><p>A seleção é fixa e expira em 15 minutos. A validação será repetida na transação; cadastros inválidos ou já decididos serão ignorados.</p><ul>@foreach(var row in Model.Items){<li>#@row.Id — @row.Name, @row.City · @(row.BlockReason??"Elegível")</li>}</ul><form method="post" action="/admin/moderacao/confirmar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label><input type="checkbox" name="confirmed" value="true" required /> Conferi a seleção e confirmo a operação.</label><p><button class="para-button">Confirmar ação</button> <a href="/admin/moderacao">Cancelar</a></p></form></section>
