@model BelemRestaurantes.Application.Models.ModerationBatch
@using BelemRestaurantes.Web.Models
@{Layout="_AdminLayout";ViewData["Title"]="Resultado da revisão";var results=Model.Results!;var applied=results.Count(r=>r.Outcome=="applied");var ignored=results.Count(r=>r.Outcome=="ignored");var returnUrl=ModerationNavigation.SafeReturn(ViewData["ReturnUrl"] as string);}
<section class="para-operations review-workspace"><header class="review-heading"><span class="para-eyebrow">REVISÃO CONCLUÍDA</span><h1>@applied cadastros atualizados</h1><p>@ignored sem alteração · @results.Count(r=>r.Outcome=="failed") falhas · @results.Count selecionados</p></header>
<div class="review-filter-actions"><a href="@returnUrl" class="para-button">Continuar com os mesmos filtros</a><a href="/busca">Ver catálogo público</a></div>
<p><strong>Ação:</strong> @ModerationNavigation.OperationLabel(Model.Operation). Reenviar a confirmação mostra o mesmo resultado, sem repetir a ação.</p>
@if(ignored>0){<h2>Cadastros que precisam de atenção</h2><ul class="review-confirm-list">@foreach(var row in results.Where(r=>r.Outcome!="applied")){<li><strong>@row.Name</strong><span>Cadastro #@row.Id · @row.Reason</span></li>}</ul>}
@if(applied>0){<details class="review-row-details"><summary>Ver os @applied cadastros atualizados</summary><ul class="review-confirm-list">@foreach(var row in results.Where(r=>r.Outcome=="applied")){<li><strong>@row.Name</strong><span>Cadastro #@row.Id · @row.Reason</span></li>}</ul></details>}
<p><a href="/admin/moderacao/lote/@Model.Id">Consultar novamente o resultado deste lote</a></p>
<p class="review-batch-id">Identificador do lote: @Model.Id</p></section>
