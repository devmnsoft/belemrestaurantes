@model BelemRestaurantes.Application.Models.ModerationBatch
@{Layout="_AdminLayout";ViewData["Title"]="Resultado da moderação";var results=Model.Results!;}
<section class="para-operations"><span class="para-eyebrow">CUIA · RESULTADO AUDITADO</span><h1>@results.Count(r=>r.Outcome=="applied") aplicados. @results.Count(r=>r.Outcome=="ignored") ignorados.</h1><p>@results.Count selecionados · @results.Count(r=>r.Outcome=="failed") falhas.</p><p>Operação @Model.Operation · Lote @Model.Id. Reenviar esta confirmação devolve o mesmo resultado.</p><ul>@foreach(var row in results){<li>#@row.Id — @row.Name · @row.Reason</li>}</ul><a href="/admin/moderacao" class="para-button">Voltar à central</a> <a href="/busca">Ver catálogo público</a></section>
