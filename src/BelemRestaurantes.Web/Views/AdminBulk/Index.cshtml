@model BelemRestaurantes.Application.Models.PagedResult<BelemRestaurantes.Application.Models.ModerationCandidate>
@using BelemRestaurantes.Application.Models
@{ Layout="_AdminLayout"; ViewData["Title"]="Central de aprovação"; var f=(ModerationFilter)ViewData["Filter"]!;
string PageUrl(int page)=>"/admin/moderacao"+Microsoft.AspNetCore.Http.QueryString.Create(new Dictionary<string,string?> { ["Term"]=f.Term,["City"]=f.City,["Category"]=f.Category,["Source"]=f.Source,["Completeness"]=f.Completeness,["Duplicate"]=f.Duplicate,["From"]=f.From?.ToString("yyyy-MM-dd"),["Until"]=f.Until?.ToString("yyyy-MM-dd"),["page"]=page.ToString() }); }
<section class="para-operations">
<span class="para-eyebrow">CUIA · CURADORIA HUMANA</span><h1>Uma boa mesa começa com cuidado.</h1>
<p>Revise os dados e a fonte. A publicação no guia não confirma funcionamento ou qualidade.</p>
<form method="get" class="para-review-filters">
<div><label for="term">Nome, endereço ou identificador</label><input id="term" name="Term" value="@f.Term" maxlength="160" /></div>
<div><label for="city">Município</label><input id="city" name="City" value="@f.City" maxlength="100" /></div>
<div><label for="category">Categoria</label><input id="category" name="Category" value="@f.Category" maxlength="100" /></div>
<div><label for="source">Fonte</label><select id="source" name="Source"><option value="">Todas</option>@foreach(var source in new[]{"minha_receita","openstreetmap","googleplaces","suggestion"}){<option selected="@(source==f.Source)">@source</option>}</select></div>
<div><label for="complete">Validação</label><select id="complete" name="Completeness"><option value="">Todos</option><option value="eligible" selected="@(f.Completeness=="eligible")">Elegíveis para publicação</option><option value="incomplete" selected="@(f.Completeness=="incomplete")">Com impedimentos</option></select></div>
<div><label for="duplicate">Duplicidade</label><select id="duplicate" name="Duplicate"><option value="">Todas</option><option value="yes" selected="@(f.Duplicate=="yes")">Possíveis duplicados</option><option value="no" selected="@(f.Duplicate=="no")">Sem alerta</option></select></div>
<div><label for="from">Descoberto a partir de</label><input type="date" id="from" name="From" value="@f.From?.ToString("yyyy-MM-dd")" /></div><div><label for="until">Até</label><input type="date" id="until" name="Until" value="@f.Until?.ToString("yyyy-MM-dd")" /></div><button class="para-button">Aplicar filtros</button></form>
<p><strong>@Model.TotalCount</strong> cadastros no filtro · Limite por confirmação: @ViewData["BatchLimit"].</p>
<form method="post" action="/admin/moderacao/preparar">
@Html.AntiForgeryToken()
@foreach(var field in new Dictionary<string,string?>{["Term"]=f.Term,["City"]=f.City,["Category"]=f.Category,["Source"]=f.Source,["Completeness"]=f.Completeness,["Duplicate"]=f.Duplicate,["From"]=f.From?.ToString("yyyy-MM-dd"),["Until"]=f.Until?.ToString("yyyy-MM-dd")}){<input type="hidden" name="@field.Key" value="@field.Value" />}
<div class="cuia-card p-3 mb-3"><label><input type="checkbox" name="allFiltered" value="true" /> Selecionar todos os @Model.TotalCount resultados do filtro, incluindo outras páginas</label><p>Se exceder o limite, refine o filtro. A próxima tela mostra exatamente quais registros serão afetados.</p></div>
<div class="para-review-grid">
@foreach(var row in Model.Items){<article class="para-review-card"><label class="form-check"><input type="checkbox" name="ids" value="@row.Id" /> Selecionar #@row.Id</label><h2>@row.Name</h2><p>@row.Category · @row.City · @row.Neighborhood</p><p>@(row.Address??"Endereço ausente")</p><p>@(row.Phone??"Telefone ausente")</p><p>@row.Source · @row.DiscoveredAt.ToString("dd/MM/yyyy HH:mm") UTC</p><p>Completude: @row.Completeness% · @(row.Duplicate?"Possível duplicidade":"Sem alerta de duplicidade")</p><p>@(row.BlockReason??"Elegível para revisão e publicação")</p><p class="small">@row.ExternalId</p>@if(Uri.TryCreate(row.SourceUrl,UriKind.Absolute,out var uri)&&uri.Scheme=="https"){<a href="@uri" target="_blank" rel="noopener noreferrer">Conferir fonte ↗</a>}<p><a href="/admin/mobilidade?restaurantId=@row.Id">Horários e funcionamento</a></p></article>}
</div>
@if(Model.Items.Count==0){<p class="para-empty">Nenhum cadastro neste filtro.</p>}
<div class="cuia-card p-3 mt-3"><label for="operation">O que fazer com a seleção?</label><select id="operation" name="operation"><option value="approve">Aprovar e publicar</option><option value="reject">Rejeitar</option><option value="review">Solicitar revisão</option><option value="duplicate">Marcar possível duplicado</option><option value="reprocess">Reprocessar enriquecimento</option></select><label for="reason">Motivo (obrigatório exceto para aprovação)</label><textarea id="reason" name="reason" maxlength="500"></textarea><button class="para-button mt-3">Revisar ação e quantidade</button></div>
</form>
<nav class="para-pagination" aria-label="Paginação">@if(Model.Page>1){<a href="@PageUrl(Model.Page-1)">Anterior</a>}<span>@Model.Page / @Math.Max(1,Model.TotalPages)</span>@if(Model.Page<Model.TotalPages){<a href="@PageUrl(Model.Page+1)">Próxima</a>}</nav>
</section>
