@{ Layout = "_AdminLayout"; ViewData["Title"] = T["SecondFactor"].Value; }
<section class="shell section narrow">
  <h1>@T["SecondFactor"]</h1>
  <p class="muted">@T["TotpIntro"]</p>
  <form method="post" action="@Url.Action("VerifyMfaSubmit","AdminAccount")" class="panel">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/>
    <label>@T["TotpCode"]
      <input name="code" required maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus/>
    </label>
    <button type="submit">@T["Verify"]</button>
    @Html.ValidationSummary()
  </form>
</section>
