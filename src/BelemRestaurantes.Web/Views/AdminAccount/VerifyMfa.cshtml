@{ ViewData["Title"] = "Verificar segundo fator"; }
<section class="shell section">
  <h1>Verificar MFA</h1>
  <p class="muted">Informe o código de 6 dígitos do aplicativo autenticador.</p>
  <form method="post" action="@Url.Action("VerifyMfaSubmit","AdminAccount")" class="panel">
    @Html.AntiForgeryToken()
    <label>Código TOTP <input name="code" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" /></label>
    <button type="submit">Verificar</button>
    @Html.ValidationSummary()
  </form>
</section>