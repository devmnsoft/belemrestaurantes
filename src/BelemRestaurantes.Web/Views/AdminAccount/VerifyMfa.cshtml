@{ Layout = "_AdminLayout"; ViewData["Title"] = "Segundo fator"; }
<section class="shell section narrow">
  <h1>Segundo fator</h1>
  <p class="muted">Digite o código de 6 dígitos do app autenticador.</p>
  <form method="post" action="@Url.Action("VerifyMfaSubmit","AdminAccount")" class="panel">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/>
    <label>Código TOTP
      <input name="code" required maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus/>
    </label>
    <button type="submit">Verificar</button>
    @Html.ValidationSummary()
  </form>
</section>
