@model IReadOnlyList<BelemRestaurantes.Domain.Entities.LgpdRequest>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Solicitações LGPD";
}
<section class="shell section">
  @if (TempData["Flash"] is string flash)
  {
      <div class="flash">@flash</div>
  }

  <div class="heading">
    <div>
      <span class="overline dark">✦ Painel Administrativo MNSOFT</span>
      <h1>Solicitações LGPD</h1>
      <p class="muted">Atendimento de direitos dos titulares de dados (Lei 13.709/2018).</p>
    </div>
    <div>
      <a href="/admin/dashboard" class="button-link ghost">← Voltar ao painel</a>
    </div>
  </div>

  @if (Model.Count == 0)
  {
      <div class="panel" style="text-align:center;padding:40px;">
        <p class="muted">Nenhuma solicitação LGPD pendente no momento.</p>
      </div>
  }
  else
  {
      <div style="display:grid;gap:16px;margin-top:20px;">
        @foreach (var req in Model)
        {
            <div class="panel" style="display:grid;gap:10px;">
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <span class="badge @(req.RequestType == "deletion" ? "red" : "green")" style="font-size:13px;">
                  Tipo: @req.RequestType.ToUpperInvariant()
                </span>
                <small class="muted">Solicitado em @req.RequestedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("g")</small>
              </div>

              <div>
                <b>Titular (User ID):</b> <code>@req.UserId</code>
                @if (!string.IsNullOrWhiteSpace(req.Notes))
                {
                    <div style="margin-top:4px;"><b>Motivo:</b> @req.Notes</div>
                }
              </div>

              <div style="display:flex;gap:10px;margin-top:8px;">
                @if (req.RequestType == "deletion" || req.RequestType == "anonymization")
                {
                    <form method="post" action="/admin/lgpd/@req.Id/anonymize" onsubmit="return confirm('ATENÇÃO: Deseja realmente anonimizar os dados pessoais deste titular? Esta ação revogará credenciais e desvinculará a identidade.');">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="userId" value="@req.UserId" />
                      <button type="submit" class="danger">Executar Anonimização (LGPD Art. 16)</button>
                    </form>
                }

                <form method="post" action="/admin/lgpd/@req.Id/complete">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="notes" value="Atendido administrativamente" />
                  <button type="submit" class="ghost">Marcar como Concluído</button>
                </form>
              </div>
            </div>
        }
      </div>
  }
</section>
