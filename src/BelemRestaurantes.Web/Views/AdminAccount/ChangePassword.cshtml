@{ViewData["Title"]="Troque sua senha inicial";}
<section class="para-shell para-section"><span class="para-eyebrow">MNSOFT · ACESSO SEGURO</span><h1 class="para-editorial-title">Sua conta, sua senha.</h1><p>Defina uma nova senha antes de acessar o painel. Use ao menos 12 caracteres, com maiúscula, minúscula, número e símbolo.</p>
@if (TempData["RecoveryCodes"] is string recoveryCodes)
{
  <section aria-labelledby="recovery-title"><h2 id="recovery-title">Guarde estes códigos de recuperação</h2><p>Use um código se perder o aplicativo autenticador. Cada código funciona uma vez. O segundo fator continua obrigatório. Esta é a única vez que mostramos estes códigos.</p><ul class="recovery-codes">@foreach (var code in recoveryCodes.Split(' ', StringSplitOptions.RemoveEmptyEntries)){<li><code>@code</code></li>}</ul></section>
}
<form method="post" action="/admin/change-password" class="panel">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label for="current">Senha atual</label><input id="current" type="password" name="currentPassword" autocomplete="current-password" required maxlength="256"/><label for="password">Nova senha</label><input id="password" type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="256"/><label for="confirmation">Repita a nova senha</label><input id="confirmation" type="password" name="confirmation" autocomplete="new-password" required maxlength="256"/><button class="para-button">Salvar senha e entrar novamente</button></form></section>
