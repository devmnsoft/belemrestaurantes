@{ Layout = "_AdminLayout"; ViewData["Title"] = T["EnrollTitle"].Value; }
<section class="shell section narrow">
  <h1>@T["EnrollTitle"]</h1>
  <p>@T["EnrollIntro"]</p>
  <p><code class="secret">@ViewData["Secret"]</code></p>
  <form method="post" action="@Url.Action("EnrolSubmit","AdminAccount")" class="panel">
    @Html.AntiForgeryToken()
    <label>@T["TotpCode"] <input name="code" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code"/></label>
    <button type="submit">@T["Activate"]</button>
    @Html.ValidationSummary()
  </form>
</section>
