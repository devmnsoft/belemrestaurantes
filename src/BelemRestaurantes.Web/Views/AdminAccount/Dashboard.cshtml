@{ ViewData["Title"] = T["AdminTitle"].Value; }
<section class="shell section">
  <h1>@T["AdminTitle"] · MNSOFT</h1>
  <ul>
    <li><a href="/api/admin/review/pending">@T["PendingRestaurants"]</a></li>
    <li>@T["Health"]: <a href="/health/ready">/health/ready</a></li>
  </ul>
  <form method="post" action="@Url.Action("Logout","AdminAccount")">
    @Html.AntiForgeryToken()
    <button type="submit">@T["SignOut"]</button>
  </form>
</section>