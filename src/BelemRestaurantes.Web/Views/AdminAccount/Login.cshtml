@{ Layout = "_AdminLayout"; ViewData["Title"] = "Entrar"; }
<section class="shell section narrow">
  <h1>Painel administrativo</h1>
  <p class="muted">Acesso com usuário, senha e segundo fator (TOTP).</p>
  @if (Context.Request.Query.ContainsKey("expired"))
  {
      <p class="flash">Sessão encerrada: a conta foi desativada ou a sessão expirou.</p>
  }
  <form method="post" action="@Url.Action("LoginSubmit","AdminAccount")" class="panel">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/>
    <label>Usuário <input name="userName" required maxlength="100" autocomplete="username"/></label>
    <label>Senha <input name="password" type="password" required maxlength="256" autocomplete="current-password"/></label>
    <button type="submit">Entrar</button>
    @Html.ValidationSummary()
  </form>

</section>
