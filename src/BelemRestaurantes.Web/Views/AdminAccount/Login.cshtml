@{ Layout = "_Layout"; ViewData["Title"] = T["SignIn"].Value; }
<section class="para-container para-auth">
@await Html.PartialAsync("_AuthStory")
<div class="para-auth-content"><span class="para-eyebrow">MNSOFT · GESTÃO DO CATÁLOGO</span>
  <h1>@T["AdminTitle"]</h1>
  <p class="muted">@T["AdminIntro"]</p>
  @if (Context.Request.Query.ContainsKey("expired"))
  {
      <p class="flash">@T["SessionExpired"]</p>
  }
  <form method="post" action="@Url.Action("LoginSubmit","AdminAccount")" class="panel">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/>
    <label>@T["UserName"] <input name="userName" required maxlength="100" autocomplete="username"/></label>
    <label>@T["Password"] <input name="password" type="password" required maxlength="256" autocomplete="current-password"/></label>
    <button type="submit">@T["SignIn"]</button>
    @Html.ValidationSummary()
  </form>

</div></section>
