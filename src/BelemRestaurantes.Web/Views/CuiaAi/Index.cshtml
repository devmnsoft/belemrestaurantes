@model BelemRestaurantes.Application.Abstractions.CuiaAiResponse
@using System.Text.Json
@using BelemRestaurantes.Application.Formatting
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cuia IA — Seu guia de sabores do Pará";
    ViewData["MetaDescription"] = "Conte o que você procura. A Cuia ajuda a encontrar restaurantes, pratos e experiências paraenses.";
    ViewData["AtlasEditorial"] = true;
    var cities = ViewData["Cities"] as IReadOnlyList<string> ?? [];
    var initialPrompt = ViewData["InitialPrompt"] as string ?? "";
    var initialCity = ViewData["InitialCity"] as string ?? "";
    string KindLabel(string? kind) => kind switch
    {
        "referencia" => "Resposta baseada nas fontes identificadas.",
        "esclarecimento" => "Precisamos identificar o lugar correto.",
        "servico" => "Resposta feita com IA no contexto do portal.",
        "pesquisa" => "Resposta feita com IA e pesquisa externa. Confira as fontes abaixo.",
        "limite" => "A pergunta saiu do que a Cuia pode responder neste portal.",
        _ => "Resposta feita com o conteúdo local do portal, sem geração por IA."
    };
}
<section class="cuia-ai-page" lang="pt-BR">
  <div class="para-container">
    <nav class="para-breadcrumb" aria-label="Você está aqui">
      <a href="/">Início</a>
      <span aria-hidden="true">/</span>
      <span>Cuia IA</span>
    </nav>

    <header class="cuia-ai-hero">
      <div class="cuia-ai-hero-copy">
        <p class="cuia-ai-badge">@await Html.PartialAsync("_ParaIcon", "cuia") <span>Guia de sabores do Pará</span></p>
        <h1>Cuia IA — Seu guia de sabores do Pará</h1>
        <p>Conte o que você procura. A Cuia ajuda a encontrar restaurantes, pratos e experiências paraenses.</p>
      </div>
      <figure class="cuia-ai-mark" aria-hidden="true">
        <svg viewBox="0 0 88 88" xmlns="http://www.w3.org/2000/svg">
          <rect width="88" height="88" rx="22" fill="#143f32"/>
          <path d="M8 62c10 6 18-2 28 2s16 8 28 2 12-8 16-4v16H8V62z" fill="#1d4e89"/>
          <path d="M8 68c12 4 16-4 28-2s18 8 36 0" fill="none" stroke="#7eb6d6" stroke-width="2"/>
          <path d="M24 46c0-12 8-20 20-20s20 8 20 20c2 10-6 16-20 18-14-2-22-8-20-18z" fill="#f3ead8" stroke="#efb645" stroke-width="2"/>
          <path d="M34 28c6-10 16-8 20 0" fill="none" stroke="#2f6b45" stroke-width="2"/>
          <circle cx="58" cy="18" r="4" fill="#a63725"/>
        </svg>
      </figure>
    </header>

    <div class="cuia-ai-layout">
      <div class="cuia-ai-card">
        <div hidden>@Html.AntiForgeryToken()</div>
        <form id="cuia-ai-form" class="cuia-ai-form" method="get" action="/cuia-ia">
          <div class="cuia-ai-input-wrapper">
            <div>
              <label for="ai-prompt">O que você quer comer ou visitar?</label>
              <textarea id="ai-prompt" name="q" maxlength="500" rows="3" required placeholder="Ex.: Onde almoçar peixe na beira do rio no domingo?">@initialPrompt</textarea>
              <p id="ai-prompt-count" class="cuia-ai-count" aria-live="polite">@initialPrompt.Length / 500</p>
            </div>
            <button type="submit" id="ai-submit" class="cuia-ai-submit-btn">Perguntar à Cuia</button>
          </div>

          <details id="cuia-ai-filters" class="cuia-ai-filters-panel">
            <summary>Município, ocasião e preferência alimentar</summary>
            <div class="cuia-ai-filters">
              <div class="cuia-ai-filter-item">
                <label for="ai-city">Município</label>
                <select id="ai-city" name="city">
                  <option value="">Todo o Pará</option>
                  @foreach (var c in cities)
                  {
                    <option value="@c" selected="@(c == initialCity)">@c</option>
                  }
                </select>
              </div>
              <div class="cuia-ai-filter-item">
                <label for="ai-occasion">Ocasião</label>
                <select id="ai-occasion" name="occasion">
                  <option value="">Qualquer momento</option>
                  <option value="familia">Em família</option>
                  <option value="romantico">A dois</option>
                  <option value="rapido">Parada rápida</option>
                  <option value="ribeirinho">Beira de rio</option>
                  <option value="tradicional">Comida de mercado</option>
                </select>
              </div>
              <div class="cuia-ai-filter-item">
                <label for="ai-dietary">Preferência alimentar</label>
                <select id="ai-dietary" name="dietary">
                  <option value="">Sem restrição</option>
                  <option value="vegetariano">Vegetariano</option>
                  <option value="sem_frutos_mar">Sem frutos do mar</option>
                  <option value="sem_gluten">Sem glúten</option>
                </select>
              </div>
            </div>
          </details>

          <div class="cuia-ai-web-option">
            <label for="ai-search-web"><input id="ai-search-web" type="checkbox" name="searchWeb" value="true" checked="@(ViewData["SearchWeb"] as bool? == true)" aria-describedby="ai-search-web-help" /> Pesquisar também na internet</label>
            <p id="ai-search-web-help">Ao marcar, sua pergunta será enviada ao serviço de pesquisa. Não inclua dados pessoais. As fontes externas não confirmam o cadastro de um restaurante.</p>
          </div>
          <button type="button" class="para-text-button" id="cuia-clear-session">Reiniciar conversa nesta aba</button>

          <div class="cuia-ai-suggestions" role="group" aria-label="Exemplos de pergunta">
            <span class="cuia-ai-suggestions-title">Exemplos</span>
            <button type="button" class="cuia-ai-chip" data-prompt="Onde comer peixe?">Onde comer peixe?</button>
            <button type="button" class="cuia-ai-chip" data-prompt="Onde tomar tacacá tradicional?">Tacacá tradicional.</button>
            <button type="button" class="cuia-ai-chip" data-prompt="Jantar a dois" data-occasion="romantico">Jantar a dois.</button>
            <button type="button" class="cuia-ai-chip" data-prompt="Passeio no Combu. O que o portal sabe sobre a travessia?">Passeio no Combu.</button>
            <button type="button" class="cuia-ai-chip" data-prompt="Comida boa para família" data-occasion="familia">Comida boa para família.</button>
            <button type="button" class="cuia-ai-chip" data-prompt="Receitas para fazer em casa">Receitas para fazer em casa.</button>
            <button type="button" class="cuia-ai-chip" data-prompt="Restaurantes com informações de acessibilidade">Restaurantes com informações de acessibilidade.</button>
            <button type="button" class="cuia-ai-chip" data-prompt="Lugares próximos">Lugares próximos.</button>
          </div>
        </form>

        <section class="cuia-ai-guide" aria-labelledby="cuia-ai-guide-title">
          <h2 id="cuia-ai-guide-title">O que você pode perguntar</h2>
          <ol class="cuia-ai-help">
            <li>Pergunte um prato, um bairro, uma ocasião ou um passeio no Pará.</li>
            <li>Escreva no campo e toque em Perguntar à Cuia, ou escolha um exemplo. Cada exemplo faz uma consulta.</li>
            <li>A Cuia mostra restaurantes publicados com informações conferidas, receitas do caderno e, quando couber, uma nota cultural separada do cardápio.</li>
            <li>Ative a pesquisa para descobrir opções fora do catálogo, com fontes e identificação separadas.</li>
            <li>Ver restaurante abre a ficha. Como chegar abre o planejamento no Cuia Rotas.</li>
          </ol>
          <p class="cuia-ai-session-note">A pergunta inicial e as duas perguntas mais recentes ficam nesta aba para dar contexto. Você pode apagá-las acima. A pesquisa escolhida vale nesta aba; não inclua dados pessoais.</p>
        </section>

        <button type="button" id="ai-cancel" class="para-save" hidden>Cancelar consulta</button>
        <div id="ai-loading" class="cuia-ai-loading" role="status" aria-live="polite" hidden>
          <div class="cuia-ai-spinner" aria-hidden="true"></div>
          <p>A Cuia está pesquisando. Aguarde enquanto reunimos as referências.</p>
        </div>

        <div id="ai-results" class="cuia-ai-results" role="region" aria-live="polite" aria-label="Resposta da Cuia IA" tabindex="-1" @(Model == null ? "hidden" : "")>
          @if (Model != null)
          {
            <div class="cuia-ai-meta">
              <span class="cuia-ai-guarantee">@(Model.ExternalSuggestions.Count > 0 ? $"Encontramos {Model.ExternalSuggestions.Count} sugestões externas com fontes." : Model.Recommendations.Count > 0 ? $"Encontramos {Model.Recommendations.Count} opções conferidas no portal." : "Explore a resposta e as opções disponíveis abaixo.")</span>
              <span class="cuia-ai-kind">@KindLabel(Model.AnswerKind)</span>
            </div>
            @await Html.PartialAsync("_CuiaStateNotice", Model)
            <div class="cuia-ai-response-body">
              <h2>Sua resposta</h2>
              @Html.Raw(CuiaMarkdown.ToHtml(Model.AnswerMarkdown))
            </div>
            @await Html.PartialAsync("_CuiaExternal", Model)
            @await Html.PartialAsync("_CuiaSources", Model)
            @if(Model.TrailSuggestions.Count>0){<section class="cuia-ai-section"><h3>Roteiros para continuar explorando</h3><ul>@foreach(var trail in Model.TrailSuggestions){<li><a href="/roteiros/@trail.Slug">@trail.Title</a><p>@trail.Region · etapas editoriais com referências</p></li>}</ul></section>}
            @if (Model.Recommendations.Count > 0)
            {
              <div class="cuia-ai-section">
                <h3>Restaurantes com informações conferidas</h3>
                <div class="cuia-ai-grid">
                  @foreach (var place in Model.Recommendations)
                  {
                    var photoOk = !string.IsNullOrWhiteSpace(place.PhotoUrl) && (place.PhotoUrl.StartsWith("/media/", StringComparison.Ordinal) || (Uri.TryCreate(place.PhotoUrl, UriKind.Absolute, out var photoUri) && photoUri.Scheme == "https"));
                    <article class="cuia-ai-reco-card">
                      @if (photoOk)
                      { <img class="cuia-ai-photo" src="@place.PhotoUrl" alt="" width="640" height="360" /> }
                      else
                      { <div class="cuia-ai-photo-fallback" aria-hidden="true">@await Html.PartialAsync("_CategoryArtwork", place.Category ?? "Restaurante")</div> }
                      <div class="cuia-ai-reco-header">
                        <h4><a href="/estabelecimento/@place.Id">@place.Name</a></h4>
                      </div>
                      <p class="cuia-ai-reco-cat">@(place.Category ?? "Restaurante") · @place.City @(!string.IsNullOrWhiteSpace(place.Neighborhood) ? $"({place.Neighborhood})" : "")</p>
                      <p class="cuia-ai-reco-reason">@place.Reason</p>
                      @if (!string.IsNullOrWhiteSpace(place.Address))
                      { <p class="cuia-ai-reco-address">@place.Address</p> }
                      <div class="cuia-ai-reco-actions">
                        <button type="button" class="para-save" data-save-kind="catalog" data-save-id="@place.Id" data-save-name="@place.Name" data-save-city="@place.City">Guardar para depois</button>
                        <a href="/estabelecimento/@place.Id" class="para-button">Ver restaurante</a>
                        <a href="/cuia-rotas?restaurantId=@place.Id" class="para-text-link">Como chegar</a>
                      </div>
                    </article>
                  }
                </div>
              </div>
            }
            @if(Model.DirectoryMatches.Count>0) {
              <section class="cuia-ai-section"><h3>Fichas públicas para explorar</h3><p>Cadastros publicados que correspondem à busca. Não são recomendações verificadas; confirme funcionamento, serviços e acessibilidade antes de visitar.</p><ul class="cuia-ai-local-list">
              @foreach(var place in Model.DirectoryMatches){<li><a href="/establishment/@place.Id">@place.Name</a><p>@place.City · @place.Category</p><a href="/cuia-rotas?restaurantId=@place.Id">Como chegar ↗</a></li>}
              </ul></section>
            }
            @if (Model.Recipes.Count > 0)
            {
              <div class="cuia-ai-section">
                <h3>Receitas do Pará</h3>
                <div class="cuia-ai-recipes-list">
                  @foreach (var recipe in Model.Recipes)
                  {
                    <a href="/receitas/@recipe.Slug" class="cuia-ai-recipe-pill">
                      <strong>@recipe.Title</strong>
                      <span>@recipe.Subtitle · @recipe.TotalMinutes min · nível @recipe.Difficulty</span>
                    </a>
                  }
                </div>
              </div>
            }
            @if (Model.RegionalCuriosities.Count > 0)
            {
              <div class="cuia-ai-curiosities">
                <h4>Nota cultural, separada do cardápio</h4>
                <ul>
                  @foreach (var note in Model.RegionalCuriosities)
                  { <li>@note</li> }
                </ul>
              </div>
            }
            @if (Model.SuggestedFollowUps.Count > 0)
            {
              <div class="cuia-ai-followups">
                <span>Continuar nesta aba</span>
                @foreach (var follow in Model.SuggestedFollowUps)
                { <button type="button" class="cuia-ai-chip" data-prompt="@follow">@follow</button> }
              </div>
            }
            <script type="application/json" id="cuia-initial-places">@Html.Raw(JsonSerializer.Serialize(Model.Recommendations.Concat(Model.DirectoryMatches).Select(place => new { id = place.Id, name = place.Name, city = place.City, neighborhood = place.Neighborhood, latitude = place.Latitude, longitude = place.Longitude, address = place.Address })))</script>
            @if (Model.AnswerKind != "limite") { <script type="application/json" id="cuia-initial-question">@Html.Raw(JsonSerializer.Serialize(initialPrompt))</script> }
          }
        </div>
      </div>

      <aside class="cuia-ai-aside" aria-label="Outras formas de decidir">
        <h2>Se não houver opção conferida</h2>
        <a href="/pratos">Pratos do Pará</a>
        <a href="/mapa">Mapa dos publicados</a>
        <a href="/busca?tier=ficha">Fichas, com informações menos completas</a>
        <a href="/travessias">Travessias com fonte</a>
        <a href="/receitas">Receitas para fazer em casa</a>
        <a href="/guia">Como um restaurante é conferido</a>
      </aside>
    </div>
  </div>
</section>

@section Scripts {
  <script src="~/js/cuia-ai.js" asp-append-version="true" defer></script>
}

@await Component.InvokeAsync("SearchTopics")
