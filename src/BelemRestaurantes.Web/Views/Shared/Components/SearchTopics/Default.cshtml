@model IReadOnlyList<BelemRestaurantes.Application.Abstractions.SearchTopic>
@if(Model.Count>0){
<section class="para-container search-topics" aria-label="Assuntos mais buscados">
<h2>Sabores em alta</h2><p>Assuntos pesquisados nos últimos 30 dias. Explore um deles:</p>
<div class="search-topic-links">@foreach(var topic in Model){<a href="/busca?q=@Uri.EscapeDataString(topic.Label)" style="font-size:@(topic.Count>=10?"1.25rem":"1rem")">@topic.Label <span class="visually-hidden">— @topic.Count buscas</span></a>}</div>
</section>}
