@using System.Globalization
@using BelemRestaurantes.Web.Localization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="@(ViewData["MetaDescription"] ?? T["Description"].Value)" />
  <title>@(ViewData["Title"] ?? T["Tagline"].Value) | Belém Restaurantes</title>

  @if (ViewData["OgTitle"] is not null)
  {
      <meta property="og:title" content="@ViewData["OgTitle"]" />
      <meta property="og:description" content="@(ViewData["OgDescription"] ?? T["Description"].Value)" />
      <meta property="og:url" content="@ViewData["OgUrl"]" />
      <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
      @if (ViewData["OgImage"] is not null)
      {
          <meta property="og:image" content="@ViewData["OgImage"]" />
      }
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="@ViewData["OgTitle"]" />
      <meta name="twitter:description" content="@(ViewData["OgDescription"] ?? T["Description"].Value)" />
  }

  <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
  <link rel="stylesheet" asp-append-version="true" href="~/css/design-v3.css" />
  <link rel="stylesheet" asp-append-version="true" href="~/css/design-v4.css" />
  <link rel="stylesheet" asp-append-version="true" href="~/css/cuia-experience-v5.css" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header>
  <a asp-controller="Home" asp-action="Index" class="brand"><span class="mark">✦</span> belém <strong>restaurantes</strong></a>
  <nav aria-label="@T["Explore"]">
    <a href="/#catalogo">@T["Explore"]</a>
    <a href="/cidades">Cidades do Pará</a>
    <a href="/busca">Buscar</a>
    <a href="/community">@T["CommunityFeedTitle"]</a>
    <a href="/roteiros">Roteiros</a>
    <a href="/partner/dashboard">Portal Parceiro</a>
    <a href="/account">@T["MyAccount"]</a>
  </nav>
  <form method="post" action="/language" class="language-picker">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
    <label for="language">@T["Language"]</label>
    <select id="language" name="culture">
      @foreach (var language in SupportedLanguages.All)
      {
        <option value="@language.Code" selected="@(language.Code == CultureInfo.CurrentUICulture.Name)">@language.Name</option>
      }
    </select>
    <button type="submit">@T["Apply"]</button>
  </form>
</header>
<main>@RenderBody()</main>
<footer>
  Belém Restaurantes · @T["Tagline"] · MNSOFT · <a href="mailto:comercial@belemrestaurantes.com.br">@T["Contact"]</a>
  <br /><small>@T["ExternalNotice"]</small>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
