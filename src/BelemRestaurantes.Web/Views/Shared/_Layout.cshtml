@using System.Globalization
@using BelemRestaurantes.Web.Localization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="@(ViewData["MetaDescription"] ?? T["Description"].Value)" />
  <title>@(ViewData["Title"] ?? T["Tagline"].Value) | Belém Restaurantes</title>

  @if (ViewData["OgTitle"] is not null)
  {
      <meta property="og:title" content="@ViewData["OgTitle"]" />
      <meta property="og:description" content="@(ViewData["OgDescription"] ?? T["Description"].Value)" />
      <meta property="og:url" content="@ViewData["OgUrl"]" />
      <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
      @if (ViewData["OgImage"] is not null)
      {
          <meta property="og:image" content="@ViewData["OgImage"]" />
      }
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="@ViewData["OgTitle"]" />
      <meta name="twitter:description" content="@(ViewData["OgDescription"] ?? T["Description"].Value)" />
  }

  <link rel="stylesheet" asp-append-version="true" href="~/css/para.css" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="para-public">
<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<div class="para-ribbon">Feito em Belém. Com o tempero de todo o Pará.</div>
<header class="para-header">
  <a asp-controller="Home" asp-action="Index" class="para-brand">
    <span class="para-brand-mark">@await Html.PartialAsync("_ParaIcon", "cuia")</span>
    <span>belém<span class="para-brand-small">RESTAURANTES</span></span>
  </a>
  <button class="para-menu-toggle" type="button" aria-expanded="false" aria-controls="public-navigation">Menu @await Html.PartialAsync("_ParaIcon", "menu")</button>
  <nav id="public-navigation" class="para-navigation" aria-label="@T["Explore"]">
    <a href="/busca">Onde comer</a><a href="/cidades">Pelo Pará</a><a href="/roteiros">Roteiros</a>
    <a href="/community">Comunidade</a><a href="/receitas">Receitas</a><a href="/selo-cuia">Selo Cuia</a>
    <a href="/account" class="para-account">@T["MyAccount"] ↗</a>
  </nav>
</header>
<main id="main-content" tabindex="-1">@RenderBody()</main>
<footer class="para-footer">
  <div class="para-container para-footer-grid">
    <div><a href="/" class="para-footer-brand">belém restaurantes<span>O Pará tem sabor.</span></a><p>Da feira à mesa, da cidade às ilhas.<br />Uma boa história começa com comida boa.</p></div>
    <div><strong>Vem descobrir</strong><a href="/busca">Restaurantes e sabores</a><a href="/cidades">Cidades do Pará</a><a href="/roteiros">Roteiros gastronômicos</a></div>
    <div><strong>Faça parte</strong><a href="/community">Nossa comunidade</a><a href="/partner/dashboard">Portal do Parceiro</a><a href="mailto:comercial@belemrestaurantes.com.br">@T["Contact"]</a></div>
    <form method="post" action="/language" class="para-language">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
      <label for="language">@T["Language"]</label>
      <select id="language" name="culture">
        @foreach (var language in SupportedLanguages.All)
        { <option value="@language.Code" selected="@(language.Code == CultureInfo.CurrentUICulture.Name)">@language.Name</option> }
      </select><button type="submit">@T["Apply"]</button>
    </form>
  </div>
  <div class="para-container para-footer-bottom"><span>Belém Restaurantes · MNSOFT</span><small>@T["ExternalNotice"]</small></div>
</footer>
<script src="~/js/para.js" asp-append-version="true" defer></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
