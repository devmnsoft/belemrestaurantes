@model BelemRestaurantes.Application.Models.RestaurantView
@{ var categoryLabel=BelemRestaurantes.Web.Models.CatalogCategories.Featured.FirstOrDefault(c=>string.Equals(c.Name,Model.Category,StringComparison.OrdinalIgnoreCase))?.LabelKey; }
@using BelemRestaurantes.Application.Formatting
<article class="para-restaurant">
  <a href="/establishment/@Model.Id" class="para-restaurant-media" tabindex="-1" aria-hidden="true">
  @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl) && (Model.PhotoUrl.StartsWith("/media/", StringComparison.Ordinal) || (Uri.TryCreate(Model.PhotoUrl, UriKind.Absolute, out var photo) && photo.Scheme == "https")))
  { <img src="@Model.PhotoUrl" alt="" loading="lazy" decoding="async" width="640" height="420" /> }
  else
  { @await Html.PartialAsync("_CategoryArtwork",Model.Category ?? "Restaurante") }
  </a>
  @if (Model.DistanceKm is { } distance) { <span class="para-distance">@T["CardDistance",distance.ToString("N1")]</span> }
  <div class="para-restaurant-body"><span class="para-tier @(Model.CatalogTier=="guia"?"is-guide":"is-directory")">@(Model.CatalogTier=="guia"?"Camada Guia":"Ficha cadastral")</span><span class="para-eyebrow">@(categoryLabel is not null?T[categoryLabel].Value:PublicText.Show(Model.Category) ?? "Gastronomia paraense")</span><h3><a href="/establishment/@Model.Id">@(PublicText.Show(Model.Name) ?? Model.Name)</a></h3><p>@Model.City @(!string.IsNullOrWhiteSpace(Model.Neighborhood) ? "· " + PublicText.Show(Model.Neighborhood) : "")</p>@if(!string.IsNullOrWhiteSpace(Model.PhotoAttribution)){<p class="para-photo-credit">Foto: @PublicText.Show(Model.PhotoAttribution)</p>}<div><span>@(PublicText.Show(Model.Address) ?? T["CardAddressPending"].Value)</span><a href="/establishment/@Model.Id" aria-label="@T["CardView",Model.Name]">Ficha</a></div><a class="para-text-link" href="/cuia-rotas?restaurantId=@Model.Id">Como chegar ↗</a>@if(Model.Latitude is not null && Model.Longitude is not null && Model.CoordinatePrecision=="rooftop"){<a class="para-text-link" href="/mapa?city=@Uri.EscapeDataString(Model.City)">Ver no mapa ↗</a>}else{<a class="para-text-link" href="/mapa?city=@Uri.EscapeDataString(Model.City)">Mapa da cidade ↗</a>}</div>
  <button type="button" class="para-save" data-save-kind="catalog" data-save-id="@Model.Id" data-save-name="@Model.Name" data-save-city="@Model.City">Guardar para depois</button>
</article>
