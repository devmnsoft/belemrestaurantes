@model IReadOnlyList<BelemRestaurantes.Domain.Entities.RestaurantMedia>
@{var videos=Model.Where(m=>m.MediaType=="video_embed"&&m.Status=="approved").Select(m=>(Media:m,Video:BelemRestaurantes.Web.Models.RestaurantVideo.From(m.MediaUrl))).Where(v=>v.Video is not null).ToArray();}
<section class="restaurant-videos visit-panel" aria-labelledby="restaurant-videos-title"><span class="para-eyebrow">DA FONTE PARA A SUA TELA</span><h2 id="restaurant-videos-title">Conheça em movimento</h2><p>Vídeos relacionados a este lugar, com fonte e revisão. A reprodução externa só carrega se você escolher assistir.</p>
@if(videos.Length==0){<p>Ainda não há vídeos revisados deste restaurante.</p><a href="/receitas" class="para-text-link">Explore receitas e vídeos da cozinha paraense ↗</a>}
<div class="video-grid">@foreach(var item in videos){<article class="video-card">@if(item.Video!.ThumbnailUrl is {} thumb){<div class="video-player" style="position:relative;"><img src="@thumb" alt="" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;" />@if(item.Video.EmbedUrl is {} embed){<button type="button" data-video-embed="@embed" data-video-title="@item.Media.AttributionText" aria-label="Carregar vídeo: @item.Media.AttributionText" style="position:absolute;inset:0;margin:auto;width:72px;height:72px;border-radius:999px;">▶</button>}</div>}else if(item.Video.EmbedUrl is {} embed){<div class="video-player"><button type="button" data-video-embed="@embed" data-video-title="@item.Media.AttributionText" aria-label="Carregar vídeo do YouTube: @item.Media.AttributionText">Carregar vídeo do YouTube</button></div>}<h3>@item.Media.AttributionText</h3><p>@item.Video.Platform · Conteúdo externo</p>
@if(item.Video.EmbedUrl is {} embed2){<p>Ao carregar, você se conecta ao YouTube. Legendas, quando oferecidas pelo autor, ficam nos controles do vídeo.</p>}
<a href="@item.Video.Url" target="_blank" rel="noopener noreferrer">Assistir na fonte · @item.Video.Platform ↗</a></article>}</div></section>
