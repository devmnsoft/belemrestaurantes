@model BelemRestaurantes.Application.Models.ParaRecipe
<article class="recipe-card"><a class="recipe-card-art recipe-tone-@Model.Tone" href="/receitas/@Model.Slug"><span>@Model.Category</span>@await Html.PartialAsync("_ParaIcon",Model.Icon)<small>ILUSTRAÇÃO EDITORIAL</small><span class="sr-only">Ver @Model.Title</span><b aria-hidden="true">↗</b></a><div class="recipe-card-body"><span class="para-eyebrow">@(Model.Kind=="official"?"RECEITA OFICIAL COM FONTE":"RECEITA INSPIRADA")</span><h3><a href="/receitas/@Model.Slug">@Model.Title</a></h3><p>@Model.Subtitle</p><div><span>@Model.TotalMinutes min</span><span>@Model.Difficulty</span><span>@Model.Servings porções</span></div></div></article>
