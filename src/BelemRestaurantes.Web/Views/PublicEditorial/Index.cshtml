@model IReadOnlyList<BelemRestaurantes.Web.Controllers.EditorialArticle>
@{ViewData["Title"]="Sabores · Revista Cuia";}
<section class="para-container para-section" lang="pt-BR"><span class="para-eyebrow">REVISTA CUIA · MEMÓRIA E SABOR</span><h1 class="para-editorial-title">O Pará contado<br />à mesa.</h1>@if(Model.Count==0){<p class="para-intro">Nossa redação está preparando as primeiras histórias. Enquanto isso, explore os municípios e compartilhe suas experiências.</p><a class="para-button" href="/cidades">Descobrir o Pará</a>}@foreach(var item in Model){<article class="visit-panel"><h2>@item.Title</h2><p style="white-space:pre-wrap">@item.Body</p>@if(!string.IsNullOrWhiteSpace(item.SourceUrl)){<a href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">Fonte e referências ↗</a>}</article>}</section>
