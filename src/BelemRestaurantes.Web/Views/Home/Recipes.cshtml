@{ ViewData["Title"] = "Receitas e memórias do Pará"; }
<section class="para-section para-container">
  <span class="para-eyebrow">CADERNO DE SABORES</span><h1 class="para-editorial-title">Receitas com<br /><em>gosto de casa.</em></h1>
  <p class="para-intro">Ingredientes da nossa terra, encontros à mesa. Um começo para levar o Pará para a sua cozinha.</p>
  <div class="para-restaurant-grid">
    <article class="para-story">@await Html.PartialAsync("_ParaIcon", "leaf")<h2>Farofa de castanha</h2><p class="para-recipe-note">Um acompanhamento crocante para o peixe ou o almoço de domingo.</p><h3>Ingredientes</h3><ul><li>1 xícara de farinha de mandioca</li><li>½ xícara de castanhas-do-pará picadas</li><li>2 colheres de manteiga</li><li>½ cebola picada</li><li>Sal e cheiro-verde a gosto</li></ul><h3>Na cozinha</h3><ol><li>Refogue a cebola na manteiga em fogo baixo.</li><li>Junte as castanhas e mexa até dourarem levemente.</li><li>Acrescente a farinha aos poucos. Mexa até ficar crocante, ajuste o sal e finalize com cheiro-verde.</li></ol></article>
    <article class="para-story">@await Html.PartialAsync("_ParaIcon", "cuia")<h2>Tapioca com queijo</h2><p class="para-recipe-note">Para um café demorado, com queijo do Marajó quando houver.</p><h3>Ingredientes</h3><ul><li>½ xícara de goma de tapioca hidratada, pronta para uso</li><li>Queijo de sua preferência</li><li>Uma pitada de sal</li></ul><h3>Na cozinha</h3><ol><li>Peneire a goma e misture o sal.</li><li>Espalhe uma camada uniforme numa frigideira antiaderente aquecida, em fogo médio.</li><li>Quando a massa se unir, acrescente o queijo, dobre e aqueça até derreter. Sirva na hora.</li></ol></article>
    <article class="para-story">@await Html.PartialAsync("_ParaIcon", "plate")<h2>Creme de cupuaçu</h2><p class="para-recipe-note">O azedinho da fruta em uma sobremesa para compartilhar.</p><h3>Ingredientes</h3><ul><li>200 g de polpa de cupuaçu pasteurizada</li><li>1 caixa de creme de leite (200 g)</li><li>Leite condensado a gosto</li></ul><h3>Na cozinha</h3><ol><li>Descongele a polpa conforme a embalagem.</li><li>Bata com o creme de leite e acrescente o leite condensado aos poucos, provando o equilíbrio do doce.</li><li>Distribua em potes tampados e leve à geladeira até firmar. Mantenha refrigerado.</li></ol></article>
  </div>
  <p class="para-intro">Prefere descobrir esses sabores fora de casa? <a href="/busca">Encontre um restaurante no guia.</a></p>
</section>
