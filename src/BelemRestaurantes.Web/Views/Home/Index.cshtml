<section class="hero">
  <div class="shell">
    <span class="overline">✦ @T["Guide"]</span><h1>@T["HeroTitle"]</h1><p>@T["HeroText"]</p>
    <div class="search">
      <input id="query" type="search" maxlength="100" placeholder="@T["SearchPlaceholder"]" aria-label="@T["Search"]" list="autosuggest" />
      <datalist id="autosuggest"></datalist><button type="button" id="go">@T["Search"]</button>
    </div>
  </div>
</section>
<section class="shell section" id="catalogo">
  <div class="heading">
    <div><span class="overline dark">@T["ExploreState"]</span><h2>@T["WhereToEat"]</h2></div>
    <select id="city" aria-label="@T["City"]">
      <option value="">@T["AllCities"]</option><option>Belém</option><option>Ananindeua</option><option>Marabá</option>
      <option>Salinópolis</option><option>Santarém</option><option>Castanhal</option><option>Paragominas</option>
    </select>
  </div>
  <p class="muted" id="status" aria-live="polite">@T["Loading"]</p><div class="cards" id="cards"></div>
</section>
<section class="stripe" id="mobilidade">
  <div class="shell split">
    <div><span class="overline dark">@T["Mobility"]</span><h2>@T["RouteTitle"]</h2><p>@T["RouteIntro"]</p></div>
    <div class="panel">
      <label for="start">@T["Start"]</label><input id="start" placeholder="@T["StartPlaceholder"]" maxlength="200" />
      <label for="destination">@T["Destination"]</label><select id="destination"><option value="">@T["ChooseRestaurant"]</option></select>
      <button type="button" id="route">@T["BusRoute"]</button><small>@T["RouteNotice"]</small>
    </div>
  </div>
</section>
<section class="shell section split" id="indicacao">
  <div><span class="overline dark">@T["Join"]</span><h2>@T["SuggestTitle"]</h2><p>@T["SuggestIntro"]</p></div>
  <form id="suggestForm" class="panel">
    @Html.AntiForgeryToken()
    <label>@T["RestaurantName"]<input name="Name" required maxlength="160" minlength="2" /></label>
    <label>@T["City"]<input name="City" required maxlength="100" /></label>
    <label>@T["OptionalWebsite"]<input name="Website" type="url" maxlength="350" /></label>
    <label>@T["Notes"]<input name="Notes" maxlength="500" /></label>
    <button type="submit">@T["SendSuggestion"]</button><p id="suggestStatus" class="muted" role="status"></p>
  </form>
</section>
<section class="stripe">
  <div class="shell split">
    <div><h2>@T["SupportTitle"]</h2><p>@T["SupportIntro"]</p></div>
    <div class="panel"><b>PIX MNSOFT · CNPJ</b><p id="pix">18.160.057/0001-13</p><button type="button" id="copyPix">@T["CopyPix"]</button><small>@T["PixNotice"]</small></div>
  </div>
</section>
<div id="client-text" hidden data-loading="@T["CatalogLoading"]" data-unavailable="@T["CatalogUnavailable"]"
     data-results="@T["Results"]" data-choose="@T["ChooseRestaurant"]" data-photo="@T["AuthorizedPhoto"]"
     data-no-photo="@T["NoPhoto"]" data-address="@T["AddressChecking"]" data-website="@T["Website"]"
     data-pix-copied="@T["PixCopied"]" data-sending="@T["Sending"]" data-received="@T["SuggestionReceived"]" data-send-failed="@T["SendFailed"]"></div>
