@model BelemRestaurantes.Web.Models.HomeViewModel
@{
    ViewData["Title"] = T["AtlasTitle"].Value;
    ViewData["AtlasEditorial"] = true;
    ViewData["MetaDescription"] = T["AtlasMeta"].Value;
}
<link rel="preload" as="image" href="~/images/para-atlas-editorial-v1.webp" fetchpriority="high" />
<section class="atlas-hero">
  <div class="para-container atlas-hero-grid">
    <div class="atlas-hero-copy"><span class="para-eyebrow">@T["AtlasEyebrow"]</span><h1>@T["AtlasHeadline"]<br /><em>@T["AtlasHeadlineAccent"]</em></h1><p>@T["AtlasIntro"]</p><div class="atlas-hero-actions"><a class="para-button" href="#catalogo">@T["AtlasExplore"] <span aria-hidden="true">↗</span></a><a class="para-text-link" href="/cidades">@T["AtlasChooseDestination"] ↗</a></div><div class="atlas-hero-note"><span aria-hidden="true">01 / 144</span><span>@T["AtlasOfficialTerritory"]</span></div></div>
    <figure class="atlas-hero-art"><img src="~/images/para-atlas-editorial-v1.webp" width="1536" height="1024" fetchpriority="high" alt="@T["AtlasArtAlt"]" /><figcaption>@T["AtlasIllustration"]</figcaption><span class="atlas-art-seal" aria-hidden="true">PARÁ<br /><em>à mesa</em><span>AMAZÔNIA · BRASIL</span></span></figure>
  </div>
  <div class="para-container atlas-search-container">
    <form action="/busca" method="get" class="para-search" role="search">
      <div class="para-search-query"><label for="heroQuery">@T["AtlasSearchLabel"]</label><input id="heroQuery" name="q" type="search" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" placeholder="@T["AtlasSearchPlaceholder"]" autocomplete="off" aria-controls="heroAutocomplete" aria-expanded="false" aria-describedby="search-status" /><div id="heroAutocomplete" class="para-autocomplete" role="listbox" aria-label="@T["AtlasSuggestions"]" hidden></div></div>
      <div><label for="heroCity">@T["AtlasDestinationLabel"]</label><select id="heroCity" name="city"><option value="">@T["AtlasAllPara"]</option>@foreach(var city in Model.Cities){<option value="@city">@city</option>}</select></div>
      <button type="submit" class="para-button" id="go">@T["Search"]</button>
    </form><p id="search-status" class="para-search-status" role="status" aria-live="polite"></p>
    <div class="para-popular"><span>@T["AtlasCraving"]</span><a href="/pratos/tacaca">Tacacá</a><a href="/pratos/acai">Açaí</a><a href="/pratos/peixe">Peixe</a><a href="/ocasioes/ilha">Ilhas</a><a href="/busca?category=Pizzaria">@T["Category_pizza"]</a></div>
  </div>
</section>
<div class="atlas-flavour-line" aria-hidden="true"><span>TUCUPI</span><i>✦</i><span>JAMBU</span><i>✦</i><span>AÇAÍ</span><i>✦</i><span>FARINHA D’ÁGUA</span><i>✦</i><span>CUPUAÇU</span><i>✦</i><span>ENCONTROS</span></div>
<section class="para-section para-container" aria-labelledby="sabores-title">
  <div class="para-section-heading"><div><span class="para-eyebrow">@T["AtlasCategoriesEyebrow"]</span><h2 id="sabores-title">@T["AtlasCategoriesTitle"]</h2></div><a href="/busca" class="para-text-link">@T["AtlasSeeAll"] ↗</a></div>
  <div class="para-categories para-categories-expanded">@foreach(var item in BelemRestaurantes.Web.Models.CatalogCategories.Featured){<a href="/busca?category=@Uri.EscapeDataString(item.Name)"><span class="para-category-icon para-@item.Tone">@await Html.PartialAsync("_ParaIcon",item.Icon)</span><strong>@T[item.LabelKey]</strong><span>@T[item.DescriptionKey]</span><b aria-hidden="true">↗</b></a>}</div>
</section>
<section class="atlas-manifesto"><div class="para-container atlas-manifesto-grid"><div><span class="para-eyebrow">@T["AtlasManifestoEyebrow"]</span><h2>@T["AtlasManifestoTitle"]<br /><em>@T["AtlasManifestoAccent"]</em></h2></div><div><p>@T["AtlasManifestoText"]</p><a href="/guia" class="para-text-link">@T["AtlasGuideLink"] ↗</a></div><div class="atlas-manifesto-mark" aria-hidden="true">@await Html.PartialAsync("_ParaIcon","cuia")</div></div></section>

<section class="para-container para-section" aria-labelledby="cuia-ai-home-title">
  <div class="cuia-ai-card" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:28px;align-items:center;">
    <div>
      <span class="cuia-ai-badge">@await Html.PartialAsync("_ParaIcon", "cuia") INTELIGÊNCIA ARTIFICIAL DA AMAZÔNIA</span>
      <h2 id="cuia-ai-home-title" style="font-family:var(--para-serif);font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.15;color:var(--color-text-primary);margin:12px 0 16px;">
        Em dúvida sobre onde ir ou o que pedir? Pergunte à <em>Cuia IA</em>.
      </h2>
      <p style="font-size:1.05rem;line-height:1.6;color:var(--color-text-secondary);margin-bottom:20px;">
        Seu concierge gastronômico com conhecimento profundo da cultura paraense. Recomendações sob medida para o seu momento, harmonizações e segredos dos 144 municípios.
      </p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <a href="/cuia-ia" class="para-button" style="background:#efb645;color:#0d281e;font-weight:800;">Consultar Cuia IA agora ✨</a>
        <a href="/cuia-ia?q=Onde+tomar+tacac%C3%A1" class="para-text-link" style="color:var(--color-link);">Onde tomar tacacá? →</a>
      </div>
    </div>
    <div class="cuia-ai-questions">
      <strong>💡 Perguntas em alta na Cuia IA:</strong>
      <a href="/cuia-ia?q=Melhor+peixe+com+a%C3%A7a%C3%AD+no+Combu" class="cuia-ai-chip" style="text-decoration:none;">🛶 Almoço ribeirinho no Combu</a>
      <a href="/cuia-ia?q=Jantar+rom%C3%A2ntico+na+Esta%C3%A7%C3%A3o+das+Docas" class="cuia-ai-chip" style="text-decoration:none;">⚓ Jantar com vista para o rio</a>
      <a href="/cuia-ia?q=Como+fazer+mani%C3%A7oba+em+casa" class="cuia-ai-chip" style="text-decoration:none;">🥘 Segredos da maniçoba de 7 dias</a>
    </div>
  </div>
</section>
@await Html.PartialAsync("_AtlasExplorer",Model)
<section class="para-section para-container" aria-labelledby="destinations-title">
  <div class="para-section-heading"><div><span class="para-eyebrow">@T["AtlasDestinationsEyebrow"]</span><h2 id="destinations-title">@T["AtlasDestinationsTitle"]</h2><p>@T["AtlasDestinationsText"]</p></div><a href="/cidades" class="para-text-link">@T["Atlas144Cities"] ↗</a></div>
  <div class="atlas-destinations">@foreach(var destination in BelemRestaurantes.Web.Models.ParaDestinations.Featured){<a class="atlas-destination atlas-tone-@destination.Tone" href="/busca?city=@Uri.EscapeDataString(destination.City)"><div class="atlas-destination-top"><span>@T[destination.RegionKey]</span>@await Html.PartialAsync("_ParaIcon",destination.Icon)</div><div><h3>@destination.City</h3><p>@T[destination.DescriptionKey]</p></div><span class="atlas-destination-arrow" aria-hidden="true">↗</span></a>}</div>
</section>
<section id="catalogo" class="para-section atlas-catalog"><div class="para-container">
  <div class="para-section-heading"><div><span class="para-eyebrow">@T["AtlasCatalogEyebrow"]</span><h2>@T["AtlasCatalogTitle"]</h2><p>@T["AtlasCatalogText"]</p></div><a href="/mapa" class="para-text-link" lang="pt-BR">Mapa dos publicados ↗</a><a href="/busca?sort=recent" class="para-text-link">@T["AtlasExplore"] ↗</a></div>
  @if(Model.FeaturedRestaurants.Count>0){<div class="para-restaurant-grid">@foreach(var restaurant in Model.FeaturedRestaurants){@await Html.PartialAsync("_RestaurantCard",restaurant)}</div>}
  else{<div class="atlas-catalog-empty"><span class="para-category-icon para-gold">@await Html.PartialAsync("_ParaIcon","cuia")</span><div><h3>@T["AtlasEmptyTitle"]</h3><p>@T["AtlasEmptyText"]</p><p lang="pt-BR">A camada Guia continua vazia até uma promoção com dono, horário, cardápio ou foto licenciada. Explore as fichas públicas abaixo ou use a busca; os publicados com coordenada também estão no mapa.</p><a href="/mapa" class="para-text-link" lang="pt-BR">Abrir o mapa ↗</a><a href="/sugerir" class="para-text-link">@T["Suggest"] ↗</a></div><a href="/guia" class="para-button">@T["AtlasGuideLink"]</a></div>}
</div></section>
@if(Model.DirectoryRestaurants.Count>0)
{
<section class="para-section para-container" aria-labelledby="public-directory-title" lang="pt-BR">
  <div class="para-section-heading"><div><span class="para-eyebrow">DESCUBRA O CATÁLOGO PÚBLICO</span><h2 id="public-directory-title">@Model.DirectoryCount fichas para explorar</h2><p>Cadastros publicados com dados de suas fontes. Ficha cadastral não é recomendação verificada: confirme funcionamento e serviços antes de visitar.</p></div><a class="para-text-link" href="/busca?tier=ficha">Ver todas as fichas ↗</a></div>
  <div class="para-restaurant-grid">@foreach(var restaurant in Model.DirectoryRestaurants){@await Html.PartialAsync("_RestaurantCard",restaurant)}</div>
</section>
}
@if(Model.CuiaHighlights.Count>0)
{<section class="para-section para-container"><div class="para-section-heading"><h2>@T["CuiaBadge"]</h2><a href="/selo-cuia" class="para-text-link">@T["CuiaMethodology"] ↗</a></div><div class="para-restaurant-grid">@foreach(var item in Model.CuiaHighlights){<article class="para-story"><span class="para-eyebrow">Selo Cuia · @item.Score.ToString("F1")</span><h3><a href="/establishment/@item.RestaurantId">@item.RestaurantName</a></h3><p>@item.RestaurantCity</p></article>}</div></section>}
<section class="para-section para-container atlas-community"><div><span class="para-eyebrow">@T["AtlasCommunityEyebrow"]</span><h2>@T["AtlasCommunityTitle"]</h2><p>@T["AtlasCommunityText"]</p><div class="atlas-hero-actions"><a class="para-button" href="/community">@T["NavCommunity"] ↗</a><a class="para-text-link" href="/account/favorites">@T["AtlasFavorites"] ↗</a></div></div><div class="atlas-community-card">@await Html.PartialAsync("_ParaIcon","market")<span class="para-eyebrow">@T["AtlasLocalTip"]</span><h3>@T["AtlasLocalTipTitle"]</h3><p>@T["AtlasLocalTipText"]</p><a href="/sugerir" class="para-text-link">@T["Suggest"] ↗</a></div></section>
@if(Model.RecentExperiences.Count>0)
{<section class="para-section para-container"><div class="para-section-heading"><h2>@T["CommunityFeedTitle"]</h2><a href="/community" class="para-text-link">@T["NavCommunity"] ↗</a></div><div class="para-restaurant-grid">@foreach(var item in Model.RecentExperiences.Take(3)){<article class="para-story"><p>@(item.ReviewText?.Length>170?item.ReviewText[..170]+"…":item.ReviewText)</p><strong>@item.AuthorName</strong><a href="/experience/@item.Id" class="para-text-link">@T["NavCommunity"] ↗</a></article>}</div></section>}
<section class="para-container visit-river"><div><span class="para-eyebrow">CUIA MOBILIDADE 360</span><h2>@T["VisitHomeTitle"]</h2><p>@T["VisitHomeText"]</p></div><div><a class="para-button" href="/cuia-rotas">@T["VisitHomeAction"] →</a><a href="/travessias">Travessias com fonte vigente ↗</a><a href="/qual-onibus">@T["VisitBusAction"] ↗</a></div></section>
<section class="para-container para-section"><div class="recipe-home"><div><span class="para-eyebrow">@T["RecipesHomeEyebrow"]</span><h2>@T["RecipesHomeTitle"]</h2><p>@T["RecipesHomeText"]</p><a href="/receitas" class="para-button">@T["RecipesHomeAction"] ↗</a></div><div aria-hidden="true">@await Html.PartialAsync("_ParaIcon","cuia")<span>DAQUI.<br /><em>À SUA MESA.</em></span></div></div></section>
<section class="para-container para-section" lang="pt-BR" aria-labelledby="home-video-title"><div class="home-video-feature"><div><span class="para-eyebrow">COZINHA PARAENSE · EM VÍDEO</span><h2 id="home-video-title">O sabor também conta histórias.</h2><p>Conheça o preparo do tacacá no programa É do Pará, da TV Liberal. Uma referência para descobrir os ingredientes e a cultura da nossa mesa.</p><a class="para-button" href="https://globoplay.globo.com/v/12465126/" target="_blank" rel="noopener noreferrer">Assistir no Globoplay ↗</a><a class="para-text-link" href="/receitas/tacaca-em-casa">Ler nossa adaptação para fazer em casa →</a><p class="small">Conteúdo externo. A reprodução e os recursos de acessibilidade dependem da plataforma e do autor.</p></div><div class="home-video-mark" aria-hidden="true">@await Html.PartialAsync("_ParaIcon","cuia")<span>DA CUIA.<br/>PARA A TELA.</span></div></div></section>
<section class="atlas-trust"><div class="para-container atlas-trust-grid"><article><span>01</span><h3>@T["AtlasTrustSource"]</h3><p>@T["AtlasTrustSourceText"]</p></article><article><span>02</span><h3>@T["AtlasTrustReview"]</h3><p>@T["AtlasTrustReviewText"]</p></article><article><span>03</span><h3>@T["AtlasTrustCommunity"]</h3><p>@T["AtlasTrustCommunityText"]</p></article></div></section>
<section class="para-section para-container"><div class="atlas-partner"><div><span class="para-eyebrow">@T["AtlasPartnerEyebrow"]</span><h2>@T["AtlasPartnerTitle"]</h2><p>@T["AtlasPartnerText"]</p><a href="/partner/dashboard" class="para-button">@T["AtlasPartnerButton"] ↗</a></div><span class="atlas-partner-mark" aria-hidden="true">DAQUI.<br /><em>PARA O<br />MUNDO.</em></span></div></section>
<div id="client-text" hidden data-loading="@T["CatalogLoading"]" data-unavailable="@T["CatalogUnavailable"]" data-autocomplete-loading="@T["AtlasAutocompleteLoading"]" data-autocomplete-count="@T["AtlasAutocompleteCount"]" data-autocomplete-empty="@T["AtlasAutocompleteEmpty"]" data-autocomplete-error="@T["AtlasAutocompleteError"]"></div>
