@model BelemRestaurantes.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Belém Restaurantes — O Pará tem sabor";
    ViewData["MetaDescription"] = "Guia gastronômico completo do Pará: descubra os melhores restaurantes, açaí tradicional, tacacá, cardápios digitais e experiências reais da comunidade.";
}

<!-- 1. Hero Gastronômico com Busca em Destaque V5 -->
<section class="cuia-hero">
  <div class="cuia-container">
    <span class="cuia-hero-badge">
      ✦ O Pará tem sabor · Guia Gastronômico
    </span>
    
    <h1 class="cuia-hero-title">
      Descubra onde comer o melhor da culinária <em>paraense</em>.
    </h1>
    
    <p class="cuia-hero-subtitle">
      Do tacacá na cuia ao açaí com peixe frito, encontre pratos autênticos, cardápios digitais com preços reais e recomendações da comunidade.
    </p>

    <!-- Barra de Busca Inteligente com Autocomplete V5 -->
    <div class="cuia-search-box">
      <form action="/busca" method="get" id="homeSearchForm" style="display: flex; width: 100%; gap: 10px; position: relative; flex-wrap: wrap;">
        <input id="heroQuery" name="q" type="search" placeholder="Buscar restaurante, prato (ex: Filhote, Tacacá, Açaí) ou bairro..." autocomplete="off" aria-label="Buscar restaurantes e pratos" style="flex: 2; min-width: 220px;" />
        
        <select name="city" aria-label="Filtrar por cidade" style="flex: 1; min-width: 140px;">
          <option value="">Todo o Pará</option>
          @foreach (var city in Model.Cities)
          {
            <option value="@city">@city</option>
          }
        </select>

        <button type="submit" class="cuia-btn cuia-btn-primary" id="go">@T["Search"]</button>

        <!-- Dropdown de Autocomplete -->
        <div id="heroAutocomplete" class="cuia-autocomplete-dropdown" role="listbox"></div>
      </form>
    </div>

    <!-- Chips Rápidos Populares -->
    <div style="display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; align-items: center;">
      <span style="font-size: 13px; color: var(--floresta-300, #a2c4b5); font-weight: 700;">Populares:</span>
      <a href="/busca?q=Tacac%C3%A1" class="cuia-chip">Tacacá</a>
      <a href="/busca?q=A%C3%A7a%C3%AD" class="cuia-chip">Açaí</a>
      <a href="/busca?q=Filhote" class="cuia-chip">Peixe Filhote</a>
      <a href="/busca?q=Mani%C3%A7oba" class="cuia-chip">Maniçoba</a>
    </div>
  </div>
</section>

<!-- 2. Categorias Gastronômicas Populares -->
<section class="cuia-section" style="background: #ffffff; border-bottom: 1px solid var(--borda-suave, #e2e8df);">
  <div class="cuia-container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
      <div>
        <span class="cuia-tag cuia-tag-floresta">Categorias em Destaque</span>
        <h2 class="cuia-section-title" style="margin-top: 8px;">O que você quer saborear hoje?</h2>
      </div>
      <a href="/busca" class="cuia-btn cuia-btn-outline cuia-btn-sm">Ver todas as categorias →</a>
    </div>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="/busca?category=Restaurante" class="cuia-chip">Restaurantes</a>
      <a href="/busca?q=A%C3%A7a%C3%AD" class="cuia-chip">Açaí & Tapioca</a>
      <a href="/busca?q=Tacac%C3%A1" class="cuia-chip">Tacacá & Tucupi</a>
      <a href="/busca?category=Pizzaria" class="cuia-chip">Pizzarias</a>
      <a href="/busca?category=Lanchonete" class="cuia-chip">Lanches & Hambúrgueres</a>
      <a href="/busca?category=Cafeteria" class="cuia-chip">Cafés & Bistrôs</a>
      <a href="/busca?category=Sorveteria" class="cuia-chip">Sorvetes Regionais</a>
      <a href="/busca?q=Peixe" class="cuia-chip">Peixarias & Frutos do Mar</a>
    </div>
  </div>
</section>

<!-- 3. Descubra Perto de Você (Geolocalização Consentida) -->
<section class="cuia-section" id="perto-de-voce" style="background: var(--palha-100, #f7f4eb);">
  <div class="cuia-container">
    <div class="cuia-card" style="padding: 32px;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
          <span class="cuia-tag cuia-tag-floresta">Localização em Tempo Real</span>
          <h2 class="cuia-section-title" style="margin: 8px 0 4px; font-size: 22px;">Descubra restaurantes perto de você</h2>
          <p class="cuia-section-subtitle" style="font-size: 14px; margin: 0;">
            Permita o acesso à localização do seu dispositivo para encontrar opções abertas no seu bairro neste momento.
          </p>
        </div>
        <button type="button" class="cuia-btn cuia-btn-secondary" id="btnGeolocalizacao">
          Ativar Minha Localização
        </button>
      </div>
      <div id="geoStatus" style="margin-top: 14px; font-size: 14px; color: var(--texto-secundario, #4b635a); display: none;"></div>
    </div>
  </div>
</section>

<!-- 4. Selo Cuia: Classificação Gastronômica Bayesiana -->
@if (Model.CuiaHighlights.Count > 0)
{
  <section class="cuia-section" style="background: #ffffff; border-top: 1px solid var(--borda-suave, #e2e8df); border-bottom: 1px solid var(--borda-suave, #e2e8df);">
    <div class="cuia-container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px; flex-wrap: wrap; gap: 12px;">
        <div>
          <span class="cuia-tag cuia-tag-tucupi">Reconhecimento Gastronômico</span>
          <h2 class="cuia-section-title" style="margin-top: 8px;">Melhores Avaliados pelo Selo Cuia</h2>
          <p class="cuia-section-subtitle">Classificação bayesiana transparente avaliando sabor, atendimento, ambiente e custo-benefício.</p>
        </div>
        <a href="/admin/cuia" class="cuia-btn cuia-btn-outline cuia-btn-sm">Conhecer a Metodologia →</a>
      </div>

      <div class="cuia-grid-cards">
        @foreach (var item in Model.CuiaHighlights)
        {
          <article class="cuia-establishment-card">
            <div class="cuia-establishment-media">
              <div style="height: 100%; display: grid; place-items: center; background: linear-gradient(135deg, #113F32, #1b5e4b); color: #e8ad46; font-size: 32px;">
                ✦
              </div>
              <div class="cuia-card-badge-top">
                <span class="cuia-tag cuia-tag-tucupi">Selo Cuia @item.Score.ToString("F1")</span>
                <span class="cuia-tag cuia-tag-floresta">#@item.RankPosition</span>
              </div>
            </div>
            <div class="cuia-establishment-content">
              <div>
                <h3 class="cuia-establishment-name">
                  <a href="/estabelecimento/@item.RestaurantId" class="cuia-establishment-link">@item.RestaurantName</a>
                </h3>
                <div class="cuia-establishment-meta">
                  <span>@item.RestaurantCity</span>
                  <span>• @item.ApprovedReviewsCount avaliações</span>
                </div>
              </div>
              <div class="cuia-establishment-actions">
                <a href="/cardapio/@item.RestaurantId" class="cuia-btn cuia-btn-primary cuia-btn-sm">Cardápio</a>
                <a href="/estabelecimento/@item.RestaurantId" class="cuia-btn cuia-btn-outline cuia-btn-sm">Ver Perfil</a>
              </div>
            </div>
          </article>
        }
      </div>
    </div>
  </section>
}

<!-- 5. Sabores da Comunidade (Avaliações Públicas e Fotos Reais) -->
@if (Model.RecentExperiences.Count > 0)
{
  <section class="cuia-section" style="background: var(--palha-100, #f7f4eb);">
    <div class="cuia-container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px; flex-wrap: wrap; gap: 12px;">
        <div>
          <span class="cuia-tag cuia-tag-floresta">Voz dos Visitantes</span>
          <h2 class="cuia-section-title" style="margin-top: 8px;">Sabores da Comunidade</h2>
          <p class="cuia-section-subtitle">Relatos espontâneos, fotos reais e experiências gastronômicas compartilhadas.</p>
        </div>
        <a href="/community" class="cuia-btn cuia-btn-outline cuia-btn-sm">Ver Feed da Comunidade →</a>
      </div>

      <div class="cuia-grid-cards">
        @foreach (var exp in Model.RecentExperiences)
        {
          <div class="cuia-card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <div class="cuia-rating">
                  @for (int i = 1; i <= 5; i++)
                  {
                    <span style="color: @(i <= exp.Stars ? "#e8ad46" : "#dce7dc");">★</span>
                  }
                </div>
                <span style="font-size: 12px; color: var(--texto-secundario, #4b635a);">@exp.CreatedAt.ToString("dd/MM/yyyy")</span>
              </div>

              @if (!string.IsNullOrEmpty(exp.DishesConsumed))
              {
                <div style="font-size: 13px; font-weight: 700; color: var(--floresta-900, #113F32); margin-bottom: 6px;">
                  Prato: @exp.DishesConsumed
                </div>
              }

              <p style="font-size: 14px; color: var(--texto-principal, #17342d); margin: 0 0 14px; line-height: 1.5;">
                "@(exp.ReviewText?.Length > 140 ? exp.ReviewText[..140] + "..." : exp.ReviewText)"
              </p>
            </div>

            <div style="padding-top: 12px; border-top: 1px solid var(--borda-suave, #e2e8df); display: flex; justify-content: space-between; align-items: center; font-size: 13px;">
              <span style="color: var(--texto-secundario, #4b635a); font-weight: 600;">Por @exp.AuthorName</span>
              <a href="/experience/@exp.Id" style="color: var(--floresta-900, #113F32); font-weight: 700; text-decoration: none;">Ler relato →</a>
            </div>
          </div>
        }
      </div>
    </div>
  </section>
}

<!-- 6. Sabores do Pará: Cultura e Tradições Gastronômicas -->
<section class="cuia-section" style="background: #ffffff; border-top: 1px solid var(--borda-suave, #e2e8df); border-bottom: 1px solid var(--borda-suave, #e2e8df);">
  <div class="cuia-container">
    <div style="text-align: center; max-width: 700px; margin: auto; margin-bottom: 40px;">
      <span class="cuia-tag cuia-tag-urucum">Herança Ancestral</span>
      <h2 class="cuia-section-title" style="margin-top: 8px;">Sabores que só o Pará tem</h2>
      <p class="cuia-section-subtitle" style="margin: auto;">
        A culinária paraense é uma celebração viva da floresta, dos rios e das tradições indígenas amazônicas.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      <div class="cuia-card">
        <div style="font-size: 28px; margin-bottom: 10px; color: var(--tucupi-600, #c48b28);">✦</div>
        <h3 style="color: var(--floresta-900, #113F32); font-weight: 800; font-size: 18px; margin-bottom: 8px;">O Ritual do Tacacá</h3>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 14px; line-height: 1.6; margin: 0;">
          Servido fervendo nas tradicionais cuias, o tucupi temperado com jambu amortece a boca enquanto o camarão seco traz crocância e sabor marcante ao fim de tarde.
        </p>
      </div>

      <div class="cuia-card">
        <div style="font-size: 28px; margin-bottom: 10px; color: var(--floresta-700, #165338);">✦</div>
        <h3 style="color: var(--floresta-900, #113F32); font-weight: 800; font-size: 18px; margin-bottom: 8px;">Açaí Puro com Peixe</h3>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 14px; line-height: 1.6; margin: 0;">
          O verdadeiro açaí paraense é espesso, consumido como refeição principal salgada, acompanhado de peixe frito crocante e farinha d'água de Bragança.
        </p>
      </div>

      <div class="cuia-card">
        <div style="font-size: 28px; margin-bottom: 10px; color: var(--urucum-600, #b7513c);">✦</div>
        <h3 style="color: var(--floresta-900, #113F32); font-weight: 800; font-size: 18px; margin-bottom: 8px;">A Sagrada Maniçoba</h3>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 14px; line-height: 1.6; margin: 0;">
          Feita com folhas de maniva moídas e cozidas pacientemente por sete dias para neutralizar o ácido cianídrico, cozida com carnes nobres de porco e charque.
        </p>
      </div>

      <div class="cuia-card">
        <div style="font-size: 28px; margin-bottom: 10px; color: var(--tucupi-500, #e8ad46);">✦</div>
        <h3 style="color: var(--floresta-900, #113F32); font-weight: 800; font-size: 18px; margin-bottom: 8px;">Filhote & Peixes Amazônicos</h3>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 14px; line-height: 1.6; margin: 0;">
          O nobre filhote, a pescada amarela e o pirarucu com carnes brancas e suculentas, grelhados na brasa ou servidos em caldeiradas perfumadas com chicória do Pará.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 7. Explore o Território do Pará (144 Municípios) -->
<section class="cuia-section" style="background: var(--palha-100, #f7f4eb);">
  <div class="cuia-container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
      <div>
        <span class="cuia-tag cuia-tag-floresta">Turismo & Território</span>
        <h2 class="cuia-section-title" style="margin-top: 8px;">Gastronomia em Todo o Pará</h2>
        <p class="cuia-section-subtitle">Navegue pelas cidades com estabelecimentos e roteiros mapeados.</p>
      </div>
      <a href="/roteiros" class="cuia-btn cuia-btn-outline cuia-btn-sm">Ver Roteiros Turísticos →</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;">
      @foreach (var city in Model.Cities)
      {
        <a href="/busca?city=@Uri.EscapeDataString(city)" class="cuia-card" style="text-align: center; text-decoration: none; color: var(--floresta-900, #113F32); font-weight: 700; padding: 16px;">
          <div style="font-size: 13px; color: var(--tucupi-600, #c48b28); margin-bottom: 4px;">Polo Gastronômico</div>
          @city
        </a>
      }
    </div>
  </div>
</section>

<!-- 8. Mobilidade e Como Chegar -->
<section class="cuia-section" id="mobilidade" style="background: #ffffff; border-top: 1px solid var(--borda-suave, #e2e8df);">
  <div class="cuia-container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
      <div>
        <span class="cuia-tag cuia-tag-floresta">Mobilidade Urbana</span>
        <h2 class="cuia-section-title" style="margin-top: 8px;">Como chegar aos restaurantes</h2>
        <p class="cuia-section-subtitle" style="margin-bottom: 20px;">
          Planeje seu trajeto com linhas de ônibus metropolitanas, itinerários integrados, paradas próximas e mapas de navegação rápida.
        </p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/roteiros" class="cuia-btn cuia-btn-secondary">
            Ver Linhas & Roteiros
          </a>
          <a href="/busca" class="cuia-btn cuia-btn-outline">
            Escolher Destino
          </a>
        </div>
      </div>
      <div class="cuia-card" style="padding: 28px;">
        <h3 style="color: var(--floresta-900, #113F32); font-weight: 800; font-size: 18px; margin-bottom: 12px;">Dicas de Transporte em Belém</h3>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 14px; margin-bottom: 10px;">
          • Principais corredores: Av. Presidente Vargas, Almirante Barroso e Av. Visconde de Souza Franco (Doca).
        </p>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 14px; margin-bottom: 10px;">
          • Travessias fluviais: Barcos partem regularmente do Terminal da Praça Princesa Isabel rumo à Ilha do Combu.
        </p>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 14px; margin: 0;">
          • Tarifas e itinerários atualizados no portal oficial de mobilidade.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 9. Portal do Restaurante Parceiro (Convite Comerciante) -->
<section class="cuia-section" style="background: linear-gradient(135deg, var(--floresta-950, #0a251e), var(--floresta-900, #113F32)); color: #ffffff;">
  <div class="cuia-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; align-items: center;">
    <div>
      <span class="cuia-tag cuia-tag-tucupi">
        Espaço do Comerciante
      </span>
      <h2 style="color: #ffffff; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; margin: 12px 0;">
        É proprietário de um restaurante?
      </h2>
      <p style="color: var(--floresta-200, #c9dbd1); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
        Reivindique seu cadastro no Belém Restaurantes, publique seu cardápio digital com QR Code para as mesas, atualize horários de funcionamento e responda às avaliações dos clientes.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/partner/dashboard" class="cuia-btn cuia-btn-primary cuia-btn-lg">
          Acessar Portal do Parceiro →
        </a>
        <a href="/#catalogo" class="cuia-btn cuia-btn-outline" style="border-color: rgba(255,255,255,0.4); color: #ffffff;">
          Reivindicar meu restaurante
        </a>
      </div>
    </div>
    <div class="cuia-card" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15); padding: 30px;">
      <h3 style="color: var(--tucupi-400, #f3be5d); font-weight: 800; font-size: 18px; margin-bottom: 14px;">Vantagens para Parceiros</h3>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; color: var(--floresta-100, #e6f0eb); font-size: 14.5px;">
        <li>✓ Cardápio Digital Inteligente com Cuia IA</li>
        <li>✓ QR Code pronto para impressão nas mesas</li>
        <li>✓ Canal direto para pedidos no WhatsApp</li>
        <li>✓ Resposta oficial às avaliações da comunidade</li>
        <li>✓ Grade de horários e feriados regionais</li>
      </ul>
    </div>
  </div>
</section>

<!-- 10. Apoie o Projeto & Chave PIX MNSOFT -->
<section class="cuia-section" style="background: #ffffff; border-top: 1px solid var(--borda-suave, #e2e8df);">
  <div class="cuia-container">
    <div class="cuia-card" style="background: var(--palha-100, #f7f4eb); padding: clamp(24px, 5vw, 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px; align-items: center;">
      <div>
        <span class="cuia-tag cuia-tag-floresta">Comunidade & Sustentabilidade</span>
        <h2 class="cuia-section-title" style="margin-top: 8px; font-size: 24px;">Apoie a Gastronomia Paraense</h2>
        <p class="cuia-section-subtitle" style="margin-bottom: 14px;">
          O Belém Restaurantes é uma iniciativa independente da MNSOFT para valorizar os sabores amazônicos, os pequenos comerciantes e a cultura paraense.
        </p>
        <p style="font-size: 13px; color: var(--texto-secundario, #4b635a); margin: 0;">
          Chave PIX Oficial (CNPJ): <strong>18.160.057/0001-13</strong>
        </p>
      </div>
      <div class="cuia-card" style="background: #ffffff; text-align: center; padding: 24px;">
        <span style="font-size: 12px; font-weight: 700; color: var(--texto-secundario, #4b635a); text-transform: uppercase; letter-spacing: 1px;">Chave PIX MNSOFT</span>
        <div style="font-size: 20px; font-weight: 800; color: var(--floresta-900, #113F32); margin: 8px 0; letter-spacing: 1px;" id="pixKey">
          18.160.057/0001-13
        </div>
        <button type="button" class="cuia-btn cuia-btn-secondary" style="width: 100%;" id="btnCopyPix" onclick="navigator.clipboard.writeText('18160057000113'); alert('Chave PIX copiada com sucesso!');">
          Copiar Chave PIX CNPJ
        </button>
      </div>
    </div>
  </div>
</section>

<script>
// Autocomplete com Debounce no Backend
(function() {
  const input = document.getElementById('heroQuery');
  const dropdown = document.getElementById('heroAutocomplete');
  let timeout;

  if (input && dropdown) {
    input.addEventListener('input', function() {
      clearTimeout(timeout);
      const query = input.value.trim();
      if (query.length < 2) {
        dropdown.classList.remove('show');
        dropdown.innerHTML = '';
        return;
      }

      timeout = setTimeout(async function() {
        try {
          const res = await fetch('/api/search/autocomplete?q=' + encodeURIComponent(query));
          if (!res.ok) return;
          const data = await res.json();

          if (Array.isArray(data) && data.length > 0) {
            dropdown.innerHTML = data.map(item => `
              <a href="${item.url}" class="cuia-autocomplete-item">
                <div>
                  <div class="cuia-autocomplete-item-title">${item.title}</div>
                  <div class="cuia-autocomplete-item-meta">${item.subtitle}</div>
                </div>
                <span class="cuia-tag cuia-tag-floresta" style="font-size: 11px;">${item.type === 'restaurant' ? 'Restaurante' : 'Prato'}</span>
              </a>
            `).join('');
            dropdown.classList.add('show');
          } else {
            dropdown.classList.remove('show');
            dropdown.innerHTML = '';
          }
        } catch (e) {
          console.error(e);
        }
      }, 250);
    });

    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove('show');
      }
    });
  }

  // Geolocalização Consentida
  const geoBtn = document.getElementById('btnGeolocalizacao');
  const geoStatus = document.getElementById('geoStatus');
  if (geoBtn && geoStatus) {
    geoBtn.addEventListener('click', function() {
      if (!navigator.geolocation) {
        geoStatus.style.display = 'block';
        geoStatus.textContent = 'Seu navegador não suporta geolocalização.';
        return;
      }

      geoStatus.style.display = 'block';
      geoStatus.textContent = 'Obtendo localização aproximada...';

      navigator.geolocation.getCurrentPosition(
        function(position) {
          geoStatus.textContent = '✓ Localização obtida! Redirecionando para restaurantes próximos...';
          setTimeout(function() {
            window.location.href = '/busca?lat=' + position.coords.latitude + '&lng=' + position.coords.longitude;
          }, 600);
        },
        function(error) {
          geoStatus.textContent = 'Permissão de localização negada ou indisponível. Utilize a busca manual por cidade.';
        },
        { timeout: 10000, enableHighAccuracy: false }
      );
    });
  }
})();
</script>

