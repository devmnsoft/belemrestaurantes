@model IReadOnlyList<BelemRestaurantes.Web.Models.FareView>
<section class="atlas-page-hero"><div class="para-container"><span class="para-eyebrow">RIO</span><h1>Travessias com fonte vigente.</h1><p>Combu, Cotijuba, Mosqueiro e os outros rios do Pará só aparecem aqui com tarifa ou referência dentro da validade. Sem fonte, não há horário.</p></div></section>
<section class="para-container para-section">
@if (Model.Count == 0)
{
  <div class="para-empty"><div><h3>Nenhuma travessia vigente.</h3><p>O portal não estima barco, tarifa nem ponto de embarque. Uma fonte oficial ou da cooperativa, com prazo, pode ser registrada na operação. Até lá, confirme no dia.</p><a class="para-text-link" href="/cuia-rotas">Abrir Cuia Rotas ↗</a></div></div>
}
else
{
  <div class="para-table-wrap"><table><thead><tr><th>Serviço</th><th>Valor</th><th>Vigência</th><th>Fonte</th></tr></thead><tbody>
  @foreach (var fare in Model)
  {
    <tr><td>@fare.ServiceName</td><td>@fare.Amount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td><td>@fare.ValidFrom.ToString("dd/MM/yyyy") – @fare.ValidUntil.ToString("dd/MM/yyyy")<br /><small>@fare.Conditions</small></td><td><a href="@fare.SourceUrl" rel="noopener noreferrer">@fare.SourceName ↗</a><br /><small>@fare.Confidence</small></td></tr>
  }
  </tbody></table></div>
}
</section>
