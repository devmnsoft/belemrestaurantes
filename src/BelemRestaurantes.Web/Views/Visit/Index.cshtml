@model BelemRestaurantes.Web.Models.VisitPlanModel
@using BelemRestaurantes.Application.Models
@using BelemRestaurantes.Application.Services
@{ViewData["Title"]="Cuia Rotas · Como chegar e quando visitar";var r=Model.Restaurant;var request=Model.Request;
string Icon(string mode)=>mode switch{"walking"=>"walk","bicycling"=>"bike","driving"=>"car","boat"=>"boat",_=>"bus"};}
<section class="para-container para-section cuia-visit" lang="pt-BR">
<nav class="para-breadcrumb" aria-label="Você está aqui"><a href="/">Início</a><span>/</span><a href="/busca">Onde comer</a><span>/</span><span>Cuia Rotas</span></nav>
<div class="visit-masthead"><div><span class="para-eyebrow">CUIA MOBILIDADE 360 · DO RIO À MESA</span><h1>O caminho também<br />faz parte do <em>sabor.</em></h1><p>Planeje sua experiência gastronômica. Descubra como chegar e confira o funcionamento antes de sair.</p></div><div class="visit-mark" aria-hidden="true">@await Html.PartialAsync("_ParaIcon","boat")<span>rios · ruas · sabores</span></div></div>
@if(r is null){<div class="visit-panel"><h2>Qual é o seu destino?</h2><form method="get" action="/cuia-rotas" class="visit-search"><div><label for="visit-q">Busque um lugar do catálogo publicado</label><input id="visit-q" name="q" maxlength="160" value="@Context.Request.Query["q"]" placeholder="Restaurante, feira, padaria…"/></div><button class="para-button">Buscar destino</button></form><div class="visit-destinations">@foreach(var choice in Model.Choices){<a href="/cuia-rotas?restaurantId=@choice.Id"><strong>@choice.Name</strong><span>@choice.Category · @choice.City</span></a>}@if(Model.Choices.Count==0){<p>Não há destinos publicados nesta seleção. A curadoria está revisando os cadastros.</p>}</div></div>}
else{
<div class="visit-layout"><div>
<div class="visit-destination"><span class="para-eyebrow">SUA PRÓXIMA PARADA</span><h2>@r.Name</h2><p>@(r.Address??"Endereço completo não confirmado") · @r.City</p><a href="/estabelecimento/@r.Id">Conhecer este lugar ↗</a></div>
<form method="post" action="/cuia-rotas/consultar" class="visit-panel" id="visit-form">
@Html.AntiForgeryToken()<input type="hidden" name="RestaurantId" value="@r.Id"/>
<h2>Qual ônibus eu pego?</h2><p>Ou escolha outro jeito de chegar.</p>
<fieldset class="visit-modes"><legend>Meio de transporte</legend>@foreach(var mode in new[]{("transit","Ônibus / BRT"),("boat","Barco"),("walking","A pé"),("bicycling","Bicicleta"),("driving","Carro")}){<label><input type="radio" name="Mode" value="@mode.Item1" checked="@(request.Mode==mode.Item1)"/>@await Html.PartialAsync("_ParaIcon",Icon(mode.Item1))<span>@mode.Item2</span></label>}</fieldset>
<label for="visit-origin">De onde você sai?</label><input id="visit-origin" name="Origin" value="@request.Origin" maxlength="250" placeholder="Endereço, bairro ou ponto de referência" autocomplete="off"/>
<button type="button" class="visit-text-button" id="visit-location">Usar minha localização</button><p id="visit-location-status" role="status"></p><p class="visit-fineprint">Sua origem será enviada ao provedor somente ao consultar o trajeto. Ela não entra no link compartilhado nem no plano salvo.</p>
<div class="visit-fields"><div><label for="visit-time">Dia e horário no Pará</label><input id="visit-time" type="datetime-local" name="LocalTime" value="@(request.LocalTime?.ToString("yyyy-MM-ddTHH:mm"))" required/></div><div><label for="visit-arrival">Esse horário é de</label><select id="visit-arrival" name="Arrival"><option value="true" selected="@request.Arrival">Chegada desejada</option><option value="false" selected="@(!request.Arrival)">Saída desejada</option></select></div></div>
<details class="visit-preferences"><summary>Preferências de viagem</summary><div class="visit-fields"><div><label for="visit-walk">Caminhada total máxima</label><select name="MaxWalkMeters" id="visit-walk">@foreach(var meters in new[]{250,500,1000,2000,5000}){<option value="@meters" selected="@(request.MaxWalkMeters==meters)">@meters metros</option>}</select></div><div><label for="visit-preference">Prioridade</label><select name="Preference" id="visit-preference"><option value="less_walking" selected="@(request.Preference=="less_walking")">Menos caminhada</option><option value="less_transfers" selected="@(request.Preference=="less_transfers")">Menos baldeações</option><option value="lowest_cost" selected="@(request.Preference=="lowest_cost")">Comparar custos disponíveis</option></select></div></div><label class="visit-check"><input type="checkbox" name="Accessible" value="true" checked="@request.Accessible"/> Preciso de acessibilidade confirmada</label><p>As preferências dependem da cobertura da fonte. Menor custo e acessibilidade não são garantidos sem informação específica.</p></details>
<button class="para-button visit-submit" type="submit">Consultar meu caminho →</button></form>
@if(Model.Routes is {} routes){<section class="visit-panel visit-results" aria-labelledby="route-results"><span class="para-eyebrow">SEU DESLOCAMENTO</span><h2 id="route-results">Caminhos disponíveis</h2><p role="status">@routes.Message</p>@if(request.LocalTime is not null){<p>Horário desejado: @request.LocalTime.Value.ToString("dd/MM/yyyy HH:mm") · @(request.Arrival?"chegada":"saída"). Confirme a data e o horário novamente no Maps ao abrir o planejador externo.</p>}
@foreach(var route in routes.Alternatives){<article class="visit-route"><h3>@route.Description</h3><p><strong>@Math.Ceiling(route.DurationSeconds/60d) min</strong> · @((route.DistanceMeters/1000d).ToString("0.0")) km · @(route.Fare??"Custo não informado")</p><ol>@foreach(var step in route.Steps){<li><strong>@(step.Mode=="WALK"?"Caminhada":step.Line??step.Mode)</strong> — @step.Instruction @if(step.Board is not null){<p>Embarque: @step.Board · Desembarque: @step.Alight</p>}@if(DateTimeOffset.TryParse(step.Departure,out var departure)&&DateTimeOffset.TryParse(step.Arrival,out var arrival)){<p>@TimeZoneInfo.ConvertTime(departure,OpeningHours.ParaZone).ToString("HH:mm") → @TimeZoneInfo.ConvertTime(arrival,OpeningHours.ParaZone).ToString("HH:mm") (Pará)</p>}</li>}</ol></article>}
<a href="@routes.ExternalUrl" class="para-button" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">Abrir trajeto no Google Maps ↗</a>@if(routes.Alternatives.Count>0){<p class="visit-fineprint"><span class="google-maps-attribution" translate="no">Google Maps</span> · Consulta: @TimeZoneInfo.ConvertTime(routes.QueriedAt,OpeningHours.ParaZone).ToString("dd/MM/yyyy HH:mm"). Sem confirmação de último transporte ou acessibilidade.</p>}else{<p class="visit-fineprint">Sem resultado interno de trajeto. Confira as informações no planejador externo.</p>}</section>}
</div><aside class="visit-aside">
<section class="visit-panel"><span class="para-eyebrow">QUANDO VISITAR</span><h2>Portas abertas?</h2><p class="visit-status visit-status-@Model.Assessment.State">@Model.Assessment.Message</p><p>@(request.LocalTime is null?"Situação agora":"Horário consultado") · Fuso America/Belem</p>@if(Model.Schedule.Info is {} info){<p>Confirmado em @info.ConfirmedAt.ToString("dd/MM/yyyy") · Válido até @info.ExpiresAt.ToString("dd/MM/yyyy")</p><a href="@info.SourceUrl" target="_blank" rel="noopener noreferrer">Fonte dos horários ↗</a>}<h3>Cuia Melhor Momento</h3><p>Ainda não há histórico suficiente para recomendar o período mais tranquilo, estimar filas ou lotação.</p><h3>Acessibilidade</h3><p>@(Model.Schedule.Info?.AccessibilityNote??"Informação não confirmada. Consulte o estabelecimento e o operador de transporte.")</p>@if(!string.IsNullOrWhiteSpace(r.Phone)){<a href="tel:@(new string(r.Phone.Where(char.IsDigit).ToArray()))">Confirmar com o estabelecimento: @r.Phone</a>}</section>
<section class="visit-panel"><h2>Guarde este encontro.</h2><p>Salve no seu navegador ou compartilhe destino e horário. A origem fica de fora.</p><button type="button" class="para-button" id="visit-save" data-path="@VisitLinks.SharePath(r.Id,request.LocalTime,request.Mode)">Salvar plano neste dispositivo</button><p id="visit-save-status" role="status"></p><a href="https://wa.me/?text=@Uri.EscapeDataString("Vamos conhecer "+r.Name+"? "+Context.Request.Scheme+"://"+Context.Request.Host+VisitLinks.SharePath(r.Id,request.LocalTime,request.Mode))" target="_blank" rel="noopener noreferrer">Compartilhar pelo WhatsApp ↗</a></section>
<section class="visit-panel"><h2>Mapa do destino</h2>@if(r.Latitude is {} lat&&r.Longitude is {} lng){<p>Localização informada pela fonte. O mapa será carregado após seu clique.</p><button type="button" class="visit-text-button" data-load-map="@FormattableString.Invariant($"https://www.openstreetmap.org/export/embed.html?bbox={lng-0.006}%2C{lat-0.004}%2C{lng+0.006}%2C{lat+0.004}&layer=mapnik&marker={lat}%2C{lng}")">Carregar mapa interativo</button><div id="visit-map"></div><p class="visit-fineprint">© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>. Exibe somente o destino; os trajetos são abertos no planejador do provedor.</p>}else{<p>Este cadastro ainda não possui coordenadas confirmadas. Confira o endereço com o estabelecimento antes de viajar.</p>}<a href="@VisitLinks.Maps(r,null,request.Mode)" target="_blank" rel="noopener noreferrer">Abrir mapa e alternativas ↗</a></section>
</aside></div>}
<section class="visit-river"><div><span class="para-eyebrow">UM PARÁ DE CAMINHOS</span><h2>Tem mesa do outro lado do rio.</h2><p>Combu, Cotijuba, Mosqueiro e Marajó pedem planejamento próprio. Maré, condições de navegação e operação podem mudar a viagem. Confirme o embarque e a volta diretamente com o prestador.</p></div><div><h3>Consulte quem opera</h3><a href="https://seguranca.belem.pa.gov.br/servicos-semob/" target="_blank" rel="noopener noreferrer">SEGBEL · Mobilidade de Belém ↗</a><a href="https://agencia.belem.pa.gov.br/confira-os-horarios-do-geladao-fluvial-para-mosqueiro-e-cotijuba/" target="_blank" rel="noopener noreferrer">Agência Belém · Transporte fluvial ↗</a><p>Links de referência. Notícias antigas não confirmam a operação na data da sua viagem.</p></div></section>
<section class="visit-panel"><span class="para-eyebrow">CUSTO COM PROCEDÊNCIA</span><h2>Tarifas por serviço</h2><p>As referências abaixo não constituem um orçamento do seu trajeto. Integrações, benefícios e volta podem ter regras próprias.</p><div class="visit-destinations">@foreach(var fare in Model.Fares){<article><h3>@fare.ServiceName</h3><p>@fare.Mode · R$ @fare.Amount.ToString("0.00") · @(fare.Confidence=="official"?"Oficial confirmada":fare.Confidence=="partner"?"Informada pelo parceiro":"Estimada")</p><p>Ida e volta sem benefício: R$ @((fare.Amount*2).ToString("0.00"))</p><p>@fare.Conditions</p><p>Vigência: @fare.ValidFrom.ToString("dd/MM/yyyy") a @fare.ValidUntil.ToString("dd/MM/yyyy")</p><a href="@fare.SourceUrl" target="_blank" rel="noopener noreferrer">@fare.SourceName ↗</a></article>}@if(Model.Fares.Count==0){<p>Nenhuma tarifa vigente confirmada cadastrada para esta consulta. Valores e benefícios devem ser consultados com o operador.</p>}</div></section>
<section class="visit-panel" id="visit-saved"><h2>Seus planos neste dispositivo</h2><p>Os planos aparecem aqui depois de salvar. Você pode removê-los a qualquer momento.</p><ul id="visit-saved-list"></ul></section>
</section>
@section Scripts{<script src="~/js/visit.js" asp-append-version="true" defer></script>}
