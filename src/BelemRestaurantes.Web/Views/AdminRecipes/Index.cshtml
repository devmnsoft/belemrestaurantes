@model BelemRestaurantes.Application.Models.PagedResult<BelemRestaurantes.Application.Models.ParaRecipe>
@{Layout="_AdminLayout";ViewData["Title"]="Caderno de receitas";}
<section class="para-section"><span class="para-eyebrow">EDITORIAL GASTRONÔMICO</span><h1>Caderno de receitas</h1><p>Rascunhos, publicações e versões. Uma receita oficial exige fonte e registro de autorização; adaptações são identificadas como inspiradas.</p><a href="/admin/receitas/editar" class="para-button">Nova receita</a><a href="/receitas" class="para-text-link">Ver o caderno público ↗</a><form method="get" class="atlas-city-filter"><div><label for="recipe-admin-query">Título ou ingrediente</label><input id="recipe-admin-query" name="query" value="@ViewData["Query"]" maxlength="120" /></div><button class="para-button">Buscar</button></form><p>@Model.TotalCount receitas · página @Model.Page</p><div class="recipe-grid">@foreach(var recipe in Model.Items){<article class="para-story"><span class="para-eyebrow">@(recipe.Status switch {"published"=>"Publicada","archived"=>"Arquivada",_=>"Rascunho"}) · versão @recipe.Version</span><h2>@recipe.Title</h2><p>@recipe.Subtitle</p><a href="/admin/receitas/editar?slug=@Uri.EscapeDataString(recipe.Slug)">Editar @recipe.Title ↗</a></article>}</div>@if(Model.TotalPages>1){<nav class="para-pagination" aria-label="Paginação">@if(Model.Page>1){<a href="?query=@Uri.EscapeDataString((string?)ViewData["Query"]??"")&amp;page=@(Model.Page-1)">Anterior</a>}<span>@Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a href="?query=@Uri.EscapeDataString((string?)ViewData["Query"]??"")&amp;page=@(Model.Page+1)">Próxima</a>}</nav>}</section>
