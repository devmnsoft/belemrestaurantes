@model BelemRestaurantes.Application.Models.ParaRecipe
@using BelemRestaurantes.Application.Models
@{Layout="_AdminLayout";ViewData["Title"]="Editar receita";var restaurants=ViewData["Restaurants"] as IReadOnlyList<RestaurantView>??[];}
<section class="para-section"><a href="/admin/receitas" class="para-text-link">← Caderno editorial</a><h1>@(Model.Id==0?"Uma nova receita":"Editar "+Model.Title)</h1><p>Textos simples, sem HTML. Todas as alterações geram versão e auditoria. Identifique a origem e os cuidados do preparo.</p>@if(ViewData["RecipeError"] is string error){<p class="recipe-safety" role="alert">@error</p>}
<form method="get" action="/admin/receitas/editar" class="atlas-city-filter"><input type="hidden" name="slug" value="@(Model.Id>0?Model.Slug:null)" /><div><label for="related-restaurant-search">Buscar estabelecimento publicado para relacionar</label><input id="related-restaurant-search" name="restaurantSearch" value="@ViewData["RestaurantSearch"]" maxlength="120" /></div><button class="para-button">Consultar</button></form>
<form method="post" action="/admin/receitas/salvar" class="recipe-editor">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="Version" value="@Model.Version" />
<div class="recipe-edit-grid"><label>Título<input name="Title" value="@Model.Title" maxlength="160" required /></label><label>Endereço da página<input name="Slug" value="@Model.Slug" maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" required /><small>Letras minúsculas sem acento e hífens. Alterar o endereço muda o link público.</small></label><label>Subtítulo<input name="Subtitle" value="@Model.Subtitle" maxlength="350" required /></label><label>Categoria<select name="Category">@foreach(var category in RecipeRules.Categories){<option selected="@(category==Model.Category)">@category</option>}</select></label><label>Momento<select name="Course">@foreach(var course in new[]{"Almoço","Jantar","Café e lanche","Sobremesa"}){<option selected="@(course==Model.Course)">@course</option>}</select></label><label>Cidade de referência editorial<select name="City">@foreach(var city in BelemRestaurantes.Domain.Data.ParaOfficialCatalog.Municipalities){<option selected="@(city.Name==Model.City)">@city.Name</option>}</select></label><label>Rendimento (porções)<input name="Servings" value="@Model.Servings" type="number" min="1" max="50" required /></label><label>Preparo (minutos)<input name="PrepMinutes" value="@Model.PrepMinutes" type="number" min="0" max="1440" required /></label><label>Cocção (minutos)<input name="CookMinutes" value="@Model.CookMinutes" type="number" min="0" max="1440" required /></label><label>Espera (minutos)<input name="WaitMinutes" value="@Model.WaitMinutes" type="number" min="0" max="1440" required /></label><label>Dificuldade<select name="Difficulty">@foreach(var difficulty in new[]{"Fácil","Intermediária","Elaborada"}){<option selected="@(difficulty==Model.Difficulty)">@difficulty</option>}</select></label><label>Ilustração<select name="Icon">@foreach(var icon in new[]{"cuia","fish","leaf","plate","bread","cup","icecream"}){<option selected="@(icon==Model.Icon)">@icon</option>}</select></label><label>Cor<select name="Tone">@foreach(var tone in new[]{"forest","river","acai","gold","urucum"}){<option selected="@(tone==Model.Tone)">@tone</option>}</select></label></div>
<label>Contexto e descrição<textarea name="Story" maxlength="4000" rows="4">@Model.Story</textarea></label><div class="recipe-edit-grid"><label>Ingredientes — um por linha<textarea name="ingredientsText" rows="12" required>@string.Join("\n",Model.Ingredients)</textarea></label><label>Passos — um por linha<textarea name="stepsText" rows="12" required>@string.Join("\n",Model.Steps)</textarea></label></div>
@foreach(var field in new[]{("Tips","Dicas",Model.Tips),("Variations","Variações",Model.Variations),("ServeWith","Com o que servir",Model.ServeWith),("Allergens","Alérgenos e rótulos",Model.Allergens),("SafetyNote","Cuidados de preparo",Model.SafetyNote)}){<label>@field.Item2<textarea name="@field.Item1" maxlength="4000" rows="3">@field.Item3</textarea></label>}
<div class="recipe-edit-grid"><label>Identificação<select name="Kind"><option value="inspired" selected="@(Model.Kind=="inspired")">Receita inspirada / adaptação editorial</option><option value="official" selected="@(Model.Kind=="official")">Oficial, com fonte e autorização</option></select></label><label>Fonte cultural, de preparo ou oficial (HTTPS)<input name="SourceUrl" type="url" value="@Model.SourceUrl" maxlength="350" /></label><label>Autorização ou publicação oficial<textarea name="PermissionNote" maxlength="4000">@Model.PermissionNote</textarea></label><label>Vídeo público (YouTube, Instagram, TikTok ou Globoplay)<input name="VideoUrl" type="url" value="@Model.VideoUrl" maxlength="350" /></label><label>Título do vídeo<input name="VideoTitle" value="@Model.VideoTitle" maxlength="160" /></label></div>
<label>Estabelecimentos relacionados — identificadores separados por vírgula<input name="relatedRestaurantIds" value="@string.Join(',',Model.RestaurantIds)" maxlength="260" /><small>Até 12, todos publicados. A relação editorial não confirma a oferta do prato.</small></label>
<details><summary>Consultar identificadores de estabelecimentos publicados</summary><ul>@foreach(var restaurant in restaurants){<li>#@restaurant.Id — @restaurant.Name · @restaurant.City</li>}</ul><p>Use a busca acima para consultar outros estabelecimentos. Salve as alterações antes de pesquisar.</p></details>
<label>Situação<select name="Status"><option value="draft" selected="@(Model.Status=="draft")">Rascunho</option><option value="published" selected="@(Model.Status=="published")">Publicado</option><option value="archived" selected="@(Model.Status=="archived")">Arquivado</option></select></label><button class="para-button" type="submit">Salvar versão</button>
</form></section>
