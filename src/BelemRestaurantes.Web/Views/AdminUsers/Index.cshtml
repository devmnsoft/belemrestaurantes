@model IReadOnlyList<BelemRestaurantes.Web.Controllers.AdminAccessRow>
@{Layout="_AdminLayout";ViewData["Title"]="Usuários e papéis";}
<section class="para-operations"><span class="para-eyebrow">MNSOFT · GOVERNANÇA</span><h1>Acesso certo para cada pessoa.</h1><p>Somente administradores globais podem alterar papéis e bloquear contas. MFA permanece obrigatório em todos os perfis administrativos.</p><div class="para-review-grid">@foreach(var row in Model){<article class="para-review-card"><h2>@row.UserName</h2><p>MFA: @(row.Mfa?"Ativado":"Configuração obrigatória no acesso") · @(row.MustChangePassword?"Troca inicial de senha pendente":"Senha definida")</p><form method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@row.Id"/><fieldset><legend>Papéis autorizados</legend>@foreach(var role in BelemRestaurantes.Domain.Identity.AdminRoles.All){<label class="visit-check"><input type="checkbox" name="roles" value="@role" checked="@(row.Roles?.Split(',').Contains(role)==true)"/> @role</label>}</fieldset><label class="visit-check"><input type="checkbox" name="disabled" value="true" checked="@row.Disabled"/> Conta bloqueada</label><button class="para-button mt-3">Atualizar acesso</button></form></article>}</div></section>
