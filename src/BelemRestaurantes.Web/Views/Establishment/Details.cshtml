@model BelemRestaurantes.Application.Models.RestaurantView
@using BelemRestaurantes.Application.Abstractions
@using BelemRestaurantes.Application.Services
@using System.Text.Json
@inject Microsoft.Extensions.Configuration.IConfiguration SeoConfig
@{
    var seoOrigin = SitemapBuilder.ResolvePublicOrigin(SeoConfig["Seo:PublicOrigin"]);
    ViewData["Title"] = $"{Model.Name} — Belém Restaurantes";
    ViewData["MetaDescription"] = $"{Model.Name} em {Model.City}. Ficha publicada com o que a fonte informou. Horário, cardápio e foto só aparecem quando existem.";
    ViewData["OgTitle"] = $"{Model.Name} | Belém Restaurantes";
    ViewData["OgDescription"] = $"Cadastro de {Model.Name} em {Model.City}. O que não está na ficha não foi confirmado.";
    ViewData["OgUrl"] = RestaurantJsonLd.PageUrl(Model.Id, seoOrigin);
    var ogImage = RestaurantJsonLd.AbsolutePhotoUrl(Model.PhotoUrl, seoOrigin);
    if (ogImage is not null)
    {
        ViewData["OgImage"] = ogImage;
    }

    var cuiaBadges = ViewData["CuiaBadges"] as IReadOnlyList<CuiaBadgeView> ?? [];
    var gallery = ViewData["Gallery"] as RestaurantGallery;
    var experiences = ViewData["Experiences"] as IReadOnlyList<ExperienceView> ?? [];
    var recipes=ViewData["Recipes"] as IReadOnlyList<BelemRestaurantes.Application.Models.ParaRecipe>??[];
    var facts=ViewData["FactSheet"] as BelemRestaurantes.Application.Models.CatalogFactSheet;
}
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(RestaurantJsonLd.Build(Model, seoOrigin)))</script>

<div class="cuia-container cuia-section">
  <nav class="para-breadcrumb" aria-label="Você está aqui"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/busca">Onde comer</a><span aria-hidden="true">/</span><span>@Model.Name</span></nav>
  <article class="para-detail-hero">
    <div class="para-detail-media">
      @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl) && (Model.PhotoUrl.StartsWith("/media/", StringComparison.Ordinal) || (Uri.TryCreate(Model.PhotoUrl, UriKind.Absolute, out var heroPhotoUri) && heroPhotoUri.Scheme == "https")))
      { <figure class="para-licensed-photo"><img src="@Model.PhotoUrl" alt="Foto de @Model.Name" width="900" height="700" fetchpriority="high" />@if(!string.IsNullOrWhiteSpace(Model.PhotoAttribution)){<figcaption>Foto: @Model.PhotoAttribution@if(!string.IsNullOrWhiteSpace(Model.PhotoLicense)){<span> · @Model.PhotoLicense</span>}</figcaption>}</figure> }
      else
      { @await Html.PartialAsync("_CategoryArtwork",Model.Category ?? "Restaurante") }
      @if(cuiaBadges.Count>0) { <div class="para-detail-badges">@foreach(var badge in cuiaBadges) { <span class="cuia-tag cuia-tag-tucupi">Selo Cuia · @badge.BadgeTitle</span> }</div> }
    </div>
    <div class="para-detail-info"><span class="para-tier @(Model.CatalogTier=="guia"?"is-guide":"is-directory")">@(Model.CatalogTier=="guia"?"Camada Guia · revisão humana":"Ficha cadastral · sem visita confirmada")</span><span class="para-eyebrow">@Model.Category · @Model.City</span><h1>@Model.Name</h1><p class="para-detail-address">@(Model.Address ?? "Endereço completo em revisão") @(!string.IsNullOrWhiteSpace(Model.Neighborhood) ? "· " + Model.Neighborhood : "")</p>
      @if(Model.BusinessStatus is "temporarily_closed" or "permanently_closed") { <p class="para-closed">@(Model.BusinessStatus=="temporarily_closed"?"Fonte informa fechamento temporário. Confirme antes de ir.":"Fonte informa encerramento das atividades.")</p> }
      else { <p class="para-detail-note">Vai visitar? Confirme os horários e o funcionamento com o estabelecimento.</p> }
      <div class="para-detail-main-actions">
        <button type="button" class="para-save" data-save-kind="catalog" data-save-id="@Model.Id" data-save-name="@Model.Name" data-save-city="@Model.City">Guardar neste navegador</button>
        <a href="https://www.google.com/maps/search/?api=1&amp;query=@Uri.EscapeDataString(Model.Latitude is not null && Model.Longitude is not null ? Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + "," + Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : Model.Name + " " + Model.City)" target="_blank" rel="noopener noreferrer" class="para-button">@await Html.PartialAsync("_ParaIcon", "mobility") Como chegar ↗</a>
        @if(!string.IsNullOrWhiteSpace(Model.Phone)) { <a class="para-text-link" href="tel:@(new string(Model.Phone.Where(c=>char.IsDigit(c)||c=='+').ToArray()))">Ligar: @Model.Phone</a> }
        @if(!string.IsNullOrWhiteSpace(Model.PhoneSecondary)) { <a class="para-text-link" href="tel:@(new string(Model.PhoneSecondary.Where(c=>char.IsDigit(c)||c=='+').ToArray()))">Outro telefone informado: @Model.PhoneSecondary</a> }
      </div>
      <div class="para-detail-links">
        @foreach(var link in new[] { ("Site",Model.Website), ("Instagram",Model.Instagram), ("Facebook",Model.Facebook), ("TikTok",Model.TikTok), ("YouTube",Model.YouTube) })
        { @if (link.Item2 is not null && Uri.TryCreate(link.Item2,UriKind.Absolute,out var safe) && safe.Scheme=="https") { <a href="@safe.AbsoluteUri" target="_blank" rel="noopener noreferrer">@link.Item1 ↗</a> } }
      </div>
      <div class="para-detail-secondary-actions"><form method="post" action="/account/favorites/@Model.Id/@(ViewData["IsFavorite"] is true ? "remove" : "add")">@Html.AntiForgeryToken()<button type="submit" class="cuia-btn cuia-btn-outline" aria-pressed="@(ViewData["IsFavorite"] is true ? "true" : "false")">@(ViewData["IsFavorite"] is true ? "♥ Salvo nos favoritos" : "♡ Salvar nos favoritos")</button></form><button type="button" data-copy-url="true" class="cuia-btn cuia-btn-outline">Compartilhar</button></div>
      <div class="para-detail-provenance"><span>Cadastro atualizado em @Model.UpdatedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy").</span>
      @if (Model.SourceUrl is not null && Uri.TryCreate(Model.SourceUrl,UriKind.Absolute,out var source) && source.Scheme=="https") { <a href="@source.AbsoluteUri" target="_blank" rel="noopener noreferrer">Consultar fonte do cadastro ↗</a> }
      <a href="/sugerir?restaurantId=@Model.Id">Sugerir uma correção</a></div>
    </div>
  </article>
  @if (facts is not null)
  {
    var dossier = ViewData["Dossier"] as BelemRestaurantes.Application.Abstractions.PlaceDossier;
    var addressNote = dossier?.Fields.LastOrDefault(f => f.Field == "address" && f.State == "informed");
    var conflict = dossier?.Fields.LastOrDefault(f => f.Field == "address" && f.State == "conflict");
    <section class="fact-sheet" lang="pt-BR" aria-labelledby="visit-facts-title">
      <h2 id="visit-facts-title">Para a visita</h2>
      <dl>
        <div><dt>Endereço e bairro</dt><dd>@(addressNote?.Value ?? facts.Address ?? "Endereço ainda não localizado.") @(!string.IsNullOrWhiteSpace(Model.Neighborhood) ? "· " + Model.Neighborhood : "")</dd></div>
        <div><dt>Como chegar</dt><dd><a href="/cuia-rotas?restaurantId=@Model.Id">Abrir o caminho no Cuia Rotas</a></dd></div>
        <div><dt>Telefone</dt><dd>@(facts.HasPhone ? facts.Phone : "Ainda não localizado.")@if(!string.IsNullOrWhiteSpace(facts.PhoneSecondary)){<span> · Também informado: @facts.PhoneSecondary</span>}</dd></div>
        <div><dt>Horário</dt><dd>@(facts.HasHours ? (facts.HoursSummary ?? "Há horário informado pela fonte. Confirme a data.") : "Ainda não localizado. Sem isso, a ficha não marca aberto agora.")@if(facts.HoursObservedOn is {} observed){<span> Verificado em @observed.ToString("dd/MM/yyyy").</span>}@if(!string.IsNullOrWhiteSpace(facts.HoursSource)){<span> Fonte: @facts.HoursSource.</span>}</dd></div>
        <div><dt>Cardápio e pratos</dt><dd>@(facts.MenuState == "collected" ? string.Join(" · ", facts.Dishes) : "Ainda não houve coleta de cardápio. Isso não significa que a casa não sirva pratos.")</dd></div>
        <div><dt>Localização</dt><dd>@(facts.HasCoordinates ? (facts.CoordinatePrecision == "rooftop" ? "Coordenada com precisão registrada." : "Há coordenada, sem precisão de ponto exato. O mapa da cidade não marca esta ficha como localização exata.") : "Coordenada ainda não localizada.")</dd></div>
      </dl>
      @if (conflict is not null) { <p><strong>Informação conflitante:</strong> @conflict.Evidence</p> }
      <p><a href="/sugerir?restaurantId=@Model.Id" class="para-button">Sugerir correção</a></p>
    </section>
    <details class="fact-sheet">
      <summary>Sobre estas informações</summary>
      <dl>
        <div><dt>Endereço</dt><dd>@BelemRestaurantes.Application.Services.FieldStates.Label(facts.HasAddress ? "informed" : "not_located")</dd></div>
        <div><dt>Telefone</dt><dd>@BelemRestaurantes.Application.Services.FieldStates.Label(facts.HasPhone ? "informed" : "not_located")</dd></div>
        <div><dt>Horário</dt><dd>@BelemRestaurantes.Application.Services.FieldStates.Label(facts.HoursState)@(facts.HoursObservedOn is {} whenHours ? " em " + whenHours.ToString("dd/MM/yyyy") : "")</dd></div>
        <div><dt>Cardápio</dt><dd>@(facts.MenuState == "collected" ? "Itens publicados pelo responsável." : "Coleta ainda não realizada.")</dd></div>
        <div><dt>Foto</dt><dd>@(facts.HasPhoto ? "Há imagem publicada, com a origem indicada junto da foto." : "Foto licenciada ainda não localizada.")</dd></div>
        <div><dt>Responsável</dt><dd>@(facts.ClaimValidated ? "Reivindicação validada no sistema." : "Responsável não reivindicado. Um perfil ou página externa não valida a propriedade da ficha.")</dd></div>
      </dl>
      @if (dossier is not null && dossier.Fields.Count > 0)
      {
        <ul>
        @foreach (var field in dossier.Fields)
        {
          <li>@field.Field: @BelemRestaurantes.Application.Services.FieldStates.Label(field.State)@if(!string.IsNullOrWhiteSpace(field.SourceName)){<span> · @field.SourceName</span>}@if(field.SourceUrl is not null && Uri.TryCreate(field.SourceUrl, UriKind.Absolute, out var sourceUri) && sourceUri.Scheme == "https"){<span> · <a href="@sourceUri.AbsoluteUri" rel="noopener noreferrer">fonte</a></span>}</li>
        }
        </ul>
      }
      @if (!facts.ClaimValidated) { <p><a href="/partner/claim/@Model.Id">Este lugar é seu? Reivindique a ficha</a></p> }
    </details>
    @if (dossier is not null && dossier.Videos.Count > 0)
    {
      <section class="place-discovery" aria-labelledby="place-videos-title"><h2 id="place-videos-title">Vídeos relacionados</h2>
      @foreach (var video in dossier.Videos)
      {
        <article class="video-card"><h3>@video.Title</h3><p>@video.Author · @video.Platform @if(video.PublishedOn is {} published){<span> · @published.ToString("dd/MM/yyyy")</span>}</p><p>@video.Summary</p><p>@(video.Attribution == "chef_published" ? "Vídeo de chef ou instituição identificada. Não é o cardápio deste estabelecimento." : video.Attribution == "traditional_similar" ? "Versão caseira ou tradicional. Não é receita oficial deste estabelecimento." : "Vídeo de canal. A relação com este estabelecimento não está comprovada.")</p><a href="@video.Url" rel="noopener noreferrer">Assistir na fonte ↗</a></article>
      }
      </section>
    }
    <section class="place-discovery" aria-labelledby="continue-title"><h2 id="continue-title">Continuar na Cuia</h2>
      <p><a href="/cuia-ia?searchWeb=true&amp;q=@Uri.EscapeDataString("Quais os horários da " + Model.Name + " em " + (Model.Neighborhood ?? Model.City) + "?")">Perguntar os horários</a></p>
      <p><a href="/cuia-ia?searchWeb=true&amp;q=@Uri.EscapeDataString("Quais pratos " + Model.Name + " divulga?")">Perguntar os pratos divulgados</a></p>
      <p><a href="/culinaria">Ver vídeos de culinária paraense</a></p>
      <p><a href="/busca?city=@Uri.EscapeDataString(Model.City)&amp;neighborhood=@Uri.EscapeDataString(Model.Neighborhood ?? "")">Mais lugares no bairro</a></p>
    </section>
  }
  <div class="para-detail-quick-links"><a href="/cardapio/@Model.Id">Ver cardápio ↗</a><a href="/experience/create?restaurantId=@Model.Id">Contar minha experiência ↗</a><a href="/partner/claim/@Model.Id">Esse restaurante é seu? Reivindique ↗</a></div>
  
  <section class="visit-panel cuia-ai-sommelier-panel" lang="pt-BR" aria-labelledby="sommelier-heading">
    <span class="para-eyebrow" style="color:#ffe2a0;">O QUE O CADASTRO PERMITE DIZER</span>
    <h2 id="sommelier-heading" style="font-family:var(--para-serif);font-size:1.6rem;color:#fffdf5;margin:8px 0 12px;">Leitura da ficha</h2>
    <div id="ai-restaurant-advice" class="cuia-ai-advice-content">
      <p>A leitura usa só cidade, categoria e endereço desta ficha. Ela não escolhe prato, horário nem preço.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:14px;align-items:center;">
      <button type="button" class="para-button" id="btn-ask-sommelier" data-restaurant-id="@Model.Id" style="background:#efb645;color:#0d281e;font-weight:800;border:none;cursor:pointer;padding:10px 18px;border-radius:8px;">
        Ler o que a ficha permite dizer
      </button>
      <a href="/cuia-ia?q=@Uri.EscapeDataString("O que pedir no " + Model.Name + " em " + Model.City + "?")" class="para-text-link" style="color:#ffe2a0;font-weight:600;">
        Fazer outra pergunta à Cuia IA ↗
      </a>
    </div>
  </section>

  @await Html.PartialAsync("_RestaurantVideos", ViewData["MediaList"] as IReadOnlyList<BelemRestaurantes.Domain.Entities.RestaurantMedia> ?? [])
  <section class="visit-panel" lang="pt-BR" aria-labelledby="visit-section"><span class="para-eyebrow">CUIA MOBILIDADE 360</span><h2 id="visit-section">Como chegar e quando visitar</h2><p class="visit-status">@((ViewData["OpeningAssessment"] as BelemRestaurantes.Application.Models.OpeningAssessment)?.Message??"Horário não confirmado")</p><p>Ônibus, BRT, caminhada, bicicleta, carro e referências de transporte fluvial. Confira trajetos, funcionamento e informações disponíveis antes de sair.</p><a href="/cuia-rotas?restaurantId=@Model.Id" class="para-button">Planejar minha visita →</a></section>
  <details class="visit-panel"><summary>Ver localização no mapa</summary>@if(Model.Latitude is {} lat && Model.Longitude is {} lng && string.Equals(Model.CoordinatePrecision, "rooftop", StringComparison.Ordinal)){<p>O mapa externo carrega após seu clique e mostra o ponto com precisão registrada.</p><button type="button" class="visit-text-button" data-load-map="@FormattableString.Invariant($"https://www.openstreetmap.org/export/embed.html?bbox={lng-0.006}%2C{lat-0.004}%2C{lng+0.006}%2C{lat+0.004}&layer=mapnik&marker={lat}%2C{lng}")">Carregar mapa interativo</button><div id="visit-map"></div><p>© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a></p>}else if(Model.Latitude is not null){<p>Há coordenada, sem precisão de ponto exato. O mapa não marca esta ficha como localização exata.</p><p><a href="/mapa?city=@Uri.EscapeDataString(Model.City)">Abrir o mapa da cidade</a></p>}else{<p>Coordenada ainda não localizada. Consulte o endereço e planeje a visita no Cuia Rotas.</p>}</details>
  @if(recipes.Count>0){<section class="recipe-related"><div class="para-section-heading"><div><span class="para-eyebrow">O PARÁ NA SUA COZINHA</span><h2>Quer fazer algo parecido em casa?</h2><p>Adaptações editoriais relacionadas ao tema. Não reproduzem receitas oficiais deste estabelecimento.</p></div><a href="/receitas?RestaurantId=@Model.Id" class="para-text-link">Ver receitas relacionadas ↗</a></div><div class="recipe-grid">@foreach(var recipe in recipes){@await Html.PartialAsync("_RecipeCard",recipe)}</div></section>}

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 32px; align-items: start;">
    <!-- Coluna Esquerda: Informações & Mobilidade -->
    <div>
      <!-- Cardápio Digital Rápido -->
      <div class="cuia-card" style="margin-bottom: 24px; padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
          <h3 style="font-size: 1rem; font-weight: 800; color: var(--floresta-900, #113F32); margin: 0;">Cardápio Digital da Casa</h3>
          <a href="/cardapio/@Model.Id" class="cuia-btn cuia-btn-primary cuia-btn-sm">Acessar Cardápio →</a>
        </div>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 1rem; margin: 0;">
          O cardápio só lista o que o responsável publicou. Sem itens, a página informa que a coleta ainda não aconteceu.
        </p>
      </div>

      <!-- Como Chegar e Mobilidade -->
      <div class="cuia-card" style="margin-bottom: 24px; padding: 24px;">
        <h3 style="font-size: 1rem; font-weight: 800; color: var(--floresta-900, #113F32); margin-bottom: 12px;">Mobilidade Urbana & Como Chegar</h3>
        <p style="color: var(--texto-secundario, #4b635a); font-size: 1rem; line-height: 1.6; margin-bottom: 16px;">
          Use o endereço ou a coordenada informada para abrir o trajeto até @Model.City. Linha, horário de barco e tarifa só aparecem quando há fonte vigente.
        </p>
        <a href="https://www.google.com/maps/dir/?api=1&destination=@Uri.EscapeDataString(Model.Name + " " + Model.Address + " " + Model.City)" target="_blank" rel="noopener noreferrer" class="cuia-btn cuia-btn-secondary cuia-btn-sm" style="width: 100%; text-align: center;">
          Traçar Rota no Google Maps ↗
        </a>
      </div>

      <!-- Galeria de Fotos Segregada -->
      <div class="cuia-card" style="padding: 24px;">
        <h3 style="font-size: 1rem; font-weight: 800; color: var(--floresta-900, #113F32); margin-bottom: 16px;">Fotografias do Restaurante</h3>

        <!-- Fotos da Comunidade -->
        <h4 style="font-size: 1rem; color: var(--floresta-800, #165338); font-weight: 700; margin-bottom: 10px;">Enviadas pela Comunidade</h4>
        @if (gallery?.CommunityPhotos.Count > 0)
        {
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin-bottom: 18px;">
            @foreach (var photo in gallery.CommunityPhotos)
            {
              <a href="/media/photo/@photo.FileName" target="_blank" style="display: block; border-radius: 10px; overflow: hidden; border: 1px solid var(--borda-suave, #e2e8df); height: 90px;">
                <img src="/media/thumb/@photo.ThumbnailName" alt="@photo.Caption" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
              </a>
            }
          </div>
        }
        else
        {
          <p style="font-size: 1rem; color: var(--texto-secundario, #4b635a); margin-bottom: 18px;">Nenhuma foto enviada pela comunidade ainda.</p>
        }

        <!-- Fotos Oficiais -->
        @if (gallery?.OfficialPhotos.Count > 0)
        {
          <h4 style="font-size: 1rem; color: var(--floresta-800, #165338); font-weight: 700; margin-bottom: 10px;">Fotos Oficiais da Casa</h4>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin-bottom: 18px;">
            @foreach (var photo in gallery.OfficialPhotos)
            {
              <a href="/media/photo/@photo.FileName" target="_blank" style="display: block; border-radius: 10px; overflow: hidden; border: 1px solid var(--borda-suave, #e2e8df); height: 90px;">
                <img src="/media/thumb/@photo.ThumbnailName" alt="@photo.Caption" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
              </a>
            }
          </div>
        }

        @{
          var mediaList = ViewData["MediaList"] as IReadOnlyList<BelemRestaurantes.Domain.Entities.RestaurantMedia> ?? [];
        }
        @if (mediaList.Count > 0)
        {
          <h4 style="font-size: 1rem; color: var(--floresta-800, #165338); font-weight: 700; margin-bottom: 10px;">Mídias Licenciadas & Experiências</h4>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin-bottom: 18px;">
            @foreach (var m in mediaList.Where(m=>m.MediaType!="video_embed" && Uri.TryCreate(m.MediaUrl,UriKind.Absolute,out var photoUri) && photoUri.Scheme=="https"))
            {
              <div style="border-radius: 10px; overflow: hidden; border: 1px solid var(--borda-suave, #e2e8df); background: #f9fafb;" title="@m.AttributionText (@m.LicenseType)">
                <img src="@m.MediaUrl" alt="Mídia de @Model.Name" style="width: 100%; height: 90px; object-fit: cover;" loading="lazy" />
                <div style="font-size: 1rem; color: var(--texto-secundario, #4b635a); padding: 4px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  @m.AttributionText
                </div>
              </div>
            }
          </div>
        }
      </div>

      <!-- Procedência & Transparência das Informações -->
      <div class="cuia-card" style="margin-top: 24px; padding: 20px;">
        <h4 style="font-size: 1rem; font-weight: 700; color: var(--floresta-900, #113F32); margin: 0 0 8px 0;">
          Transparência & Procedência dos Dados
        </h4>
        <p style="font-size: 1rem; color: var(--texto-secundario, #4b635a); line-height: 1.5; margin: 0 0 10px 0;">
          Este cadastro reúne informações de fontes externas e contribuições revisadas. Elas podem estar desatualizadas: confirme os detalhes com o estabelecimento antes da visita.
        </p>
        <div style="font-size: 1rem; color: var(--texto-secundario, #4b635a); background: var(--palha-100, #f7f4eb); padding: 8px 12px; border-radius: 8px;">
          <div><strong>Última atualização:</strong> @Model.UpdatedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm")</div>
          <div style="margin-top: 2px;"><strong>Status:</strong> Publicado no guia · Funcionamento a confirmar</div>
        </div>
      </div>
    </div>

    <!-- Coluna Direita: Avaliações e Experiências da Comunidade -->
    <div>
      <div class="cuia-card" style="padding: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--borda-suave, #e2e8df);">
          <div>
            <h2 style="font-size: 22px; font-weight: 800; color: var(--floresta-900, #113F32); margin: 0;">Experiências da Comunidade</h2>
            <span style="font-size: 1rem; color: var(--texto-secundario, #4b635a);">@experiences.Count relatos reais compartilhados</span>
          </div>
          <a href="/experience/create?restaurantId=@Model.Id" class="cuia-btn cuia-btn-secondary cuia-btn-sm">
            ✦ Avaliar Restaurante
          </a>
        </div>

        @if (experiences.Count == 0)
        {
          <div style="text-align: center; padding: 40px 16px; background: var(--palha-100, #f7f4eb); border-radius: 16px;">
            <div style="font-size: 32px; margin-bottom: 8px; color: var(--tucupi-600, #c48b28);">✦</div>
            <h4 style="font-weight: 700; color: var(--floresta-900, #113F32); margin-bottom: 6px;">Seja o primeiro a avaliar!</h4>
            <p style="color: var(--texto-secundario, #4b635a); font-size: 1rem; max-width: 400px; margin: auto; margin-bottom: 16px;">
              Conte como foi seu atendimento, sabor dos pratos, ambiente e custo-benefício em @Model.Name.
            </p>
            <a href="/experience/create?restaurantId=@Model.Id" class="cuia-btn cuia-btn-secondary cuia-btn-sm">
              Escrever Primeira Avaliação
            </a>
          </div>
        }
        else
        {
          <div style="display: flex; flex-direction: column; gap: 20px;">
            @foreach (var exp in experiences)
            {
              <div class="cuia-card" style="background: var(--palha-100, #f7f4eb); padding: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                  <div>
                    <strong style="color: var(--floresta-900, #113F32); font-size: 1rem;">@exp.AuthorName</strong>
                    <div style="font-size: 1rem; color: var(--texto-secundario, #4b635a);">@exp.CreatedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm")</div>
                  </div>
                  <div class="cuia-rating">
                    @for (int i = 1; i <= 5; i++)
                    {
                      <span style="color: @(i <= exp.Stars ? "#e8ad46" : "#dce7dc");">★</span>
                    }
                  </div>
                </div>

                <!-- Subcritérios de Nota -->
                <div style="display: flex; gap: 12px; flex-wrap: wrap; font-size: 1rem; background: #ffffff; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--borda-suave, #e2e8df); margin-bottom: 12px;">
                  <span><b>Atendimento:</b> @exp.ServiceStars★</span>
                  <span><b>Sabor:</b> @exp.FlavorStars★</span>
                  <span><b>Ambiente:</b> @exp.AmbianceStars★</span>
                  <span><b>Custo-Benefício:</b> @exp.CostBenefitStars★</span>
                  @if (exp.PricePaid.HasValue)
                  {
                    <span><b>Preço pago:</b> R$ @exp.PricePaid.Value.ToString("F2")</span>
                  }
                </div>

                @if (!string.IsNullOrWhiteSpace(exp.DishesConsumed))
                {
                  <div style="font-size: 1rem; color: var(--floresta-900, #113F32); font-weight: 700; margin-bottom: 6px;">
                    Prato: @exp.DishesConsumed
                  </div>
                }

                @if (!string.IsNullOrWhiteSpace(exp.ReviewText))
                {
                  <p style="font-size: 1rem; line-height: 1.5; color: var(--texto-principal, #17342d); margin: 0 0 12px;">
                    @exp.ReviewText
                  </p>
                }

                @if (exp.Photos.Count > 0)
                {
                  <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px;">
                    @foreach (var p in exp.Photos)
                    {
                      <a href="/media/photo/@p.FileName" target="_blank" style="width: 80px; height: 65px; border-radius: 8px; overflow: hidden; border: 1px solid var(--borda-suave, #e2e8df);">
                        <img src="/media/thumb/@p.ThumbnailName" alt="" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
                      </a>
                    }
                  </div>
                }

                <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid var(--borda-suave, #e2e8df); font-size: 1rem;">
                  <form method="post" action="/experience/@exp.Id/like" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="cuia-btn cuia-btn-outline cuia-btn-sm" style="padding: 4px 10px; font-size: 1rem;">
                      @(exp.HasLiked ? "♥" : "♡") Curtir (@exp.LikesCount)
                    </button>
                  </form>
                  <a href="/experience/@exp.Id" style="color: var(--floresta-900, #113F32); font-weight: 700; text-decoration: none;">
                    Comentários (@exp.CommentsCount) →
                  </a>
                </div>
              </div>
            }
          </div>
        }
      </div>
    </div>
  </div>
@if(ViewData["PlaceReferences"] is IReadOnlyList<PlaceReference> referenceRows && referenceRows.Count>0)
{<section class="para-container para-section"><h2>Referências externas revisadas</h2><p>Informações atribuídas às fontes abaixo. Confirme cardápio, horários e disponibilidade diretamente com o estabelecimento.</p>
@foreach(var reference in referenceRows){<article class="panel"><h3>@reference.Publisher</h3><a href="@reference.SourceUrl" target="_blank" rel="noopener noreferrer">Consultar a fonte ↗</a><p>Consultada em @reference.ObservedAt.ToString("dd/MM/yyyy") · @(reference.SourceKind=="official_menu"?"Cardápio identificado":reference.SourceKind=="editorial_reference"?"Referência editorial":"Dados publicados pela fonte")</p>
@if(reference.MenuItems.Count>0){<h4>Pratos mencionados na fonte</h4><ul>@foreach(var item in reference.MenuItems){<li>@item</li>}</ul>}
@foreach(var opening in reference.OpeningHours??[]){<p>Horário informado na fonte: @opening</p>}
@foreach(var video in reference.VideoLinks??[]){<p><a href="@video" target="_blank" rel="noopener noreferrer">Ver vídeo externo relacionado ↗</a></p>}
</article>}</section>}
<section class="para-container para-section"><h2>Opiniões em outras plataformas</h2><p>Avaliações externas têm autoria e regras próprias; não foram copiadas para os comentários da comunidade.</p><a href="https://www.google.com/maps/search/?api=1&amp;query=@Uri.EscapeDataString(Model.Name+" "+Model.City+" "+Model.Address)" target="_blank" rel="noopener noreferrer">Buscar o perfil e avaliações no Google Maps ↗</a></section>
@section Scripts{
  <script src="~/js/videos.js" asp-append-version="true" defer></script>
  <script src="~/js/visit.js" asp-append-version="true" defer></script>
  <script src="~/js/cuia-advice.js" asp-append-version="true" defer></script>
}
