@model BelemRestaurantes.Application.Models.RestaurantView
@using BelemRestaurantes.Application.Abstractions
@{
    ViewData["Title"] = Model.Name;
    var cuiaBadges = ViewData["CuiaBadges"] as IReadOnlyList<CuiaBadgeView> ?? [];
    var gallery = ViewData["Gallery"] as RestaurantGallery;
    var experiences = ViewData["Experiences"] as IReadOnlyList<ExperienceView> ?? [];
}
<section class="shell section">
  <div class="heading">
    <div>
      <span class="overline dark">@Model.City · @(Model.Neighborhood ?? T["AddressChecking"].Value)</span>
      <h1>@Model.Name</h1>
      <p class="muted">@Model.Category</p>
      
      @if (cuiaBadges.Count > 0)
      {
          <div class="cuia-badges" style="display:flex;gap:8px;flex-wrap:wrap;margin:10px 0;">
            @foreach (var badge in cuiaBadges)
            {
                <span class="badge" style="background:#174b3c;color:#f6c271;padding:6px 14px;border-radius:20px;font-size:13px;display:inline-flex;align-items:center;gap:6px;" title="@badge.MethodologySummary">
                  <span>🏆</span> @badge.BadgeTitle (@badge.RankPosition º lugar · Nota @badge.Score.ToString("F2"))
                </span>
            }
          </div>
      }
    </div>

    <div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
      <a href="/cardapio/@Model.Id" class="button-link" style="background:#e5a93b;color:#1a2e1d;font-size:15px;padding:14px 22px;font-weight:bold;">
        📖 Ver Cardápio Digital
      </a>
      <a href="/experience/create?restaurantId=@Model.Id" class="button-link" style="font-size:15px;padding:14px 22px;">
        ✦ @T["TellYourExperience"]
      </a>
      <a href="/partner/claim/@Model.Id" class="button-link" style="background:transparent;border:1px solid #174b3c;color:#174b3c;font-size:14px;padding:12px 18px;">
        🏪 Reivindicar Restaurante
      </a>
    </div>
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
  {
      <div class="photo" style="height:340px;margin:18px 0;border-radius:18px;overflow:hidden;">
        <img src="@Model.PhotoUrl" alt="@T["AuthorizedPhoto", Model.Name]" style="width:100%;height:100%;object-fit:cover;" loading="lazy" referrerpolicy="no-referrer" />
      </div>
  }

  <div class="split">
    <div>
      <h2>@T["Information"]</h2>
      <p><b>@T["Address"]:</b> @(Model.Address ?? T["AddressChecking"].Value)</p>
      <p><b>@T["City"]:</b> @Model.City</p>
      <p><b>@T["UpdatedAt"]:</b> @Model.UpdatedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("g")</p>
      <h3>@T["OfficialLinks"]</h3>
      <div class="actions">
        @if (Model.Website is not null) { <a href="@Model.Website" target="_blank" rel="noopener noreferrer">@T["Website"]</a> }
        @if (Model.Instagram is not null) { <a href="@Model.Instagram" target="_blank" rel="noopener noreferrer">Instagram</a> }
        @if (Model.Facebook is not null) { <a href="@Model.Facebook" target="_blank" rel="noopener noreferrer">Facebook</a> }
        @if (Model.TikTok is not null) { <a href="@Model.TikTok" target="_blank" rel="noopener noreferrer">TikTok</a> }
        @if (Model.YouTube is not null) { <a href="@Model.YouTube" target="_blank" rel="noopener noreferrer">YouTube</a> }
      </div>
    </div>
    <div class="panel">
      <h3>@T["Mobility"]</h3>
      <p>@T["RouteNotice"]</p>
      <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Name + " " + Model.City)" target="_blank" rel="noopener noreferrer">@T["OpenMaps"]</a>
    </div>
  </div>

  <!-- Galeria de Fotos Segregada (Oficiais, Comunidade, Ilustrativas) -->
  <section style="margin-top:40px;">
    <h2>Galeria de Fotografias</h2>
    
    <div style="margin:20px 0;">
      <h3 style="color:#174b3c;font-size:17px;margin-bottom:12px;">📷 @T["CommunityPhotos"]</h3>
      @if (gallery?.CommunityPhotos.Count > 0)
      {
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;">
            @foreach (var photo in gallery.CommunityPhotos)
            {
                <a href="/media/photo/@photo.FileName" target="_blank" style="display:block;border-radius:12px;overflow:hidden;border:1px solid #dce7dc;height:140px;">
                  <img src="/media/thumb/@photo.ThumbnailName" alt="@photo.Caption" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                </a>
            }
          </div>
      }
      else
      {
          <p class="muted">@T["NoPhotosYet"]</p>
      }
    </div>

    @if (gallery?.OfficialPhotos.Count > 0)
    {
        <div style="margin:20px 0;">
          <h3 style="color:#174b3c;font-size:17px;margin-bottom:12px;">🏢 @T["OfficialPhotos"]</h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;">
            @foreach (var photo in gallery.OfficialPhotos)
            {
                <a href="/media/photo/@photo.FileName" target="_blank" style="display:block;border-radius:12px;overflow:hidden;border:1px solid #dce7dc;height:140px;">
                  <img src="/media/thumb/@photo.ThumbnailName" alt="@photo.Caption" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                </a>
            }
          </div>
        </div>
    }

    @if (gallery?.IllustrativePhotos.Count > 0)
    {
        <div style="margin:20px 0;">
          <h3 style="color:#647469;font-size:17px;margin-bottom:12px;">🎨 @T["IllustrativePhotos"]</h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;">
            @foreach (var photo in gallery.IllustrativePhotos)
            {
                <div style="border-radius:12px;overflow:hidden;border:1px solid #dce7dc;height:140px;">
                  <img src="/media/thumb/@photo.ThumbnailName" alt="@photo.Caption" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                </div>
            }
          </div>
        </div>
    }
  </section>

  <!-- Módulo Social: Avaliações e Experiências da Comunidade -->
  <section style="margin-top:40px;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
      <h2>@T["CommunityFeedTitle"] (@experiences.Count)</h2>
      <a href="/experience/create?restaurantId=@Model.Id" class="button-link">@T["TellYourExperience"]</a>
    </div>

    @if (experiences.Count == 0)
    {
        <div class="panel" style="text-align:center;padding:40px 20px;">
          <p style="font-size:17px;color:#547062;">Seja o primeiro a contar como foi sua visita a este estabelecimento!</p>
          <div style="margin-top:14px;">
            <a href="/experience/create?restaurantId=@Model.Id" class="button-link">@T["TellYourExperience"]</a>
          </div>
        </div>
    }
    else
    {
        <div style="display:grid;gap:18px;">
          @foreach (var exp in experiences)
          {
              <div class="panel" style="display:grid;gap:10px;">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;">
                  <div>
                    <strong style="font-size:16px;">@exp.AuthorName</strong>
                    <span class="muted" style="font-size:13px;margin-left:8px;">@exp.CreatedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("d")</span>
                  </div>
                  <div style="font-size:18px;color:#e67e22;letter-spacing:2px;" title="@exp.Stars estrelas">
                    @string.Concat(Enumerable.Repeat("★", exp.Stars))@string.Concat(Enumerable.Repeat("☆", 5 - exp.Stars))
                  </div>
                </div>

                <div style="display:flex;gap:16px;flex-wrap:wrap;font-size:13px;background:#f4f7f4;padding:8px 14px;border-radius:10px;">
                  <span><b>@T["ServiceRating"]:</b> @exp.ServiceStars★</span>
                  <span><b>@T["FlavorRating"]:</b> @exp.FlavorStars★</span>
                  <span><b>@T["AmbianceRating"]:</b> @exp.AmbianceStars★</span>
                  <span><b>@T["CostBenefitRating"]:</b> @exp.CostBenefitStars★</span>
                  @if (exp.PricePaid.HasValue)
                  {
                      <span><b>@T["PricePaid"]:</b> R$ @exp.PricePaid.Value.ToString("N2")</span>
                  }
                </div>

                @if (!string.IsNullOrWhiteSpace(exp.DishesConsumed))
                {
                    <p style="margin:4px 0;font-size:14px;"><b>🍴 @T["DishesConsumed"]:</b> @exp.DishesConsumed</p>
                }

                @if (!string.IsNullOrWhiteSpace(exp.ReviewText))
                {
                    <p style="margin:4px 0;font-size:15px;line-height:1.5;">@exp.ReviewText</p>
                }

                @if (exp.Photos.Count > 0)
                {
                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin:8px 0;">
                      @foreach (var p in exp.Photos)
                      {
                          <a href="/media/photo/@p.FileName" target="_blank" style="width:90px;height:70px;border-radius:8px;overflow:hidden;border:1px solid #dce7dc;">
                            <img src="/media/thumb/@p.ThumbnailName" alt="" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                          </a>
                      }
                    </div>
                }

                <div style="display:flex;gap:14px;align-items:center;margin-top:6px;font-size:14px;">
                  <form method="post" action="/experience/@exp.Id/like" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ghost" style="padding:6px 12px;font-size:13px;">
                      @(exp.HasLiked ? "❤️" : "🤍") @T["Like"] (@exp.LikesCount)
                    </button>
                  </form>
                  <a href="/experience/@exp.Id" style="color:#174b3c;font-weight:700;">💬 @T["Comments"] (@exp.CommentsCount)</a>
                  <a href="/experience/@exp.Id" style="color:#174b3c;margin-left:auto;text-decoration:none;">🔗 @T["ShareExperience"]</a>
                </div>
              </div>
          }
        </div>
    }
  </section>
</section>