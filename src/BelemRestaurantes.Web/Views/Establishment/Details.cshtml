@model BelemRestaurantes.Application.Models.RestaurantView
@{
    ViewData["Title"] = Model.Name;
}
<section class="shell section">
  <div class="heading">
    <div>
      <span class="overline dark">@Model.City · @(Model.Neighborhood ?? T["AddressChecking"].Value)</span>
      <h1>@Model.Name</h1>
      <p class="muted">@Model.Category</p>
    </div>
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
  {
      <div class="photo" style="height:320px;margin:18px 0;">
        <img src="@Model.PhotoUrl" alt="@T["AuthorizedPhoto", Model.Name]" style="width:100%;height:100%;object-fit:cover;" loading="lazy" referrerpolicy="no-referrer" />
      </div>
  }

  <div class="split">
    <div>
      <h2>@T["Information"]</h2>
      <p><b>@T["Address"]:</b> @(Model.Address ?? T["AddressChecking"].Value)</p>
      <p><b>@T["City"]:</b> @Model.City</p>
      <p><b>@T["UpdatedAt"]:</b> @Model.UpdatedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("g")</p>
      <h3>@T["OfficialLinks"]</h3>
      <div class="actions">
        @if (Model.Website is not null) { <a href="@Model.Website" target="_blank" rel="noopener noreferrer">@T["Website"]</a> }
        @if (Model.Instagram is not null) { <a href="@Model.Instagram" target="_blank" rel="noopener noreferrer">Instagram</a> }
        @if (Model.Facebook is not null) { <a href="@Model.Facebook" target="_blank" rel="noopener noreferrer">Facebook</a> }
        @if (Model.TikTok is not null) { <a href="@Model.TikTok" target="_blank" rel="noopener noreferrer">TikTok</a> }
        @if (Model.YouTube is not null) { <a href="@Model.YouTube" target="_blank" rel="noopener noreferrer">YouTube</a> }
      </div>
    </div>
    <div class="panel">
      <h3>@T["Mobility"]</h3>
      <p>@T["RouteNotice"]</p>
      <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Name + " " + Model.City)" target="_blank" rel="noopener noreferrer">@T["OpenMaps"]</a>
    </div>
  </div>
</section>