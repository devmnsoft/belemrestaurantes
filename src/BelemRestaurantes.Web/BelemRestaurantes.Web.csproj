<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>BelemRestaurantes.Web</RootNamespace>
    <UserSecretsId>belemrestaurantes-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BelemRestaurantes.Application\BelemRestaurantes.Application.csproj" />
    <ProjectReference Include="..\BelemRestaurantes.Infrastructure\BelemRestaurantes.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <!--
    Web: camada HTTP (MVC/Razor + API + área admin). Não executa o ciclo de
    descoberta — isso vive no Worker.

    Identidade administradora usa Microsoft.Extensions.Identity.Core (shared
    framework) com um IUserStore próprio sobre Dapper/MySQL, mantendo a stack
    do projeto sem introduzir EF Core apenas para o Identity.
  -->

</Project>